# Copy this file to `.env` (which is gitignored) and fill in values, or set these as CI secrets
# (GitHub → Settings → Secrets and variables → Actions), which the deploy workflow injects at build.
# Never commit real values.
#
# Only VITE_-prefixed vars are exposed to the client. Note: anything the client uses still ships
# in the built JS and is visible in the browser — these are not secrets, just config kept out of git.

# Feedback delivery (see src/features/feedback/config.ts).
# Free access key from https://web3forms.com (no account needed; public-by-design, spam-mitigated
# by the Web3Forms dashboard's domain lock + Turnstile). Interim transport until we have a server.
VITE_WEB3FORMS_ACCESS_KEY=

# Our own feedback endpoint once a server exists (a Cloudflare Worker). Takes precedence when set.
VITE_FEEDBACK_ENDPOINT=

# Optional address for the "or email us directly" fallback link. Empty = no mailto shown.
VITE_FEEDBACK_EMAIL=

# Yandex Metrica counter id (8 digits from metrica.yandex.ru). Empty = analytics off (no script,
# no cookies). Public value; not a secret.
VITE_YANDEX_METRICA_ID=

# Donation link shown on /support (currently a CloudTips page, e.g. https://pay.cloudtips.ru/p/xxxx).
# Empty = the page shows a "coming soon" card instead of a live Donate button. Public value.
VITE_SUPPORT_URL=
