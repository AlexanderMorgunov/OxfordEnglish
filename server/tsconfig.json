{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "outDir": "dist",
    "rootDir": "src",
    "skipLibCheck": true
  },
  // Smokes are dev-only and one of them reaches into the client tree; the image build context is
  // server/src alone, so shipping them would break the Docker build outright. Typechecked separately
  // via tsconfig.smoke.json.
  "include": ["src"],
  "exclude": ["src/**/*.smoke.ts"]
}
