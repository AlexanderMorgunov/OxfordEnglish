    {
      "type": "grammar",
      "id": "a12.d02.grammar",
      "title": {
        "en": "Possessive adjectives and 's",
        "ru": "Притяжательные слова и 's"
      },
      "ref": "possessives",
      "rule": {
        "en": "Say whose it is with my, your, his, her, its, our, their before the noun: my book, her name. Use his for a man, her for a woman. For a person's things add 's to the name: Ann's dog, my sister's room. Note: its = belonging to it; it's = it is.",
        "ru": "Чьё это — говорим словами my, your, his, her, its, our, their перед словом: my book, her name. his — для мужчины, her — для женщины. Для вещей человека добавляем 's к имени: Ann's dog, my sister's room. Внимание: its = принадлежащий ему/ей (о предмете); it's = it is."
      },
      "patterns": [
        {
          "label": {
            "en": "Possessive adjective + noun",
            "ru": "Притяжательное + слово"
          },
          "formula": "my/your/his/her/its/our/their + noun",
          "examples": [
            {
              "en": "This is my room.",
              "ru": "Это моя комната."
            },
            {
              "en": "Her name is Kate.",
              "ru": "Её зовут Кейт."
            }
          ]
        },
        {
          "label": {
            "en": "his vs her",
            "ru": "his и her"
          },
          "formula": "man → his · woman → her",
          "examples": [
            {
              "en": "Ben and his bike.",
              "ru": "Бен и его велосипед."
            },
            {
              "en": "Ann and her book.",
              "ru": "Анна и её книга."
            }
          ]
        },
        {
          "label": {
            "en": "name + 's",
            "ru": "имя + 's"
          },
          "formula": "person's + noun",
          "examples": [
            {
              "en": "Ann's dog is small.",
              "ru": "Собака Анны маленькая."
            },
            {
              "en": "My sister's room is big.",
              "ru": "Комната моей сестры большая."
            }
          ]
        }
      ],
      "pitfalls": [
        {
          "en": "Match the owner: a man → his, a woman → her (not the thing).",
          "ru": "Согласуй с владельцем: мужчина → his, женщина → her (не с предметом)."
        },
        {
          "en": "its = possessive, it's = it is: \"the dog and its ball\".",
          "ru": "its = притяжательное, it's = it is: «the dog and its ball»."
        }
      ]
    },
