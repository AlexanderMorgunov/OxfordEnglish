    {
      "type": "grammar",
      "id": "u09.d04.grammar",
      "title": {
        "en": "too / (not) enough",
        "ru": "too / (not) enough"
      },
      "rule": {
        "en": "\"too + adjective\" means more than we want (a problem). \"adjective + enough\" means the right amount. \"enough + noun\" comes before the noun.",
        "ru": "\"too + прилагательное\" — больше, чем нужно (проблема). \"прилагательное + enough\" — в самый раз. \"enough + существительное\" — перед существительным."
      },
      "patterns": [
        {
          "label": {
            "en": "too + adj",
            "ru": "too + прил."
          },
          "formula": "too + adjective",
          "examples": [
            {
              "en": "This coat is too expensive.",
              "ru": "Это пальто слишком дорогое."
            }
          ],
          "ref": "too-enough"
        },
        {
          "label": {
            "en": "adj + enough",
            "ru": "прил. + enough"
          },
          "formula": "adjective + enough",
          "examples": [
            {
              "en": "It is not big enough.",
              "ru": "Оно недостаточно большое."
            }
          ],
          "ref": "too-enough"
        },
        {
          "label": {
            "en": "enough + noun",
            "ru": "enough + сущ."
          },
          "formula": "enough + noun",
          "examples": [
            {
              "en": "I don't have enough money.",
              "ru": "У меня недостаточно денег."
            }
          ],
          "ref": "too-enough"
        }
      ],
      "pitfalls": [
        {
          "en": "\"too\" goes before the adjective, \"enough\" goes after it: \"too small\", \"small enough\".",
          "ru": "\"too\" — перед прилагательным, \"enough\" — после: \"too small\", \"small enough\"."
        },
        {
          "en": "\"enough\" goes before a noun: \"enough time\", not \"time enough\".",
          "ru": "\"enough\" — перед существительным: \"enough time\", а не \"time enough\"."
        }
      ]
    },
    {
      "type": "reading",
      "id": "u09.d04.reading",
      "title": {
        "en": "A hard choice",
