    {
      "type": "grammar",
      "id": "u23.d02.grammar",
      "title": {
        "en": "would for repeated past actions",
        "ru": "would для повторяющихся действий в прошлом"
      },
      "rule": {
        "en": "Use \"would + verb\" for repeated ACTIONS in the past — like \"used to\", but only for actions, not states. It is common in stories about the past.",
        "ru": "Используй «would + глагол» для повторяющихся ДЕЙСТВИЙ в прошлом — как «used to», но только для действий, не состояний. Часто в рассказах о прошлом."
      },
      "patterns": [
        {
          "label": {
            "en": "would + verb (action)",
            "ru": "would + глагол (действие)"
          },
          "formula": "would + verb",
          "examples": [
            {
              "en": "Every summer we would visit the sea.",
              "ru": "Каждое лето мы ездили на море."
            }
          ],
          "ref": "used-to"
        },
        {
          "label": {
            "en": "with time markers",
            "ru": "со словами времени"
          },
          "formula": "Every day/summer … would …",
          "examples": [
            {
              "en": "On Sundays, we would gather for lunch.",
              "ru": "По воскресеньям мы собирались на обед."
            }
          ],
          "ref": "used-to"
        },
        {
          "label": {
            "en": "NOT for states",
            "ru": "НЕ для состояний"
          },
          "formula": "states → used to (not would)",
          "examples": [
            {
              "en": "I used to have long hair. (NOT \"would have\")",
              "ru": "Раньше у меня были длинные волосы."
            }
          ],
          "ref": "used-to"
        }
      ],
      "pitfalls": [
        {
          "en": "\"would\" works for repeated actions, but NOT for past states: use \"used to\" for states.",
          "ru": "«would» — для повторяющихся действий, но НЕ для состояний: для состояний — «used to»."
        },
        {
          "en": "\"We would visit\" ✓ (action), but \"We would live there\" ✗ → \"used to live\".",
          "ru": "«We would visit» ✓ (действие), но «We would live there» ✗ → «used to live»."
        }
      ]
    },
    {
      "type": "reading",
      "id": "u23.d02.reading",
      "title": {
        "en": "Summers by the sea",
        "ru": "Лето у моря"
      },
      "blocks": [
        {
          "id": "u23.d02.reading.b1",
          "en": "Every summer, our whole family would drive to the seaside. We would leave early in the morning, and my father would sing old songs the whole way. When we arrived, we would run straight to the water.",
          "ru": "Каждое лето вся наша семья ездила на побережье. Мы выезжали рано утром, и отец всю дорогу пел старые песни. Приехав, мы сразу бежали к воде.",
          "audio": {
            "src": "media/audio/u23.d02.reading.b1.mp3",
            "license": {
              "type": "original",
              "attribution": "Project authors (LLM-assisted)"
            }
          }
        },
        {
          "id": "u23.d02.reading.b2",
          "en": "In the evenings, we would sit by a campfire and my grandmother would tell stories. We would watch the sunset and stay up late. Those summers used to feel endless. I would give anything to live one of those days again.",
          "ru": "По вечерам мы сидели у костра, и бабушка рассказывала истории. Мы смотрели на закат и не ложились допоздна. Те лета казались бесконечными. Я бы всё отдал, чтобы прожить один из тех дней снова.",
          "audio": {
            "src": "media/audio/u23.d02.reading.b2.mp3",
            "license": {
              "type": "original",
              "attribution": "Project authors (LLM-assisted)"
            }
          }
        }
      ],
      "glossary": [
        {
          "word": "endless",
          "ru": "бесконечный",
          "ipa": "/ˈendləs/"
        },
        {
          "word": "straight",
          "ru": "прямо",
          "ipa": "/streɪt/"
        }
      ]
    },
