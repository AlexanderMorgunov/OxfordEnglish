    {
      "type": "grammar",
      "id": "u10.d02.grammar",
      "title": {
        "en": "will / won't",
        "ru": "will / won't"
      },
      "rule": {
        "en": "Use \"will + verb\" for predictions, quick decisions, offers and promises. Negative is \"won't\". Often with I think, maybe, probably.",
        "ru": "\"will + глагол\" — прогнозы, мгновенные решения, предложения, обещания. Отрицание — \"won't\". Часто с I think, maybe, probably."
      },
      "patterns": [
        {
          "label": {
            "en": "prediction",
            "ru": "прогноз"
          },
          "formula": "I think … will …",
          "examples": [
            {
              "en": "I think it will rain.",
              "ru": "Думаю, будет дождь."
            }
          ]
        },
        {
          "label": {
            "en": "decision / offer",
            "ru": "решение / предложение"
          },
          "formula": "I'll + verb (now)",
          "examples": [
            {
              "en": "You look tired. I'll help you.",
              "ru": "Ты устал. Я помогу."
            }
          ]
        },
        {
          "label": {
            "en": "won't",
            "ru": "won't"
          },
          "formula": "will not = won't",
          "examples": [
            {
              "en": "Don't worry, I won't be late.",
              "ru": "Не волнуйся, я не опоздаю."
            }
          ]
        }
      ],
      "pitfalls": [
        {
          "en": "Use the base verb after will: \"will go\", not \"will to go\".",
          "ru": "После will — начальная форма: \"will go\", а не \"will to go\"."
        },
        {
          "en": "Same form for all persons: he will, they will.",
          "ru": "Форма одна для всех лиц: he will, they will."
        }
      ]
    },
