    {
      "type": "grammar",
      "id": "u06.d04.grammar",
      "title": {
        "en": "Adjective order · -ed / -ing adjectives",
        "ru": "Порядок прилагательных · -ed / -ing"
      },
      "rule": {
        "en": "Put adjectives in order: opinion → size → age → colour → noun. Use -ing for the thing (boring film) and -ed for the feeling (bored person).",
        "ru": "Порядок прилагательных: мнение → размер → возраст → цвет → существительное. -ing — о предмете (boring film), -ed — о чувстве (bored person)."
      },
      "patterns": [
        {
          "label": {
            "en": "order",
            "ru": "порядок"
          },
          "formula": "opinion + size + age + colour + noun",
          "examples": [
            {
              "en": "a beautiful big old house",
              "ru": "красивый большой старый дом"
            }
          ]
        },
        {
          "label": {
            "en": "-ing (thing)",
            "ru": "-ing (предмет)"
          },
          "formula": "The film is boring.",
          "examples": [
            {
              "en": "This lesson is interesting.",
              "ru": "Этот урок интересный."
            }
          ]
        },
        {
          "label": {
            "en": "-ed (feeling)",
            "ru": "-ed (чувство)"
          },
          "formula": "I am bored / interested.",
          "examples": [
            {
              "en": "I am interested in it.",
              "ru": "Мне это интересно."
            }
          ]
        }
      ],
      "pitfalls": [
        {
          "en": "Say \"I am bored\" (feeling), not \"I am boring\" (that means you are dull!).",
          "ru": "Говори \"I am bored\" (чувство), а не \"I am boring\" (это значит, что ты скучный!)."
        },
        {
          "en": "Size before colour: \"a big red bag\", not \"a red big bag\".",
          "ru": "Размер перед цветом: \"a big red bag\", а не \"a red big bag\"."
        }
      ]
    },
    {
      "type": "reading",
      "id": "u06.d04.reading",
      "title": {
        "en": "My best friend",
        "ru": "Мой лучший друг"
      },
      "blocks": [
        {
          "id": "u06.d04.reading.b1",
          "en": "My best friend Kate is tall and young, with long brown hair and green eyes. She lives in a beautiful old house near the river.",
          "ru": "Моя лучшая подруга Кейт высокая и молодая, с длинными каштановыми волосами и зелёными глазами. Она живёт в красивом старом доме у реки.",
          "audio": {
            "src": "media/audio/u06.d04.reading.b1.mp3",
            "license": {
              "type": "original",
              "attribution": "Project authors (LLM-assisted)"
            }
          }
        },
        {
          "id": "u06.d04.reading.b2",
          "en": "Kate is never boring. She reads a lot and always has interesting stories. When I am tired or bored, I call her and I feel better.",
          "ru": "Кейт никогда не бывает скучной. Она много читает и всегда рассказывает интересные истории. Когда я устал или мне скучно, я звоню ей и мне становится легче.",
          "audio": {
            "src": "media/audio/u06.d04.reading.b2.mp3",
            "license": {
              "type": "original",
              "attribution": "Project authors (LLM-assisted)"
            }
