    {
      "type": "grammar",
      "id": "u14.d02.grammar",
      "title": {
        "en": "The passive (intro)",
        "ru": "Пассивный залог (введение)"
      },
      "rule": {
        "en": "Use the passive when the action matters more than who does it: be + past participle. Present: is/are + V3. Past: was/were + V3. Add \"by\" for the doer.",
        "ru": "Пассив — когда важнее действие, а не деятель: be + причастие. Настоящее: is/are + V3. Прошлое: was/were + V3. Деятель — через \"by\"."
      },
      "patterns": [
        {
          "label": {
            "en": "present passive",
            "ru": "present passive"
          },
          "formula": "is/are + past participle",
          "examples": [
            {
              "en": "English is spoken here.",
              "ru": "Здесь говорят по-английски."
            }
          ],
          "ref": "passive"
        },
        {
          "label": {
            "en": "past passive",
            "ru": "past passive"
          },
          "formula": "was/were + past participle",
          "examples": [
            {
              "en": "The bridge was built in 1990.",
              "ru": "Мост построили в 1990."
            }
          ],
          "ref": "passive"
        },
        {
          "label": {
            "en": "by + doer",
            "ru": "by + деятель"
          },
          "formula": "… by + person",
          "examples": [
            {
              "en": "The book was written by a teacher.",
              "ru": "Книгу написал учитель."
            }
          ],
          "ref": "passive"
        }
      ],
      "pitfalls": [
        {
          "en": "The passive always uses a form of \"be\" + past participle.",
          "ru": "Пассив всегда: форма \"be\" + причастие прошедшего."
        },
        {
          "en": "Choose is/are or was/were by the subject and the time.",
          "ru": "is/are или was/were выбирай по подлежащему и времени."
        }
      ]
    },
    {
