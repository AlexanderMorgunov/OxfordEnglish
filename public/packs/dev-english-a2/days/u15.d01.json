      "transcript": [
        {
          "start": 0,
          "end": 4,
          "en": "Imagine you had a free year and enough money. What would you do?",
          "ru": "Представь: у тебя есть свободный год и достаточно денег. Что бы ты делал?"
        },
        {
          "start": 4,
          "end": 8,
          "en": "If I had a whole year, I would travel and learn two languages.",
          "ru": "Будь у меня целый год, я бы путешествовал и выучил два языка."
        },
        {
          "start": 8,
          "end": 12,
          "en": "Interesting. Would you quit your job?",
          "ru": "Интересно. Ты бы уволился?"
        },
        {
          "start": 12,
          "end": 16,
          "en": "No, I wouldn't quit. I'd just take a long break and come back.",
          "ru": "Нет, не уволился бы. Просто взял бы длинный перерыв и вернулся."
        }
