    {
      "type": "grammar",
      "id": "u14.d05.grammar",
      "title": {
        "en": "A2 in a nutshell",
        "ru": "A2 вкратце"
      },
      "rule": {
        "en": "You now know the core of A2: the main tenses, modal verbs, comparatives, conditionals and the passive. This checkpoint mixes them all.",
        "ru": "Теперь ты знаешь основу A2: главные времена, модальные глаголы, степени сравнения, условные и пассив. Эта контрольная смешивает всё."
      },
      "patterns": [
        {
          "label": {
            "en": "tenses",
            "ru": "времена"
          },
          "formula": "present · past · perfect · future",
          "examples": [
            {
              "en": "I work, I worked, I have worked, I will work.",
              "ru": "Я работаю, работал, поработал, буду работать."
            }
          ]
        },
        {
          "label": {
            "en": "modals",
            "ru": "модальные"
          },
          "formula": "can · should · must · might",
          "examples": [
            {
              "en": "You should rest. You must not be late.",
              "ru": "Тебе стоит отдохнуть. Нельзя опаздывать."
            }
          ]
        },
        {
          "label": {
            "en": "conditionals",
            "ru": "условные"
          },
          "formula": "If + present, will …",
          "examples": [
            {
              "en": "If you practise, you will improve.",
              "ru": "Если будешь заниматься, ты станешь лучше."
            }
          ]
        }
      ],
      "pitfalls": [
        {
          "en": "When you are unsure, look for the time word — it usually tells you the tense.",
          "ru": "Если сомневаешься, ищи слово времени — оно обычно подсказывает время."
        },
        {
          "en": "Read the whole sentence before choosing: context decides the grammar.",
          "ru": "Читай всё предложение перед выбором: контекст решает грамматику."
        }
      ]
    },
    {
      "type": "reading",
      "id": "u14.d05.reading",
      "title": {
        "en": "You did it!",
        "ru": "Ты справился!"
      },
      "blocks": [
        {
          "id": "u14.d05.reading.b1",
          "en": "Congratulations! You have reached the end of the A2 course. You started with simple words, and now you can talk about the past, the future and your experiences.",
          "ru": "Поздравляем! Ты дошёл до конца курса A2. Ты начинал с простых слов, а теперь умеешь говорить о прошлом, будущем и своём опыте.",
          "audio": {
            "src": "media/audio/u14.d05.reading.b1.wav",
            "license": {
              "type": "original",
              "attribution": "Project authors (LLM-assisted)"
            }
          }
        },
        {
          "id": "u14.d05.reading.b2",
          "en": "You can ask for things, give advice, make plans and share opinions. If you keep practising, you will soon be ready for B1. Be proud of your progress!",
          "ru": "Ты умеешь просить, давать советы, строить планы и делиться мнением. Если продолжишь заниматься, скоро будешь готов к B1. Гордись своим прогрессом!",
          "audio": {
            "src": "media/audio/u14.d05.reading.b2.wav",
            "license": {
              "type": "original",
              "attribution": "Project authors (LLM-assisted)"
            }
          }
        }
      ],
