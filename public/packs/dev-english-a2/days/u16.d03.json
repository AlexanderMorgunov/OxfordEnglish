    {
      "type": "grammar",
      "id": "u16.d03.grammar",
      "title": {
        "en": "Narrative tenses together",
        "ru": "Нарративные времена вместе"
      },
      "rule": {
        "en": "A story mixes three past tenses: past continuous sets the scene (was -ing), past simple gives the main events, and past perfect gives the background that happened earlier.",
        "ru": "История сочетает три времени: past continuous задаёт фон (was -ing), past simple — основные события, past perfect — то, что было раньше."
      },
      "patterns": [
        {
          "label": {
            "en": "scene",
            "ru": "фон"
          },
          "formula": "past continuous (was -ing)",
          "examples": [
            {
              "en": "It was raining and the house was quiet.",
              "ru": "Шёл дождь, в доме было тихо."
            }
          ],
          "ref": "narrative-tenses"
        },
        {
          "label": {
            "en": "event",
            "ru": "событие"
          },
          "formula": "past simple",
          "examples": [
            {
              "en": "Suddenly, she heard a noise.",
              "ru": "Вдруг она услышала шум."
            }
          ],
          "ref": "narrative-tenses"
        },
        {
          "label": {
            "en": "background",
            "ru": "предыстория"
          },
          "formula": "past perfect (had V3)",
          "examples": [
            {
              "en": "Someone had left the window open.",
              "ru": "Кто-то оставил окно открытым."
            }
          ],
          "ref": "narrative-tenses"
        }
      ],
      "pitfalls": [
        {
          "en": "The interrupted (longer) action is continuous; the short event is simple.",
          "ru": "Прерванное (длинное) действие — continuous; короткое событие — simple."
        },
        {
          "en": "Use past perfect only for what happened before the main story time.",
          "ru": "Past perfect — только для того, что было до основного времени рассказа."
        }
      ]
    },
    {
      "type": "reading",
      "id": "u16.d03.reading",
      "title": {
        "en": "A noise in the night",
        "ru": "Шум в ночи"
      },
      "blocks": [
        {
          "id": "u16.d03.reading.b1",
          "en": "It was late, and Lena was reading in bed. The rain was falling softly and the whole house was quiet. She had locked all the doors before going upstairs, so she felt safe. Then, suddenly, she heard a noise downstairs.",
          "ru": "Было поздно, и Лена читала в постели. Тихо шёл дождь, весь дом молчал. Перед тем как подняться, она заперла все двери, поэтому чувствовала себя спокойно. И вдруг снизу донёсся шум.",
          "audio": {
            "src": "media/audio/u16.d03.reading.b1.wav",
            "license": {
              "type": "original",
              "attribution": "Project authors (LLM-assisted)"
            }
          }
        },
        {
          "id": "u16.d03.reading.b2",
          "en": "She froze. Someone — or something — was moving in the kitchen. Her heart was beating fast as she walked carefully down the stairs. A shadow appeared near the table. But when she turned on the light, it turned out that the cat had knocked over a cup. What a relief!",
          "ru": "Она замерла. Кто-то — или что-то — двигался на кухне. Сердце колотилось, пока она осторожно спускалась по лестнице. У стола появилась тень. Но когда она включила свет, оказалось, что это кот опрокинул чашку. Какое облегчение!",
          "audio": {
            "src": "media/audio/u16.d03.reading.b2.wav",
            "license": {
              "type": "original",
              "attribution": "Project authors (LLM-assisted)"
            }
          }
        }
      ],
      "glossary": [
        {
          "word": "freeze",
          "ru": "замереть, застыть",
          "ipa": "/friːz/"
        },
        {
