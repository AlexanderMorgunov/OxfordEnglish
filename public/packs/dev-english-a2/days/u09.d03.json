    {
      "type": "grammar",
      "id": "u09.d03.grammar",
      "title": {
        "en": "as … as · the same as · different from",
        "ru": "as … as · the same as · different from"
      },
      "rule": {
        "en": "Say two things are equal with \"as … as\". \"not as … as\" means less. Use \"the same as\" for equal and \"different from\" for not equal.",
        "ru": "Равенство — \"as … as\". \"not as … as\" значит меньше. \"the same as\" — одинаковый, \"different from\" — другой."
      },
      "patterns": [
        {
          "label": {
            "en": "as … as",
            "ru": "as … as"
          },
          "formula": "as + adjective + as",
          "examples": [
            {
              "en": "She is as kind as her sister.",
              "ru": "Она такая же добрая, как её сестра."
            }
          ],
          "ref": "comparatives"
        },
        {
          "label": {
            "en": "not as … as",
            "ru": "not as … as"
          },
          "formula": "not as + adjective + as",
          "examples": [
            {
              "en": "He is not as tall as me.",
              "ru": "Он не такой высокий, как я."
            }
          ],
          "ref": "comparatives"
        },
        {
          "label": {
            "en": "same / different",
            "ru": "same / different"
          },
          "formula": "the same as · different from",
          "examples": [
            {
              "en": "This bag is the same as mine. Yours is different from mine.",
              "ru": "Эта сумка такая же, как моя. Твоя отличается от моей."
            }
          ],
          "ref": "comparatives"
        }
      ],
      "pitfalls": [
        {
          "en": "Use \"different from\", not \"different than\" (in British English).",
          "ru": "Используй \"different from\", а не \"different than\" (в британском)."
        },
        {
          "en": "\"not as … as\" = less: \"not as expensive as\" means cheaper.",
          "ru": "\"not as … as\" = меньше: \"not as expensive as\" значит дешевле."
        }
      ]
    },
    {
      "type": "reading",
      "id": "u09.d03.reading",
      "title": {
        "en": "Two friends",
        "ru": "Два друга"
      },
      "blocks": [
        {
          "id": "u09.d03.reading.b1",
          "en": "Max and Sam are good friends, but they are very different. Max is quiet and shy, and Sam is as funny as a clown. He talks a lot.",
          "ru": "Макс и Сэм — хорошие друзья, но они очень разные. Макс тихий и застенчивый, а Сэм весёлый, как клоун. Он много говорит.",
          "audio": {
            "src": "media/audio/u09.d03.reading.b1.mp3",
            "license": {
              "type": "original",
              "attribution": "Project authors (LLM-assisted)"
            }
          }
        },
        {
          "id": "u09.d03.reading.b2",
          "en": "They are not the same, but both are kind and honest. Max is as clever as Sam, and Sam is as hard-working as Max. That's why they work well together.",
          "ru": "Они не одинаковые, но оба добрые и честные. Макс такой же умный, как Сэм, а Сэм такой же трудолюбивый, как Макс. Поэтому они хорошо работают вместе.",
          "audio": {
            "src": "media/audio/u09.d03.reading.b2.mp3",
            "license": {
              "type": "original",
              "attribution": "Project authors (LLM-assisted)"
            }
          }
        }
      ],
