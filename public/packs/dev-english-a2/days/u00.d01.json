    {
      "type": "grammar",
      "id": "u00.d01.grammar",
      "title": {
        "en": "The verb \"be\" and a / an",
        "ru": "Глагол \"be\" и a / an"
      },
      "rule": {
        "en": "Use \"be\" (am / is / are) to say who and what things are. Use \"a/an\" before one singular thing.",
        "ru": "Глагол \"be\" (am / is / are) говорит, кто и что есть. \"a/an\" — перед одним предметом в единственном числе."
      },
      "patterns": [
        {
          "label": {
            "en": "am / is / are",
            "ru": "am / is / are"
          },
          "formula": "I am · he/she/it is · we/you/they are",
          "examples": [
            {
              "en": "I am a student. She is a teacher.",
              "ru": "Я студент. Она учитель."
            }
          ]
        },
        {
          "label": {
            "en": "a / an",
            "ru": "a / an"
          },
          "formula": "a + consonant · an + vowel",
          "examples": [
            {
              "en": "a city, an apple",
              "ru": "город, яблоко"
            }
          ]
        }
      ],
      "pitfalls": [
        {
          "en": "Don't drop \"be\": say \"I am a student\", not \"I student\".",
          "ru": "Не выбрасывай \"be\": говори \"I am a student\", а не \"I student\"."
        },
        {
          "en": "Use \"an\" before a vowel sound: an apple, an hour.",
          "ru": "Ставь \"an\" перед гласным звуком: an apple, an hour."
        }
      ]
    },
    {
