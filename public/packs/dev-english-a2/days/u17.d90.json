    {
      "type": "grammar",
      "id": "u17.d90.grammar",
      "title": {
        "en": "Present perfect continuous",
        "ru": "Present perfect continuous"
      },
      "ref": "present-perfect-continuous",
      "rule": {
        "en": "Use the present perfect continuous for actions that started in the past and are still happening now. Form: have/has + been + verb-ing. Use 'for' with a time period and 'since' with a starting point.",
        "ru": "Present perfect continuous используется для действий, которые начались в прошлом и всё ещё продолжаются. Форма: have/has + been + глагол с -ing. Используйте 'for' с периодом времени и 'since' с точкой начала."
      },
      "patterns": [
        {
          "label": {
            "en": "Affirmative",
            "ru": "Утверждение"
          },
          "formula": "subject + have/has been + verb-ing",
          "examples": [
            {
              "en": "We have been sitting for twenty minutes.",
              "ru": "Мы сидим уже двадцать минут."
            }
          ],
          "ref": "present-perfect-continuous"
        },
        {
          "label": {
            "en": "Negative",
            "ru": "Отрицание"
          },
          "formula": "subject + haven't/hasn't been + verb-ing",
          "examples": [
            {
              "en": "They haven't been talking.",
              "ru": "Они не разговаривали."
            }
          ],
          "ref": "present-perfect-continuous"
        },
        {
          "label": {
            "en": "Question",
            "ru": "Вопрос"
          },
          "formula": "have/has + subject + been + verb-ing?",
          "examples": [
            {
              "en": "How long have you been learning to cook?",
              "ru": "Как долго ты учишься готовить?"
            }
          ],
          "ref": "present-perfect-continuous"
        }
      ],
      "pitfalls": [
        {
          "en": "Don't forget 'been': 'I have working' is wrong; you need 'I have been working'.",
          "ru": "Не забывайте 'been': 'I have working' — неправильно; нужно 'I have been working'."
        },
        {
          "en": "Use 'for' with a duration ('for twenty minutes') and 'since' with a starting point ('since 1995').",
          "ru": "Используйте 'for' с длительностью ('for twenty minutes') и 'since' с точкой начала ('since 1995')."
        },
        {
          "en": "Use 'has' with he/she/it, not 'have': 'He has been...', not 'He have been...'.",
          "ru": "Используйте 'has' с he/she/it, а не 'have': 'He has been...', не 'He have been...'."
        }
      ]
    },
    {
      "type": "reading",
      "id": "u17.d90.reading",
      "title": {
        "en": "The Wi-Fi Outage",
        "ru": "Отключение Wi-Fi"
      },
      "blocks": [
        {
          "id": "u17.d90.reading.b1",
          "en": "The office Wi-Fi is down. Nobody can work. They have been sitting in silence for twenty minutes. Den has been refreshing the same page. Alex has been staring at his phone. Valery has been drinking tea. Pol has been watching everyone.",
          "ru": "Офисный Wi-Fi не работает. Никто не может работать. Они молча сидят уже двадцать минут. Ден обновляет одну и ту же страницу. Алекс пялится в телефон. Валерий пьёт чай. Пол наблюдает за всеми.",
          "audio": {
            "src": "media/audio/u17.d90.reading.b1.mp3",
            "license": {
              "type": "original",
              "attribution": "Project authors (LLM-assisted)"
            }
          },
          "image": {
            "src": "media/images/u17.d90.reading.b1.png",
            "license": {
              "type": "original",
              "attribution": "Project authors (LLM-assisted)"
            },
            "alt": {
              "en": "Four colleagues sit silently at their desks during a Wi-Fi outage",
              "ru": "Четверо коллег молча сидят за столами во время отключения Wi-Fi"
            }
          }
        },
        {
          "id": "u17.d90.reading.b2",
          "en": "\"We haven't talked to each other without screens for a long time,\" Pol says. Alex smiles. \"You're right.\" They start talking. Alex asks Valery about his hobby. \"I have been collecting stamps for thirty years,\" Valery says. \"And I have been learning to cook lately,\" Den adds. Everyone laughs.",
          "ru": "«Мы уже давно не разговаривали друг с другом без экранов», — говорит Пол. Алекс улыбается. «Ты прав». Они начинают разговаривать. Алекс спрашивает Валерия о его хобби. «Я собираю марки уже тридцать лет», — говорит Валерий. «А я недавно учусь готовить», — добавляет Ден. Все смеются.",
          "audio": {
            "src": "media/audio/u17.d90.reading.b2.mp3",
            "license": {
              "type": "original",
              "attribution": "Project authors (LLM-assisted)"
            }
          }
        },
        {
          "id": "u17.d90.reading.b3",
          "en": "Suddenly the Wi-Fi comes back. Alex's phone starts to ring. Den sees his page. But nobody rushes to their laptops. \"Let's talk a little more,\" Valery says. They keep talking. They have been enjoying the conversation for twenty more minutes.",
          "ru": "Внезапно Wi-Fi возвращается. Телефон Алекса начинает звонить. Ден видит свою страницу. Но никто не торопится к ноутбукам. «Давайте ещё немного поговорим», — говорит Валерий. Они продолжают разговаривать. Они наслаждаются разговором ещё двадцать минут.",
          "audio": {
            "src": "media/audio/u17.d90.reading.b3.mp3",
            "license": {
              "type": "original",
              "attribution": "Project authors (LLM-assisted)"
            }
          },
          "image": {
            "src": "media/images/u17.d90.reading.b3.png",
            "license": {
              "type": "original",
              "attribution": "Project authors (LLM-assisted)"
            },
            "alt": {
              "en": "Colleagues laugh and talk together while laptops light up with restored Wi-Fi",
              "ru": "Коллеги смеются и разговаривают, пока ноутбуки загораются от восстановленного Wi-Fi"
            }
          }
        }
      ],
