    {
      "type": "grammar",
      "id": "u11.d04.grammar",
      "title": {
        "en": "might / may",
        "ru": "might / may"
      },
      "rule": {
        "en": "Use \"might\" or \"may\" + verb for possibility (maybe it will happen). The negative is \"might not / may not\".",
        "ru": "\"might\" или \"may\" + глагол — возможность (может быть, случится). Отрицание — \"might not / may not\"."
      },
      "patterns": [
        {
          "label": {
            "en": "might / may",
            "ru": "might / may"
          },
          "formula": "might/may + verb",
          "examples": [
            {
              "en": "It might rain later.",
              "ru": "Возможно, позже пойдёт дождь."
            }
          ],
          "ref": "might-may"
        },
        {
          "label": {
            "en": "might not",
            "ru": "might not"
          },
          "formula": "might not + verb",
          "examples": [
            {
              "en": "I might not pass the exam.",
              "ru": "Возможно, я не сдам экзамен."
            }
          ],
          "ref": "might-may"
        },
        {
          "label": {
            "en": "answer",
            "ru": "ответ"
          },
          "formula": "Maybe. / I might.",
          "examples": [
            {
              "en": "Will you come? I might.",
              "ru": "Ты придёшь? Возможно."
            }
          ]
        }
      ],
      "pitfalls": [
        {
          "en": "Base verb after might/may: \"might go\", not \"might to go\".",
          "ru": "После might/may — начальная форма: \"might go\", а не \"might to go\"."
        },
        {
          "en": "\"might\" and \"may\" both mean \"possibly\" here — they are similar.",
          "ru": "\"might\" и \"may\" здесь оба значат \"возможно\" — они близки."
        }
      ]
    },
    {
      "type": "reading",
      "id": "u11.d04.reading",
      "title": {
        "en": "Before the exam",
        "ru": "Перед экзаменом"
      },
      "blocks": [
        {
          "id": "u11.d04.reading.b1",
          "en": "Anna has an important exam tomorrow. She studied a lot, but she is nervous. \"I might pass, or I might not,\" she says. \"The exam may be difficult.\"",
          "ru": "Завтра у Анны важный экзамен. Она много готовилась, но нервничает. «Может, сдам, а может, и нет», — говорит она. «Экзамен может быть сложным».",
          "audio": {
            "src": "media/audio/u11.d04.reading.b1.mp3",
            "license": {
              "type": "original",
              "attribution": "Project authors (LLM-assisted)"
            }
          }
        },
        {
          "id": "u11.d04.reading.b2",
          "en": "Her teacher says, \"Don't worry. You know the subject well. You may get a good grade. And if it rains, we might do the exam in the library.\"",
          "ru": "Учитель говорит: «Не переживай. Ты хорошо знаешь предмет. Возможно, получишь хорошую оценку. А если пойдёт дождь, экзамен, может быть, проведём в библиотеке».",
          "audio": {
            "src": "media/audio/u11.d04.reading.b2.mp3",
            "license": {
              "type": "original",
              "attribution": "Project authors (LLM-assisted)"
            }
          }
        }
      ],
      "glossary": [
        {
          "word": "nervous",
          "ru": "нервный, взволнованный",
          "ipa": "/ˈnɜːrvəs/"
        },
        {
          "word": "difficult",
          "ru": "сложный",
          "ipa": "/ˈdɪfɪkəlt/"
        }
      ]
    },
