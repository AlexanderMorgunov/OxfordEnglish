    {
      "type": "grammar",
      "id": "u01.d04.grammar",
      "title": {
        "en": "mine/yours/hers & whose",
        "ru": "mine/yours/hers и whose"
      },
      "rule": {
        "en": "Possessive pronouns (mine, yours, his, hers, ours, theirs) replace \"my/your… + noun\". Ask \"Whose…?\" to find the owner.",
        "ru": "Абсолютные притяжательные (mine, yours, his, hers, ours, theirs) заменяют \"my/your… + существительное\". \"Whose…?\" спрашивает о владельце."
      },
      "patterns": [
        {
          "label": {
            "en": "Possessive pronoun",
            "ru": "Притяжательное местоимение"
          },
          "formula": "mine · yours · his · hers · ours · theirs",
          "examples": [
            {
              "en": "This bag is mine.",
              "ru": "Эта сумка моя."
            }
          ]
        },
        {
          "label": {
            "en": "Whose…?",
            "ru": "Чей…?"
          },
          "formula": "Whose + noun … ? — It's mine.",
          "examples": [
            {
              "en": "Whose keys are these? — They're hers.",
              "ru": "Чьи это ключи? — Её."
            }
          ]
        }
      ],
      "pitfalls": [
        {
          "en": "No noun after a possessive pronoun: \"It's mine\", not \"It's mine bag\".",
          "ru": "После абсолютного притяжательного нет существительного: \"It's mine\", а не \"It's mine bag\"."
        },
        {
          "en": "\"Whose\" (чей) ≠ \"who's\" (who is). \"Whose bag?\" vs \"Who's here?\".",
          "ru": "\"Whose\" (чей) ≠ \"who's\" (who is). \"Whose bag?\" против \"Who's here?\"."
        }
      ]
    },
    {
      "type": "reading",
      "id": "u01.d04.reading",
      "title": {
