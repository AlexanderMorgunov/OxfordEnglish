    {
      "type": "grammar",
      "id": "u16.d04.grammar",
      "title": {
        "en": "Time linkers",
        "ru": "Связки времени"
      },
      "rule": {
        "en": "Order events with time linkers: \"by the time\" + past, then past perfect; \"as soon as\" for one event right after another; \"until\" for the end point.",
        "ru": "Упорядочивай события связками: \"by the time\" + past, дальше past perfect; \"as soon as\" — одно сразу за другим; \"until\" — до какой точки."
      },
      "patterns": [
        {
          "label": {
            "en": "by the time",
            "ru": "by the time"
          },
          "formula": "By the time + past, past perfect",
          "examples": [
            {
              "en": "By the time we arrived, the film had started.",
              "ru": "К нашему приходу фильм уже начался."
            }
          ],
          "ref": "narrative-tenses"
        },
        {
          "label": {
            "en": "as soon as",
            "ru": "as soon as"
          },
          "formula": "As soon as + past, past",
          "examples": [
            {
              "en": "As soon as she arrived, we left.",
              "ru": "Как только она пришла, мы ушли."
            }
          ],
          "ref": "narrative-tenses"
        },
        {
          "label": {
            "en": "until",
            "ru": "until"
          },
          "formula": "… until + past",
          "examples": [
            {
              "en": "We waited until the rain stopped.",
              "ru": "Мы ждали, пока дождь не прекратился."
            }
          ],
          "ref": "narrative-tenses"
        }
      ],
      "pitfalls": [
        {
          "en": "\"By the time\" usually pairs with the past perfect for the earlier action.",
          "ru": "\"By the time\" обычно с past perfect для более раннего действия."
        },
        {
          "en": "\"until\" marks the end point, not a single moment — use \"when\" for a moment.",
          "ru": "\"until\" — конечная точка, не момент; для момента — \"when\"."
        }
      ]
    },
    {
      "type": "reading",
      "id": "u16.d04.reading",
      "title": {
        "en": "A long journey home",
        "ru": "Долгая дорога домой"
      },
      "blocks": [
        {
          "id": "u16.d04.reading.b1",
          "en": "Our flight was delayed for hours. By the time we finally landed, the last train had already gone. Meanwhile, the rain had turned the roads into rivers, and no taxis were waiting outside.",
          "ru": "Наш рейс задержали на несколько часов. К тому времени, как мы наконец приземлились, последний поезд уже ушёл. Тем временем дождь превратил дороги в реки, и снаружи не было ни одного такси.",
          "audio": {
            "src": "media/audio/u16.d04.reading.b1.mp3",
            "license": {
              "type": "original",
              "attribution": "Project authors (LLM-assisted)"
            }
          }
        },
        {
          "id": "u16.d04.reading.b2",
          "en": "We waited until a bus appeared, and as soon as it arrived, everyone rushed on. Eventually, quite late and very tired, we reached home. In the end, we laughed about it — it had been a small adventure after all.",
          "ru": "Мы ждали, пока не появился автобус, и как только он подъехал, все ринулись внутрь. В конце концов, довольно поздно и очень уставшие, мы добрались домой. В итоге мы над этим смеялись — всё-таки это было маленькое приключение.",
          "audio": {
            "src": "media/audio/u16.d04.reading.b2.mp3",
            "license": {
              "type": "original",
              "attribution": "Project authors (LLM-assisted)"
            }
          }
        }
      ],
      "glossary": [
        {
          "word": "delay",
          "ru": "задержка; задерживать",
          "ipa": "/dɪˈleɪ/"
        },
        {
          "word": "rush",
          "ru": "спешить, кинуться",
          "ipa": "/rʌʃ/"
        }
      ]
    },
