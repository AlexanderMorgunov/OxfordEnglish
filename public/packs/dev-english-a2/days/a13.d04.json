    {
      "type": "grammar",
      "id": "a13.d04.grammar",
      "title": {
        "en": "can / can't for ability",
        "ru": "can / can't (умение)"
      },
      "ref": "modals-can",
      "rule": {
        "en": "Use can + the base verb to say what you are able to do. It is the SAME for everyone — no -s, no to: I can swim, she can swim. Negative: can't (cannot). Question: Can you…? Short answers: Yes, I can. / No, I can't.",
        "ru": "can + базовый глагол — что ты умеешь. Форма ОДИНАКОВА для всех — без -s, без to: I can swim, she can swim. Отрицание: can't (cannot). Вопрос: Can you…? Краткие ответы: Yes, I can. / No, I can't."
      },
      "patterns": [
        {
          "label": {
            "en": "can + base verb",
            "ru": "can + базовый глагол"
          },
          "formula": "subject + can + verb",
          "examples": [
            {
              "en": "I can swim.",
              "ru": "Я умею плавать."
            },
            {
              "en": "She can speak English.",
              "ru": "Она говорит по-английски."
            }
          ]
        },
        {
          "label": {
            "en": "can't (negative)",
            "ru": "can't (отрицание)"
          },
          "formula": "subject + can't + verb",
          "examples": [
            {
              "en": "He can't drive.",
              "ru": "Он не умеет водить."
            },
            {
              "en": "I can't sing.",
              "ru": "Я не умею петь."
            }
          ]
        },
        {
          "label": {
            "en": "Question & short answer",
            "ru": "Вопрос и краткий ответ"
          },
          "formula": "Can + subject + verb? → Yes, … can. / No, … can't.",
          "examples": [
            {
              "en": "Can you cook? Yes, I can.",
              "ru": "Ты умеешь готовить? Да."
            },
            {
              "en": "Can he swim? No, he can't.",
              "ru": "Он умеет плавать? Нет."
            }
          ]
        }
      ],
      "pitfalls": [
        {
          "en": "No -s and no to after can: \"she can swim\", not \"she cans\" / \"can to swim\".",
          "ru": "После can нет -s и нет to: «she can swim», а не «she cans» / «can to swim»."
        },
        {
          "en": "can't is the same for everyone: I/he/they can't.",
          "ru": "can't — одинаково для всех: I/he/they can't."
        }
      ]
    },
