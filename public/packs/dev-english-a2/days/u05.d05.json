    {
      "type": "grammar",
      "id": "u05.d05.grammar",
      "title": {
        "en": "Apologizing & thanking",
        "ru": "Извинения и благодарность"
      },
      "rule": {
        "en": "Apologize with \"I'm sorry (for) ...\" and answer with \"That's okay / Don't worry\". Thank with \"Thank you for ...\" and answer with \"You're welcome\".",
        "ru": "Извиняйся через \"I'm sorry (for) ...\" и отвечай \"That's okay / Don't worry\". Благодари через \"Thank you for ...\" и отвечай \"You're welcome\"."
      },
      "patterns": [
        {
          "label": {
            "en": "apologize",
            "ru": "извиниться"
          },
          "formula": "I'm sorry (for + -ing / about ...)",
          "examples": [
            {
              "en": "I'm sorry for being late.",
              "ru": "Извини, что опоздал."
            }
          ]
        },
        {
          "label": {
            "en": "thank",
            "ru": "поблагодарить"
          },
          "formula": "Thank you for + noun / -ing",
          "examples": [
            {
              "en": "Thank you for your help.",
              "ru": "Спасибо за помощь."
            }
          ]
        },
        {
          "label": {
            "en": "reply",
            "ru": "ответ"
          },
          "formula": "That's okay · You're welcome",
          "examples": [
            {
              "en": "Sorry! — That's okay. Thanks! — You're welcome.",
              "ru": "Извини! — Ничего. Спасибо! — Пожалуйста."
            }
          ]
        }
      ],
      "pitfalls": [
        {
          "en": "After \"sorry for\" and \"thank you for\" use a noun or -ing: \"sorry for being late\".",
          "ru": "После \"sorry for\" и \"thank you for\" — существительное или -ing: \"sorry for being late\"."
        },
        {
          "en": "\"You're welcome\" is the reply to thanks, not a greeting.",
          "ru": "\"You're welcome\" — ответ на благодарность, а не приветствие."
        }
      ]
    },
    {
      "type": "reading",
      "id": "u05.d05.reading",
      "title": {
        "en": "A small mistake",
        "ru": "Маленькая ошибка"
      },
      "blocks": [
        {
          "id": "u05.d05.reading.b1",
          "en": "Ben arrived twenty minutes late. \"I'm really sorry for being late,\" he said. \"The bus didn't come.\" \"Don't worry, it's okay,\" said Mia.",
          "ru": "Бен пришёл на двадцать минут позже. «Извини, что опоздал», — сказал он. «Автобус не пришёл». «Не переживай, всё нормально», — сказала Мия.",
          "audio": {
            "src": "media/audio/u05.d05.reading.b1.mp3",
            "license": {
              "type": "original",
              "attribution": "Project authors (LLM-assisted)"
            }
          }
        },
        {
          "id": "u05.d05.reading.b2",
          "en": "Mia helped Ben with his work all evening. \"Thank you so much for your help,\" he said. \"You're welcome,\" she smiled. \"That's what friends are for.\"",
          "ru": "Мия весь вечер помогала Бену с работой. «Огромное спасибо за помощь», — сказал он. «Пожалуйста», — улыбнулась она. «Для того и друзья».",
          "audio": {
            "src": "media/audio/u05.d05.reading.b2.mp3",
            "license": {
              "type": "original",
              "attribution": "Project authors (LLM-assisted)"
            }
          }
        }
      ],
      "glossary": [
        {
          "word": "arrive",
          "ru": "прибыть, прийти",
          "ipa": "/əˈraɪv/"
        },
        {
          "word": "friend",
          "ru": "друг",
          "ipa": "/frend/"
        }
      ]
    },
