    {
      "type": "grammar",
      "id": "u01.d01.grammar",
      "title": {
        "en": "be questions & my/your/his/her",
        "ru": "Вопросы с be и my/your/his/her"
      },
      "rule": {
        "en": "To ask with \"be\", put am/is/are first. Use possessives (my, your, his, her, our, their) to say whose.",
        "ru": "Чтобы спросить с \"be\", поставь am/is/are в начало. Притяжательные (my, your, his, her, our, their) говорят, чей."
      },
      "patterns": [
        {
          "label": {
            "en": "Question",
            "ru": "Вопрос"
          },
          "formula": "Am/Is/Are + subject … ?",
          "examples": [
            {
              "en": "Are you from Spain?",
              "ru": "Ты из Испании?"
            }
          ]
        },
        {
          "label": {
            "en": "Possessives",
            "ru": "Притяжательные"
          },
          "formula": "my · your · his · her · our · their",
          "examples": [
            {
              "en": "This is her brother.",
              "ru": "Это её брат."
            }
          ]
        }
      ],
      "pitfalls": [
        {
          "en": "\"his\" for a man, \"her\" for a woman — not tied to the object: \"her husband\", \"his wife\".",
          "ru": "\"his\" — для мужчины, \"her\" — для женщины, не зависит от предмета: \"her husband\", \"his wife\"."
        },
        {
          "en": "In questions, be comes before the subject: \"Is she…?\", not \"She is…?\".",
          "ru": "В вопросе be перед подлежащим: \"Is she…?\", а не \"She is…?\"."
        }
      ],
      "ref": "verb-be"
    },
    {
      "type": "reading",
      "id": "u01.d01.reading",
      "title": {
        "en": "Marco's family",
