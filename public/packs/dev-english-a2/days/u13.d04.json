    {
      "type": "grammar",
      "id": "u13.d04.grammar",
      "title": {
        "en": "Indefinite pronouns",
        "ru": "Неопределённые местоимения"
      },
      "rule": {
        "en": "Use some- in positive sentences, any- in questions and negatives: someone/anyone/no one (people), something/anything/nothing (things), somewhere/anywhere (places).",
        "ru": "some- — в утверждениях, any- — в вопросах и отрицаниях: someone/anyone/no one (люди), something/anything/nothing (вещи), somewhere/anywhere (места)."
      },
      "patterns": [
        {
          "label": {
            "en": "some- (positive)",
            "ru": "some- (утверждение)"
          },
          "formula": "someone · something · somewhere",
          "examples": [
            {
              "en": "Someone is at the door.",
              "ru": "Кто-то у двери."
            }
          ],
          "ref": "indefinite-pronouns"
        },
        {
          "label": {
            "en": "any- (question/neg)",
            "ru": "any- (вопрос/отриц.)"
          },
          "formula": "anyone · anything · anywhere",
          "examples": [
            {
              "en": "Is there anything to eat?",
              "ru": "Есть что-нибудь поесть?"
            }
          ],
          "ref": "indefinite-pronouns"
        },
        {
          "label": {
            "en": "no- (= not any)",
            "ru": "no- (= not any)"
          },
          "formula": "no one · nothing · nowhere",
          "examples": [
            {
              "en": "There is nothing in the box.",
              "ru": "В коробке ничего нет."
            }
          ],
          "ref": "indefinite-pronouns"
        }
      ],
      "pitfalls": [
        {
          "en": "Indefinite pronouns take a singular verb: \"Everyone is here\", not \"are\".",
          "ru": "Неопределённые местоимения — с глаголом в ед. ч.: \"Everyone is here\", не \"are\"."
        },
        {
          "en": "Use \"anything\" with a negative: \"I don't have anything\", not \"nothing\".",
          "ru": "С отрицанием — \"anything\": \"I don't have anything\", а не \"nothing\"."
        }
      ]
    },
    {
      "type": "reading",
      "id": "u13.d04.reading",
      "title": {
        "en": "A strange evening",
        "ru": "Странный вечер"
      },
      "blocks": [
        {
          "id": "u13.d04.reading.b1",
          "en": "It was late and I was a little worried. Suddenly, someone knocked at the door. \"Is anyone there?\" I asked. Nobody answered. I heard nothing.",
          "ru": "Было поздно, и я немного нервничал. Вдруг кто-то постучал в дверь. «Есть кто-нибудь?» — спросил я. Никто не ответил. Я ничего не услышал.",
          "audio": {
            "src": "media/audio/u13.d04.reading.b1.mp3",
            "license": {
              "type": "original",
              "attribution": "Project authors (LLM-assisted)"
            }
          }
        },
        {
          "id": "u13.d04.reading.b2",
          "en": "I opened the door. There was nobody outside, but there was something on the floor — a small box. Inside was a note from a friend. I was surprised and glad.",
          "ru": "Я открыл дверь. Снаружи никого не было, но что-то лежало на полу — маленькая коробка. Внутри записка от друга. Я был удивлён и рад.",
          "audio": {
            "src": "media/audio/u13.d04.reading.b2.mp3",
            "license": {
              "type": "original",
              "attribution": "Project authors (LLM-assisted)"
            }
          }
        }
      ],
      "glossary": [
        {
          "word": "knock",
          "ru": "стучать",
          "ipa": "/nɒk/"
        },
        {
          "word": "note",
          "ru": "записка",
          "ipa": "/noʊt/"
        }
      ]
    },
