    {
      "type": "grammar",
      "id": "u25.d01.grammar",
      "title": {
        "en": "so and such",
        "ru": "so и such"
      },
      "rule": {
        "en": "Use \"so\" before an adjective or adverb, and \"such\" before a noun (with or without an adjective). Both add emphasis — they make the feeling stronger.",
        "ru": "Используй «so» перед прилагательным или наречием, а «such» — перед существительным (с прилагательным или без). Оба усиливают — делают впечатление сильнее."
      },
      "patterns": [
        {
          "label": {
            "en": "so + adjective",
            "ru": "so + прилагательное"
          },
          "formula": "so + adjective/adverb",
          "examples": [
            {
              "en": "The film was so good.",
              "ru": "Фильм был таким хорошим."
            }
          ],
          "ref": "quantifiers-b1"
        },
        {
          "label": {
            "en": "such + (a) noun",
            "ru": "such + (a) существительное"
          },
          "formula": "such (a) + (adjective) + noun",
          "examples": [
            {
              "en": "It was such a good film.",
              "ru": "Это был такой хороший фильм."
            }
          ],
          "ref": "quantifiers-b1"
        },
        {
          "label": {
            "en": "so much / so many",
            "ru": "so much / so many"
          },
          "formula": "so much + uncountable · so many + plural",
          "examples": [
            {
              "en": "There was so much noise and so many people.",
              "ru": "Было столько шума и столько людей."
            }
          ],
          "ref": "quantifiers-b1"
        }
      ],
      "pitfalls": [
        {
          "en": "\"so\" + adjective, \"such\" + noun: \"so hot\" but \"such a hot day\".",
          "ru": "«so» + прилагательное, «such» + существительное: «so hot», но «such a hot day»."
        },
        {
          "en": "\"so much\" with uncountable, \"so many\" with plural nouns.",
          "ru": "«so much» с неисчисляемым, «so many» с множественным числом."
        }
      ]
    },
    {
      "type": "reading",
      "id": "u25.d01.reading",
      "title": {
        "en": "A day at the fair",
        "ru": "День на ярмарке"
      },
      "blocks": [
        {
          "id": "u25.d01.reading.b1",
          "en": "The summer fair was such a wonderful event. There were so many people that it was hard to move, and there was so much to see. The music was so loud and the lights were so bright that the children were amazed.",
          "ru": "Летняя ярмарка была таким чудесным событием. Людей было столько, что трудно было пройти, и столько всего можно было увидеть. Музыка была такой громкой, а огни такими яркими, что дети были поражены.",
          "audio": {
            "src": "media/audio/u25.d01.reading.b1.mp3",
            "license": {
              "type": "original",
              "attribution": "Project authors (LLM-assisted)"
            }
          }
        },
        {
          "id": "u25.d01.reading.b2",
          "en": "\"It's such a beautiful evening,\" said Mum. The food smelled so delicious that we bought far too much. By the end, we were so tired but so happy. It was such a perfect day that nobody wanted to go home.",
          "ru": "«Такой прекрасный вечер», — сказала мама. Еда пахла так вкусно, что мы купили слишком много. К концу мы так устали, но были так счастливы. Это был такой идеальный день, что никто не хотел идти домой.",
          "audio": {
            "src": "media/audio/u25.d01.reading.b2.mp3",
            "license": {
              "type": "original",
              "attribution": "Project authors (LLM-assisted)"
            }
          }
        }
      ],
      "glossary": [
        {
          "word": "fair",
