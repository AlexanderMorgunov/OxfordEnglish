    {
      "type": "grammar",
      "id": "u10.d05.grammar",
      "title": {
        "en": "On the phone & arranging to meet",
        "ru": "По телефону и договориться о встрече"
      },
      "rule": {
        "en": "Answer with \"Hello, this is …\". Ask with \"Can I speak to …?\". Offer with \"Can I take a message?\" / \"I'll call back\". Arrange with \"Let's meet …\" / \"See you then\".",
        "ru": "Отвечай: \"Hello, this is …\". Спрашивай: \"Can I speak to …?\". Предлагай: \"Can I take a message?\" / \"I'll call back\". Договаривайся: \"Let's meet …\" / \"See you then\"."
      },
      "patterns": [
        {
          "label": {
            "en": "answer / ask",
            "ru": "ответ / просьба"
          },
          "formula": "This is … · Can I speak to …?",
          "examples": [
            {
              "en": "Hello, this is Ben. Can I speak to Mia?",
              "ru": "Алло, это Бен. Можно Мию?"
            }
          ]
        },
        {
          "label": {
            "en": "message",
            "ru": "сообщение"
          },
          "formula": "Can I take a message? · I'll call back.",
          "examples": [
            {
              "en": "She's out. Can I take a message?",
              "ru": "Её нет. Передать что-нибудь?"
            }
          ]
        },
        {
          "label": {
            "en": "arrange",
            "ru": "договориться"
          },
          "formula": "Let's meet … · See you then.",
          "examples": [
            {
              "en": "Let's meet at six. See you then!",
              "ru": "Давай в шесть. До встречи!"
            }
          ]
        }
      ],
      "pitfalls": [
        {
          "en": "On the phone say \"This is Ben\", not \"I am Ben\".",
          "ru": "По телефону — \"This is Ben\", а не \"I am Ben\"."
        },
        {
          "en": "\"Can I speak to …?\" to ask for a person.",
          "ru": "\"Can I speak to …?\" — чтобы попросить позвать человека."
        }
      ]
    },
    {
      "type": "reading",
      "id": "u10.d05.reading",
      "title": {
        "en": "A phone call",
        "ru": "Телефонный разговор"
      },
      "blocks": [
        {
          "id": "u10.d05.reading.b1",
          "en": "\"Hello, this is Ben. Can I speak to Mia, please?\" \"I'm sorry, she's out. Can I take a message?\" \"Yes. Can you tell her I'll call back at six?\"",
          "ru": "«Алло, это Бен. Можно Мию, пожалуйста?» «Извините, её нет. Передать что-нибудь?» «Да. Скажите, что я перезвоню в шесть».",
          "audio": {
            "src": "media/audio/u10.d05.reading.b1.wav",
            "license": {
              "type": "original",
              "attribution": "Project authors (LLM-assisted)"
            }
          }
        },
        {
          "id": "u10.d05.reading.b2",
          "en": "Later Ben called again. \"Hi Mia! Shall we meet tonight?\" \"Sure! Let's meet at the café at seven.\" \"Great. See you then!\"",
          "ru": "Позже Бен позвонил снова. «Привет, Мия! Встретимся сегодня?» «Конечно! Давай в кафе в семь». «Отлично. До встречи!»",
          "audio": {
            "src": "media/audio/u10.d05.reading.b2.wav",
            "license": {
              "type": "original",
              "attribution": "Project authors (LLM-assisted)"
            }
          }
        }
      ],
      "glossary": [
        {
          "word": "out",
          "ru": "вышел, отсутствует",
          "ipa": "/aʊt/"
        },
        {
          "word": "tell",
          "ru": "сказать, передать",
          "ipa": "/tel/"
        }
      ]
    },
