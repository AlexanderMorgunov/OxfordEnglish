    {
      "type": "grammar",
      "id": "u07.d02.grammar",
      "title": {
        "en": "Some, any, much, many",
        "ru": "Some, any, much, many"
      },
      "rule": {
        "en": "Countable nouns have a plural (one egg, two eggs). Uncountable nouns do not (water, rice, bread). Use \"some\" in statements, \"any\" in questions and negatives.",
        "ru": "Исчисляемые существительные имеют мн. число (one egg, two eggs). Неисчисляемые — нет (water, rice, bread). \"some\" — в утверждениях, \"any\" — в вопросах и отрицаниях."
      },
      "patterns": [
        {
          "label": {
            "en": "some / any",
            "ru": "some / any"
          },
          "formula": "some (+) · any (− ?)",
          "examples": [
            {
              "en": "I have some bread, but I don't have any butter.",
              "ru": "У меня есть хлеб, но нет масла."
            }
          ]
        },
        {
          "label": {
            "en": "how much / how many",
            "ru": "how much / how many"
          },
          "formula": "how much + uncountable · how many + countable",
          "examples": [
            {
              "en": "How much sugar? How many eggs?",
              "ru": "Сколько сахара? Сколько яиц?"
            }
          ]
        }
      ],
      "pitfalls": [
        {
          "en": "\"bread, water, money, advice, information\" are uncountable — no \"a bread\", no \"informations\".",
          "ru": "\"bread, water, money, advice, information\" неисчисляемые — нельзя \"a bread\" или \"informations\"."
        },
        {
          "en": "Use \"much\" with uncountable, \"many\" with countable: \"much water\", \"many apples\".",
          "ru": "\"much\" с неисчисляемыми, \"many\" с исчисляемыми: \"much water\", \"many apples\"."
        }
      ]
    },
