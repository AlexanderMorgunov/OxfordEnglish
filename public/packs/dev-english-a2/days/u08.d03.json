    {
      "type": "grammar",
      "id": "u08.d03.grammar",
      "title": {
        "en": "Prepositions of movement",
        "ru": "Предлоги движения"
      },
      "rule": {
        "en": "Show movement with prepositions: along, across, past, through, into / out of, up / down, over, towards.",
        "ru": "Движение показывают предлоги: along, across, past, through, into / out of, up / down, over, towards."
      },
      "patterns": [
        {
          "label": {
            "en": "along / across",
            "ru": "along / across"
          },
          "formula": "along the street · across the road",
          "examples": [
            {
              "en": "Walk along the street and across the square.",
              "ru": "Иди по улице и через площадь."
            }
          ],
          "ref": "prepositions-place"
        },
        {
          "label": {
            "en": "through / past",
            "ru": "through / past"
          },
          "formula": "through the park · past the shop",
          "examples": [
            {
              "en": "Go through the park, past the café.",
              "ru": "Пройди через парк, мимо кафе."
            }
          ]
        },
        {
          "label": {
            "en": "into / out of",
            "ru": "into / out of"
          },
          "formula": "into the shop · out of the station",
          "examples": [
            {
              "en": "Come out of the station and go towards the bridge.",
              "ru": "Выйди из вокзала и иди к мосту."
            }
          ],
          "ref": "prepositions-place"
        }
      ],
      "pitfalls": [
        {
          "en": "\"across\" = from one side to the other; \"along\" = following the length.",
          "ru": "\"across\" = с одной стороны на другую; \"along\" = вдоль."
        },
        {
          "en": "\"into/out of\" for entering/leaving: \"into the shop\", \"out of the car\".",
          "ru": "\"into/out of\" — войти/выйти: \"into the shop\", \"out of the car\"."
        }
      ]
    },
    {
      "type": "reading",
      "id": "u08.d03.reading",
      "title": {
        "en": "A walk to the station",
        "ru": "Прогулка до вокзала"
      },
      "blocks": [
        {
          "id": "u08.d03.reading.b1",
          "en": "To get to the station, come out of the hotel and walk along the main street. Go past the market and across the small square.",
          "ru": "Чтобы добраться до вокзала, выйди из отеля и иди по главной улице. Пройди мимо рынка и через маленькую площадь.",
          "audio": {
            "src": "media/audio/u08.d03.reading.b1.mp3",
            "license": {
              "type": "original",
              "attribution": "Project authors (LLM-assisted)"
            }
          }
        },
        {
          "id": "u08.d03.reading.b2",
          "en": "Then walk through the park and over the bridge. The station is on the other side, towards the river. It takes about ten minutes.",
          "ru": "Потом пройди через парк и через мост. Вокзал на другой стороне, ближе к реке. Это займёт около десяти минут.",
          "audio": {
            "src": "media/audio/u08.d03.reading.b2.mp3",
            "license": {
              "type": "original",
              "attribution": "Project authors (LLM-assisted)"
            }
          }
        }
      ],
      "glossary": [
        {
          "word": "main",
          "ru": "главный",
          "ipa": "/meɪn/"
        },
        {
          "word": "side",
          "ru": "сторона",
          "ipa": "/saɪd/"
        }
      ]
    },
