    {
      "type": "grammar",
      "id": "a11.d06.grammar",
      "title": {
        "en": "Everything together: be, pronouns, a/an, plurals, this/that",
        "ru": "Всё вместе: be, местоимения, a/an, множественное, this/that"
      },
      "rule": {
        "en": "You can now: say who you are with be (I am, he is, we are); ask and answer yes/no questions (Are you…? Yes, I am.); use a/an and plurals (a book, two books); point with this/that/these/those; and give your age (I am twenty). That is enough to meet people — the A2 course (unit 1) starts right here.",
        "ru": "Теперь ты умеешь: сказать, кто ты, через be (I am, he is, we are); задавать и отвечать на вопросы да/нет (Are you…? Yes, I am.); использовать a/an и множественное (a book, two books); указывать this/that/these/those; называть возраст (I am twenty). Этого хватает, чтобы знакомиться — курс A2 (юнит 1) начинается прямо отсюда."
      },
      "patterns": [
        {
          "label": {
            "en": "Introduce yourself",
            "ru": "Представься"
          },
          "formula": "I am … + I am from … + I am a …",
          "examples": [
            {
              "en": "I am Ann. I am from Russia. I am a student.",
              "ru": "Я Анна. Я из России. Я студентка."
            }
          ]
        },
        {
          "label": {
            "en": "Ask about someone",
            "ru": "Спроси о ком-то"
          },
          "formula": "Who is …? / Are you …? / How old …?",
          "examples": [
            {
              "en": "Who is he? Is he a teacher? How old is he?",
              "ru": "Кто он? Он учитель? Сколько ему лет?"
            }
          ]
        }
      ],
      "pitfalls": [
        {
          "en": "Don't drop be, and match it: I am, he is, they are.",
          "ru": "Не пропускай be и согласуй: I am, he is, they are."
        },
        {
          "en": "One thing → a/an + is; many → plural + are.",
          "ru": "Один предмет → a/an + is; несколько → множественное + are."
        }
      ]
    },
