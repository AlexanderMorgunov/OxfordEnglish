    {
      "type": "grammar",
      "id": "u29.d03.grammar",
      "title": {
        "en": "Reported commands & requests",
        "ru": "Косвенные команды и просьбы"
      },
      "rule": {
        "en": "Report an order or request with verb + object + to-infinitive: tell/ask/advise/warn/remind + someone + (not) to do. For a negative, put \"not\" before \"to\".",
        "ru": "Команду или просьбу передают через глагол + объект + to-инфинитив: tell/ask/advise/warn/remind + кого-то + (not) to do. Для отрицания «not» ставится перед «to»."
      },
      "patterns": [
        {
          "label": {
            "en": "command",
            "ru": "команда"
          },
          "formula": "told + someone + to + V1",
          "examples": [
            {
              "en": "He told me to wait.",
              "ru": "Он велел мне ждать."
            }
          ],
          "ref": "past-modals"
        },
        {
          "label": {
            "en": "request",
            "ru": "просьба"
          },
          "formula": "asked + someone + to + V1",
          "examples": [
            {
              "en": "She asked me to help.",
              "ru": "Она попросила меня помочь."
            }
          ],
          "ref": "past-modals"
        },
        {
          "label": {
            "en": "negative",
            "ru": "отрицание"
          },
          "formula": "told + someone + not to + V1",
          "examples": [
            {
              "en": "They told us not to touch it.",
              "ru": "Нам велели не трогать это."
            }
          ],
          "ref": "past-modals"
        }
      ],
      "pitfalls": [
        {
          "en": "Use \"to + V1\", not \"that\": \"told me to wait\", not \"told me that wait\".",
          "ru": "«to + V1», не «that»: «told me to wait», не «told me that wait»."
        },
        {
          "en": "Negative: \"not to\", not \"to not\": \"asked me not to go\".",
          "ru": "Отрицание: «not to», не «to not»: «asked me not to go»."
        }
      ]
    },
    {
      "type": "reading",
      "id": "u29.d03.reading",
      "title": {
        "en": "The first day",
        "ru": "Первый день"
      },
      "blocks": [
        {
          "id": "u29.d03.reading.b1",
          "en": "On my first day, everyone gave me instructions. My manager told me to read the handbook and asked me to introduce myself to the team. A colleague warned me not to use the old printer and advised me to save everything twice.",
          "ru": "В первый день все давали мне указания. Менеджер велел прочитать руководство и попросил представиться команде. Коллега предупредил не пользоваться старым принтером и посоветовал всё сохранять дважды.",
          "audio": {
            "src": "media/audio/u29.d03.reading.b1.mp3",
            "license": {
              "type": "original",
              "attribution": "Project authors (LLM-assisted)"
            }
          }
        },
        {
          "id": "u29.d03.reading.b2",
          "en": "Security reminded me to wear my badge and forbade me to prop the doors open. By lunch, my head was spinning. My mentor encouraged me to relax and told me not to worry — she said everyone forgets half of it anyway.",
          "ru": "Охрана напомнила носить бейдж и запретила подпирать двери. К обеду голова шла кругом. Наставница подбодрила меня расслабиться и сказала не волноваться — мол, все всё равно половину забывают.",
          "audio": {
            "src": "media/audio/u29.d03.reading.b2.mp3",
            "license": {
              "type": "original",
              "attribution": "Project authors (LLM-assisted)"
            }
          }
        }
      ],
      "glossary": [
        {
          "word": "handbook",
          "ru": "руководство",
          "ipa": "/ˈhændbʊk/"
        },
        {
          "word": "badge",
