    {
      "type": "grammar",
      "id": "u08.d02.grammar",
      "title": {
        "en": "Imperatives for directions",
        "ru": "Повелительное наклонение (указания пути)"
      },
      "rule": {
        "en": "Give directions with the base verb and no subject: Go, Turn, Take, Cross. For a negative use \"Don't + verb\".",
        "ru": "Указания пути — начальная форма глагола без подлежащего: Go, Turn, Take, Cross. Отрицание — \"Don't + глагол\"."
      },
      "patterns": [
        {
          "label": {
            "en": "go / turn",
            "ru": "go / turn"
          },
          "formula": "Go straight on. · Turn left / right.",
          "examples": [
            {
              "en": "Go straight on and turn right.",
              "ru": "Иди прямо и поверни направо."
            }
          ],
          "ref": "imperatives"
        },
        {
          "label": {
            "en": "take / cross",
            "ru": "take / cross"
          },
          "formula": "Take the first left. · Cross the road.",
          "examples": [
            {
              "en": "Take the second street on the left.",
              "ru": "Сверни на вторую улицу налево."
            }
          ]
        },
        {
          "label": {
            "en": "don't",
            "ru": "don't"
          },
          "formula": "Don't + verb",
          "examples": [
            {
              "en": "Don't turn here — go past the park.",
              "ru": "Не поворачивай здесь — иди мимо парка."
            }
          ],
          "ref": "imperatives"
        }
      ],
      "pitfalls": [
        {
          "en": "No subject in the imperative: \"Turn left\", not \"You turn left\".",
          "ru": "В повелительном нет подлежащего: \"Turn left\", а не \"You turn left\"."
        },
        {
          "en": "Use \"the first/second + (street) on the left/right\".",
          "ru": "Используй \"the first/second + (street) on the left/right\"."
        }
      ]
    },
    {
      "type": "reading",
      "id": "u08.d02.reading",
      "title": {
        "en": "How to find the museum",
        "ru": "Как найти музей"
      },
      "blocks": [
        {
          "id": "u08.d02.reading.b1",
          "en": "Finding the museum is easy. Go straight on down this street and cross the bridge. Then turn left at the traffic lights.",
          "ru": "Найти музей легко. Иди прямо по этой улице и перейди мост. Потом поверни налево у светофора.",
          "audio": {
            "src": "media/audio/u08.d02.reading.b1.mp3",
            "license": {
              "type": "original",
              "attribution": "Project authors (LLM-assisted)"
            }
          }
        },
        {
          "id": "u08.d02.reading.b2",
          "en": "Take the first street on the right and go past the library. The museum is on the corner, opposite the park. Don't go too far!",
          "ru": "Сверни на первую улицу направо и пройди мимо библиотеки. Музей на углу, напротив парка. Не уходи слишком далеко!",
          "audio": {
            "src": "media/audio/u08.d02.reading.b2.mp3",
            "license": {
              "type": "original",
              "attribution": "Project authors (LLM-assisted)"
            }
          }
        }
      ],
