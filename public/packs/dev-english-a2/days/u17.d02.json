    {
      "type": "grammar",
      "id": "u17.d02.grammar",
      "title": {
        "en": "for / since with the continuous",
        "ru": "for / since с длительной формой"
      },
      "rule": {
        "en": "The present perfect continuous is often used with \"for\" (a length of time) and \"since\" (a starting point) to say how long an activity has been going on. Ask about it with \"How long have you been…?\"",
        "ru": "Present perfect continuous часто идёт с «for» (отрезок времени) и «since» (точка начала), чтобы сказать, как долго длится действие. Спрашивают через «How long have you been…?»"
      },
      "patterns": [
        {
          "label": {
            "en": "for + period",
            "ru": "for + период"
          },
          "formula": "have been + -ing + for …",
          "examples": [
            {
              "en": "I've been learning English for two years.",
              "ru": "Я учу английский два года."
            }
          ],
          "ref": "present-perfect-signals"
        },
        {
          "label": {
            "en": "since + point",
            "ru": "since + точка"
          },
          "formula": "have been + -ing + since …",
          "examples": [
            {
              "en": "She's been working here since 2021.",
              "ru": "Она работает здесь с 2021 года."
            }
          ],
          "ref": "present-perfect-signals"
        },
        {
          "label": {
            "en": "How long…?",
            "ru": "Как долго…?"
          },
          "formula": "How long have you been + -ing?",
          "examples": [
            {
              "en": "How long have you been waiting?",
              "ru": "Как долго ты ждёшь?"
            }
          ],
          "ref": "present-perfect-continuous"
        }
      ],
      "pitfalls": [
        {
          "en": "\"for\" + a length (for two hours); \"since\" + a start point (since Monday).",
          "ru": "«for» + отрезок (for two hours); «since» + точка начала (since Monday)."
        },
        {
          "en": "Use the continuous for the activity: \"How long have you been studying?\"",
          "ru": "Для процесса — длительная форма: «How long have you been studying?»"
        }
      ]
    },
    {
      "type": "reading",
      "id": "u17.d02.reading",
      "title": {
        "en": "Learning the guitar",
        "ru": "Учусь играть на гитаре"
      },
      "blocks": [
        {
          "id": "u17.d02.reading.b1",
          "en": "Dan has been learning the guitar for about a year. He hasn't been taking lessons — he's been teaching himself from videos online. \"I've been practising almost every evening since last spring,\" he says.",
          "ru": "Дэн учится играть на гитаре около года. Он не берёт уроки — учится сам по видео в интернете. «Я практикуюсь почти каждый вечер с прошлой весны», — говорит он.",
          "audio": {
            "src": "media/audio/u17.d02.reading.b1.mp3",
            "license": {
              "type": "original",
              "attribution": "Project authors (LLM-assisted)"
            }
          }
        },
        {
          "id": "u17.d02.reading.b2",
          "en": "At first it was hard, but he has been making real progress. His fingers used to hurt, and he couldn't play a single song. Now he has been playing for his friends, and they say he's getting good.",
          "ru": "Сначала было трудно, но он делает реальный прогресс. Раньше пальцы болели, и он не мог сыграть ни одной песни. Теперь он играет для друзей, и они говорят, что у него хорошо получается.",
          "audio": {
            "src": "media/audio/u17.d02.reading.b2.mp3",
            "license": {
              "type": "original",
              "attribution": "Project authors (LLM-assisted)"
            }
          }
        }
      ],
