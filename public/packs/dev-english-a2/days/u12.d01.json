    {
      "type": "grammar",
      "id": "u12.d01.grammar",
      "title": {
        "en": "Present perfect: ever / never",
        "ru": "Present perfect: ever / never"
      },
      "rule": {
        "en": "Talk about experiences (no exact time) with the present perfect: have/has + past participle. Use \"ever\" in questions and \"never\" for none.",
        "ru": "О жизненном опыте (без точного времени) — present perfect: have/has + причастие прошедшего. \"ever\" — в вопросах, \"never\" — если ни разу."
      },
      "patterns": [
        {
          "label": {
            "en": "have/has + V3",
            "ru": "have/has + V3"
          },
          "formula": "have/has + past participle",
          "examples": [
            {
              "en": "I have visited Paris.",
              "ru": "Я был в Париже."
            }
          ]
        },
        {
          "label": {
            "en": "ever (question)",
            "ru": "ever (вопрос)"
          },
          "formula": "Have you ever + V3?",
          "examples": [
            {
              "en": "Have you ever been abroad?",
              "ru": "Ты когда-нибудь был за границей?"
            }
          ]
        },
        {
          "label": {
            "en": "never",
            "ru": "never"
          },
          "formula": "have/has never + V3",
          "examples": [
            {
              "en": "She has never eaten sushi.",
              "ru": "Она никогда не ела суши."
            }
          ]
        }
      ],
      "pitfalls": [
        {
          "en": "Learn past participles: be → been, see → seen, do → done, eat → eaten, go → gone.",
          "ru": "Учи причастия: be → been, see → seen, do → done, eat → eaten, go → gone."
        },
        {
          "en": "Use \"has\" for he/she/it: \"she has been\", not \"she have been\".",
          "ru": "Для he/she/it — \"has\": \"she has been\", а не \"she have been\"."
        }
      ],
      "ref": "present-perfect"
    },
    {
      "type": "reading",
      "id": "u12.d01.reading",
      "title": {
        "en": "A traveller",
        "ru": "Путешественница"
      },
      "blocks": [
        {
          "id": "u12.d01.reading.b1",
          "en": "My aunt loves travelling. She has visited more than twenty countries. She has seen the mountains of Nepal and has swum in three oceans.",
          "ru": "Моя тётя обожает путешествия. Она побывала более чем в двадцати странах. Она видела горы Непала и плавала в трёх океанах.",
          "audio": {
            "src": "media/audio/u12.d01.reading.b1.wav",
            "license": {
              "type": "original",
              "attribution": "Project authors (LLM-assisted)"
            }
          }
        },
        {
          "id": "u12.d01.reading.b2",
          "en": "She has never been to Australia, but it is her dream. \"Have you ever felt afraid on a trip?\" I asked. \"Never,\" she said. \"Travel is always an adventure.\"",
          "ru": "Она никогда не была в Австралии, но это её мечта. «Ты когда-нибудь боялась в поездке?» — спросил я. «Никогда, — сказала она. — Путешествие всегда приключение».",
          "audio": {
            "src": "media/audio/u12.d01.reading.b2.wav",
            "license": {
              "type": "original",
              "attribution": "Project authors (LLM-assisted)"
            }
          }
        }
      ],
