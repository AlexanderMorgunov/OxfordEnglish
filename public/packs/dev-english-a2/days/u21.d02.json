    {
      "type": "grammar",
      "id": "u21.d02.grammar",
      "title": {
        "en": "be about to",
        "ru": "be about to"
      },
      "rule": {
        "en": "Use \"be about to + verb\" for something that will happen very soon — in the next moment. It is stronger and more immediate than \"going to\".",
        "ru": "Используй «be about to + глагол» для того, что произойдёт совсем скоро — в следующий миг. Это ближе и настойчивее, чем «going to»."
      },
      "patterns": [
        {
          "label": {
            "en": "be about to + verb",
            "ru": "be about to + глагол"
          },
          "formula": "am/is/are about to + verb",
          "examples": [
            {
              "en": "Hurry — the train is about to leave.",
              "ru": "Скорее — поезд вот-вот тронется."
            }
          ],
          "ref": "future-forms-extended"
        },
        {
          "label": {
            "en": "just about to",
            "ru": "just about to"
          },
          "formula": "be just about to + verb",
          "examples": [
            {
              "en": "I'm just about to call you.",
              "ru": "Я как раз собираюсь тебе позвонить."
            }
          ],
          "ref": "future-forms-extended"
        },
        {
          "label": {
            "en": "on the point of + -ing",
            "ru": "on the point of + -ing"
          },
          "formula": "be on the point of + verb-ing",
          "examples": [
            {
              "en": "She was on the point of leaving.",
              "ru": "Она как раз собиралась уходить."
            }
          ],
          "ref": "future-forms-extended"
        }
      ],
      "pitfalls": [
        {
          "en": "\"about to\" + bare verb: \"about to leave\", not \"about to leaving\".",
          "ru": "«about to» + голый глагол: «about to leave», а не «about to leaving»."
        },
        {
          "en": "\"on the point of\" + -ing: \"on the point of crying\".",
          "ru": "«on the point of» + -ing: «on the point of crying»."
        }
      ]
    },
    {
      "type": "reading",
      "id": "u21.d02.reading",
      "title": {
        "en": "Just in time",
        "ru": "Как раз вовремя"
      },
      "blocks": [
        {
          "id": "u21.d02.reading.b1",
          "en": "The doors were about to close when Marco ran onto the train. He was just about to give up when he saw it still at the platform. \"I almost missed it,\" he thought, out of breath.",
          "ru": "Двери уже закрывались, когда Марко вбежал в вагон. Он как раз собирался сдаться, когда увидел, что поезд ещё на платформе. «Чуть не опоздал», — подумал он, тяжело дыша.",
          "audio": {
            "src": "media/audio/u21.d02.reading.b1.mp3",
            "license": {
              "type": "original",
              "attribution": "Project authors (LLM-assisted)"
            }
          }
        },
        {
          "id": "u21.d02.reading.b2",
          "en": "He sat down and checked his phone. His sister had written: \"Where are you? The show is about to start!\" Marco smiled. \"On my way,\" he replied. \"I'll be there before the lights go down.\"",
          "ru": "Он сел и проверил телефон. Сестра написала: «Ты где? Спектакль вот-вот начнётся!» Марко улыбнулся. «Уже еду, — ответил он. — Буду до того, как погаснет свет».",
          "audio": {
            "src": "media/audio/u21.d02.reading.b2.mp3",
            "license": {
              "type": "original",
              "attribution": "Project authors (LLM-assisted)"
            }
          }
        }
      ],
      "glossary": [
        {
          "word": "give up",
          "ru": "сдаваться",
          "ipa": "/ɡɪv ʌp/"
        },
        {
          "word": "platform",
          "ru": "платформа",
          "ipa": "/ˈplætfɔːrm/"
        }
      ]
    },
