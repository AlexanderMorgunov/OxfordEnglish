    {
      "type": "grammar",
      "id": "u10.d04.grammar",
      "title": {
        "en": "Suggestions · future time clauses",
        "ru": "Предложения · придаточные времени"
      },
      "rule": {
        "en": "Suggest with \"Shall we…?\", \"Let's + verb\", \"Why don't we…?\". After when / as soon as / before / after use the present simple, not will.",
        "ru": "Предлагай: \"Shall we…?\", \"Let's + глагол\", \"Why don't we…?\". После when / as soon as / before / after — present simple, не will."
      },
      "patterns": [
        {
          "label": {
            "en": "suggest",
            "ru": "предложить"
          },
          "formula": "Shall we…? · Let's + verb",
          "examples": [
            {
              "en": "Shall we meet at six? Let's have coffee.",
              "ru": "Встретимся в шесть? Давай выпьем кофе."
            }
          ]
        },
        {
          "label": {
            "en": "time clause",
            "ru": "придаточное времени"
          },
          "formula": "when/as soon as + present simple",
          "examples": [
            {
              "en": "I'll call you when I arrive.",
              "ru": "Я позвоню, когда приеду."
            }
          ]
        },
        {
          "label": {
            "en": "before / after",
            "ru": "before / after"
          },
          "formula": "before/after + present simple",
          "examples": [
            {
              "en": "Text me before you leave.",
              "ru": "Напиши перед уходом."
            }
          ]
        }
      ],
      "pitfalls": [
        {
          "en": "No \"will\" in the time clause: \"when I arrive\", not \"when I will arrive\".",
          "ru": "В придаточном времени нет \"will\": \"when I arrive\", а не \"when I will arrive\"."
        },
        {
          "en": "After \"Let's\" use the base verb: \"Let's go\", not \"Let's to go\".",
          "ru": "После \"Let's\" — начальная форма: \"Let's go\", а не \"Let's to go\"."
        }
      ]
    },
    {
      "type": "reading",
      "id": "u10.d04.reading",
      "title": {
        "en": "Making a plan",
