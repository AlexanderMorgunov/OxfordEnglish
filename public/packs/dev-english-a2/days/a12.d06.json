    {
      "type": "grammar",
      "id": "a12.d06.grammar",
      "title": {
        "en": "Everything together: have got, 's, there is/are, prepositions, some/any",
        "ru": "Всё вместе: have got, 's, there is/are, предлоги, some/any"
      },
      "rule": {
        "en": "You can now: say what you have (I have got a sister); say whose it is (my, her, Ann's); say what is in a place (There is / There are); say where (in, on, under, next to); and use some / any. That is enough to describe your home and family.",
        "ru": "Теперь ты умеешь: сказать, что у тебя есть (I have got a sister); чьё это (my, her, Ann's); что находится в месте (There is / There are); где (in, on, under, next to); и использовать some / any. Этого хватает, чтобы описать свой дом и семью."
      },
      "patterns": [
        {
          "label": {
            "en": "Describe your home",
            "ru": "Опиши свой дом"
          },
          "formula": "There is/are … + preposition + …",
          "examples": [
            {
              "en": "There is a sofa next to the window.",
              "ru": "Диван рядом с окном."
            }
          ]
        },
        {
          "label": {
            "en": "Describe your family",
            "ru": "Опиши свою семью"
          },
          "formula": "I have got … + my/his/her …",
          "examples": [
            {
              "en": "I have got a sister. Her name is Kate.",
              "ru": "У меня есть сестра. Её зовут Кейт."
            }
          ]
        }
      ],
      "pitfalls": [
        {
          "en": "has got for he/she/it; There is for one, There are for many.",
          "ru": "has got для he/she/it; There is для одного, There are для нескольких."
        },
        {
          "en": "some in positives, any in questions/negatives.",
          "ru": "some в утверждениях, any в вопросах/отрицаниях."
        }
      ]
    },
    {
      "type": "reading",
      "id": "a12.d06.reading",
      "title": {
        "en": "Welcome to my home",
