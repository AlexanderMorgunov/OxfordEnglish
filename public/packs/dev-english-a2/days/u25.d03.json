    {
      "type": "grammar",
      "id": "u25.d03.grammar",
      "title": {
        "en": "all / every / each / whole",
        "ru": "all / every / each / whole"
      },
      "rule": {
        "en": "\"every\" and \"each\" + singular noun (every day, each person). \"all\" + plural or uncountable (all the students, all day). \"whole\" + singular noun (the whole day). \"each\" stresses one at a time.",
        "ru": "«every» и «each» + существительное в единственном (every day, each person). «all» + множественное или неисчисляемое (all the students, all day). «whole» + существительное в единственном (the whole day). «each» подчёркивает «по одному»."
      },
      "patterns": [
        {
          "label": {
            "en": "every / each + singular",
            "ru": "every / each + ед. число"
          },
          "formula": "every/each + singular noun + singular verb",
          "examples": [
            {
              "en": "Every student has a book. Each one is different.",
              "ru": "У каждого студента есть книга. Каждая своя."
            }
          ],
          "ref": "quantifiers-b1"
        },
        {
          "label": {
            "en": "all + plural/uncountable",
            "ru": "all + мн./неисч."
          },
          "formula": "all (the) + plural/uncountable",
          "examples": [
            {
              "en": "All the students passed. I worked all day.",
              "ru": "Все студенты сдали. Я работал весь день."
            }
          ],
          "ref": "quantifiers-b1"
        },
        {
          "label": {
            "en": "the whole + singular",
            "ru": "the whole + ед. число"
          },
          "formula": "the whole + singular noun",
          "examples": [
            {
              "en": "I read the whole book.",
              "ru": "Я прочитал всю книгу."
            }
          ],
          "ref": "quantifiers-b1"
        }
      ],
      "pitfalls": [
        {
          "en": "\"every/each\" take a singular noun and verb: \"every day is\", not \"every days are\".",
          "ru": "«every/each» — единственное число и глагол: «every day is», а не «every days are»."
        },
        {
          "en": "\"the whole day\" = \"all day\" (both mean the entire day).",
          "ru": "«the whole day» = «all day» (оба — весь день)."
        }
      ]
    },
    {
      "type": "reading",
      "id": "u25.d03.reading",
      "title": {
        "en": "The school trip",
        "ru": "Школьная поездка"
      },
      "blocks": [
        {
          "id": "u25.d03.reading.b1",
          "en": "Every year, the whole class goes on a trip. This year, all the students voted for the mountains. Each child had to bring a bag, and every bag was checked before we left. Everyone was excited.",
          "ru": "Каждый год весь класс едет в поездку. В этом году все ученики проголосовали за горы. Каждый ребёнок должен был взять рюкзак, и каждый рюкзак проверили перед отъездом. Все были в восторге.",
          "audio": {
            "src": "media/audio/u25.d03.reading.b1.wav",
            "license": {
              "type": "original",
              "attribution": "Project authors (LLM-assisted)"
            }
          }
        },
        {
          "id": "u25.d03.reading.b2",
          "en": "We spent the whole day walking, and every single view was beautiful. In the evening, each student shared a story around the fire. \"All of us will remember this,\" said the teacher. \"Every one of you was wonderful today.\"",
          "ru": "Мы весь день ходили пешком, и каждый вид был прекрасен. Вечером каждый ученик рассказал историю у костра. «Все мы это запомним, — сказал учитель. — Каждый из вас был сегодня замечательным».",
          "audio": {
            "src": "media/audio/u25.d03.reading.b2.wav",
            "license": {
              "type": "original",
              "attribution": "Project authors (LLM-assisted)"
            }
          }
        }
      ],
