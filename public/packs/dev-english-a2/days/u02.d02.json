    {
      "type": "grammar",
      "id": "u02.d02.grammar",
      "title": {
        "en": "do / does questions",
        "ru": "Вопросы с do / does"
      },
      "rule": {
        "en": "Make questions and negatives with do/does. \"Do you…?\", \"Does she…?\", \"I don't…\", \"He doesn't…\". The main verb stays base (no -s).",
        "ru": "Вопросы и отрицания — с do/does. \"Do you…?\", \"Does she…?\", \"I don't…\", \"He doesn't…\". Основной глагол в начальной форме (без -s)."
      },
      "patterns": [
        {
          "label": {
            "en": "Question",
            "ru": "Вопрос"
          },
          "formula": "Do/Does + subject + verb ?",
          "examples": [
            {
              "en": "Does she work here?",
              "ru": "Она здесь работает?"
            }
          ],
          "ref": "present-simple"
        },
        {
          "label": {
            "en": "Short answer",
            "ru": "Краткий ответ"
          },
          "formula": "Yes, I do. / No, she doesn't.",
          "examples": [
            {
              "en": "Do you drive? — Yes, I do.",
              "ru": "Ты водишь? — Да."
            }
          ],
          "ref": "present-simple"
        }
      ],
      "pitfalls": [
        {
          "en": "After do/does the verb loses -s: \"Does she work?\", not \"Does she works?\".",
          "ru": "После do/does глагол теряет -s: \"Does she work?\", а не \"Does she works?\"."
        },
        {
          "en": "\"doesn't\" for he/she/it, \"don't\" for the rest.",
          "ru": "\"doesn't\" — для he/she/it, \"don't\" — для остальных."
        }
      ]
    },
