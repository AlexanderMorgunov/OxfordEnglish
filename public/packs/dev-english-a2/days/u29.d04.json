    {
      "type": "grammar",
      "id": "u29.d04.grammar",
      "title": {
        "en": "Reporting verbs & their patterns",
        "ru": "Глаголы речи и их модели"
      },
      "rule": {
        "en": "Many reporting verbs have a fixed pattern: verb + -ing (admit/deny/suggest), verb + to-infinitive (promise/agree/refuse/offer/threaten), or verb + preposition + -ing (apologize for / accuse sb of / insist on).",
        "ru": "У многих глаголов речи фиксированная модель: verb + -ing (admit/deny/suggest), verb + to-инфинитив (promise/agree/refuse/offer/threaten) или verb + предлог + -ing (apologize for / accuse sb of / insist on)."
      },
      "patterns": [
        {
          "label": {
            "en": "verb + -ing",
            "ru": "verb + -ing"
          },
          "formula": "admit / deny / suggest + V-ing",
          "examples": [
            {
              "en": "He denied taking the money.",
              "ru": "Он отрицал, что взял деньги."
            }
          ],
          "ref": "past-modals"
        },
        {
          "label": {
            "en": "verb + to",
            "ru": "verb + to"
          },
          "formula": "refuse / agree / offer + to + V1",
          "examples": [
            {
              "en": "She refused to answer.",
              "ru": "Она отказалась отвечать."
            }
          ],
          "ref": "past-modals"
        },
        {
          "label": {
            "en": "verb + prep + -ing",
            "ru": "verb + предлог + -ing"
          },
          "formula": "apologize for / accuse of + V-ing",
          "examples": [
            {
              "en": "He apologized for being late.",
              "ru": "Он извинился за опоздание."
            }
          ],
          "ref": "past-modals"
        }
      ],
      "pitfalls": [
        {
          "en": "\"suggest\" takes -ing or \"that\", not \"to\": \"suggested going\", not \"suggested to go\".",
          "ru": "«suggest» — с -ing или «that», не «to»: «suggested going», не «suggested to go»."
        },
        {
          "en": "After a preposition use -ing: \"accused him of cheating\", not \"to cheat\".",
          "ru": "После предлога — -ing: «accused him of cheating», не «to cheat»."
        }
      ]
    },
    {
      "type": "reading",
      "id": "u29.d04.reading",
      "title": {
        "en": "The apology",
        "ru": "Извинение"
      },
      "blocks": [
        {
          "id": "u29.d04.reading.b1",
          "en": "The meeting got tense fast. Dan accused the vendor of missing every deadline, and the vendor denied breaking the contract. He insisted on reviewing the emails before anyone said another word.",
          "ru": "Совещание быстро накалилось. Дэн обвинил подрядчика в срыве всех сроков, а подрядчик отрицал нарушение контракта. Он настоял на том, чтобы просмотреть письма, прежде чем кто-то скажет ещё хоть слово.",
          "audio": {
            "src": "media/audio/u29.d04.reading.b1.mp3",
            "license": {
              "type": "original",
              "attribution": "Project authors (LLM-assisted)"
            }
          }
        },
        {
          "id": "u29.d04.reading.b2",
          "en": "In the end the vendor apologized for the delays and offered to lower the price. Dan agreed to give them one more month but refused to pay in advance. They suggested meeting again in two weeks, and everyone congratulated themselves on avoiding a lawsuit.",
          "ru": "В итоге подрядчик извинился за задержки и предложил снизить цену. Дэн согласился дать им ещё месяц, но отказался платить вперёд. Они предложили встретиться снова через две недели, и все поздравили себя с тем, что избежали суда.",
          "audio": {
            "src": "media/audio/u29.d04.reading.b2.mp3",
            "license": {
              "type": "original",
              "attribution": "Project authors (LLM-assisted)"
            }
          }
        }
      ],
      "glossary": [
        {
          "word": "deadline",
          "ru": "срок",
          "ipa": "/ˈdedlaɪn/"
        },
        {
          "word": "lawsuit",
          "ru": "судебный иск",
          "ipa": "/ˈlɔːsuːt/"
        }
      ]
    },
