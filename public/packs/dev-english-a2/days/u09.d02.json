    {
      "type": "grammar",
      "id": "u09.d02.grammar",
      "title": {
        "en": "Superlatives",
        "ru": "Превосходная степень"
      },
      "rule": {
        "en": "Say which is number one. Short adjectives: the + -est; long adjectives: the most … . Irregular: good → the best, bad → the worst.",
        "ru": "Скажи, кто самый-самый. Короткие: the + -est; длинные: the most … . Исключения: good → the best, bad → the worst."
      },
      "patterns": [
        {
          "label": {
            "en": "the + -est",
            "ru": "the + -est"
          },
          "formula": "the + adjective + -est",
          "examples": [
            {
              "en": "This is the cheapest shop.",
              "ru": "Это самый дешёвый магазин."
            }
          ],
          "ref": "comparatives"
        },
        {
          "label": {
            "en": "the most",
            "ru": "the most"
          },
          "formula": "the most + long adjective",
          "examples": [
            {
              "en": "It is the most popular brand.",
              "ru": "Это самый популярный бренд."
            }
          ],
          "ref": "comparatives"
        },
        {
          "label": {
            "en": "irregular",
            "ru": "исключения"
          },
          "formula": "the best · the worst",
          "examples": [
            {
              "en": "It is the best shop in town.",
              "ru": "Это лучший магазин в городе."
            }
          ],
          "ref": "comparatives"
        }
      ],
      "pitfalls": [
        {
          "en": "Always use \"the\" before a superlative: \"the biggest\", not \"biggest\".",
          "ru": "Перед превосходной всегда \"the\": \"the biggest\", а не \"biggest\"."
        },
        {
          "en": "Don't say \"the most cheapest\" — choose one form: \"the cheapest\".",
          "ru": "Не говори \"the most cheapest\" — выбери одну форму: \"the cheapest\"."
        }
      ]
    },
    {
      "type": "reading",
      "id": "u09.d02.reading",
      "title": {
        "en": "The best shop",
