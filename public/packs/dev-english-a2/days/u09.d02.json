      "blocks": [
        {
          "id": "u09.d02.reading.b1",
          "en": "City Style is the biggest clothes shop in town. It is also the most popular, because it has the best prices and good quality clothes.",
          "ru": "City Style — самый большой магазин одежды в городе. Ещё и самый популярный, потому что у него лучшие цены и качественная одежда.",
          "audio": {
            "src": "media/audio/u09.d02.reading.b1.mp3",
            "license": {
              "type": "original",
              "attribution": "Project authors (LLM-assisted)"
            }
          }
        },
        {
          "id": "u09.d02.reading.b2",
          "en": "On Saturday it is the busiest. That day they have the biggest sale, with the cheapest shoes and the most beautiful dresses. Customers love it.",
          "ru": "В субботу там больше всего людей. В этот день самая большая распродажа: самая дешёвая обувь и самые красивые платья. Покупатели в восторге.",
          "audio": {
            "src": "media/audio/u09.d02.reading.b2.mp3",
            "license": {
              "type": "original",
              "attribution": "Project authors (LLM-assisted)"
            }
          }
        }
      ],
