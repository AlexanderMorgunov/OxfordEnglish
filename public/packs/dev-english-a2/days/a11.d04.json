    {
      "type": "grammar",
      "id": "a11.d04.grammar",
      "title": {
        "en": "this / that / these / those",
        "ru": "this / that / these / those"
      },
      "ref": "demonstratives",
      "rule": {
        "en": "Use this / these for things NEAR you, and that / those for things FAR from you. Use this / that for ONE thing (this is…), and these / those for MORE than one (these are…).",
        "ru": "this / these — для того, что БЛИЗКО; that / those — для того, что ДАЛЕКО. this / that — для ОДНОГО (this is…); these / those — для НЕСКОЛЬКИХ (these are…)."
      },
      "patterns": [
        {
          "label": {
            "en": "one thing: this / that",
            "ru": "один предмет: this / that"
          },
          "formula": "this/that + is + …",
          "examples": [
            {
              "en": "This is my car.",
              "ru": "Это моя машина."
            },
            {
              "en": "That is a small cat.",
              "ru": "То маленький кот."
            }
          ]
        },
        {
          "label": {
            "en": "many things: these / those",
            "ru": "несколько: these / those"
          },
          "formula": "these/those + are + …",
          "examples": [
            {
              "en": "These are red pens.",
              "ru": "Это красные ручки."
            },
            {
              "en": "Those dogs are big.",
              "ru": "Те собаки большие."
            }
          ]
        }
      ],
      "pitfalls": [
        {
          "en": "these / those go with plural + are: \"these are\", not \"this are\".",
          "ru": "these / those — с множественным и are: «these are», а не «this are»."
        },
        {
          "en": "this / that go with one thing + is.",
          "ru": "this / that — с одним предметом и is."
        }
      ]
    },
