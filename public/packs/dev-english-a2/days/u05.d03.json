    {
      "type": "grammar",
      "id": "u05.d03.grammar",
      "title": {
        "en": "Past simple vs past continuous",
        "ru": "Past simple и past continuous"
      },
      "rule": {
        "en": "A longer background action uses the past continuous (while ... -ing). A short action that interrupts it uses the past simple (when ...).",
        "ru": "Длинное фоновое действие — past continuous (while ... -ing). Короткое действие, которое его прерывает, — past simple (when ...)."
      },
      "patterns": [
        {
          "label": {
            "en": "while + -ing",
            "ru": "while + -ing"
          },
          "formula": "While + past continuous",
          "examples": [
            {
              "en": "While I was cooking, the phone rang.",
              "ru": "Пока я готовил, зазвонил телефон."
            }
          ],
          "ref": "past-continuous"
        },
        {
          "label": {
            "en": "when + past simple",
            "ru": "when + past simple"
          },
          "formula": "when + past simple (short action)",
          "examples": [
            {
              "en": "I was walking when I fell.",
              "ru": "Я шёл, когда упал."
            }
          ],
          "ref": "past-continuous"
        }
      ],
      "pitfalls": [
        {
          "en": "The long action = continuous, the short/interrupting one = simple.",
          "ru": "Длинное действие — continuous, короткое/прерывающее — simple."
        },
        {
          "en": "Use \"while\" with the -ing action and \"when\" with the short action.",
          "ru": "\"while\" — с действием на -ing, \"when\" — с коротким действием."
        }
      ]
    },
    {
      "type": "reading",
      "id": "u05.d03.reading",
      "title": {
        "en": "A little accident",
        "ru": "Небольшое происшествие"
      },
      "blocks": [
        {
          "id": "u05.d03.reading.b1",
          "en": "Yesterday morning it was raining. While Tom was running to the bus, he slipped and fell. He dropped his bag and his coffee.",
          "ru": "Вчера утром шёл дождь. Пока Том бежал к автобусу, он поскользнулся и упал. Он уронил сумку и кофе.",
          "audio": {
            "src": "media/audio/u05.d03.reading.b1.wav",
            "license": {
              "type": "original",
              "attribution": "Project authors (LLM-assisted)"
            }
          }
        },
        {
          "id": "u05.d03.reading.b2",
          "en": "Luckily, he didn't hurt himself. A woman was passing and helped him. \"Are you okay?\" she asked. Tom smiled and said, \"Yes, thank you!\"",
          "ru": "К счастью, он не ушибся. Мимо проходила женщина и помогла ему. «Вы в порядке?» — спросила она. Том улыбнулся и сказал: «Да, спасибо!»",
          "audio": {
            "src": "media/audio/u05.d03.reading.b2.wav",
            "license": {
              "type": "original",
              "attribution": "Project authors (LLM-assisted)"
            }
          }
        }
      ],
      "glossary": [
