    {
      "type": "grammar",
      "id": "u18.d03.grammar",
      "title": {
        "en": "Reported commands & requests",
        "ru": "Косвенные приказы и просьбы"
      },
      "rule": {
        "en": "To report an order or request, use \"tell/ask + person + to + verb\". For a negative command, use \"not to + verb\". No backshift is needed — the infinitive does the work.",
        "ru": "Чтобы передать приказ или просьбу: «tell/ask + человек + to + глагол». Для отрицания — «not to + глагол». Сдвиг времени не нужен — работает инфинитив."
      },
      "patterns": [
        {
          "label": {
            "en": "tell someone to …",
            "ru": "tell someone to …"
          },
          "formula": "told + person + to + verb",
          "examples": [
            {
              "en": "\"Wait here.\" → She told me to wait there.",
              "ru": "«Подожди здесь.» → Она велела мне подождать там."
            }
          ],
          "ref": "reported-speech"
        },
        {
          "label": {
            "en": "ask someone to …",
            "ru": "ask someone to …"
          },
          "formula": "asked + person + to + verb",
          "examples": [
            {
              "en": "\"Please help.\" → He asked me to help.",
              "ru": "«Помоги, пожалуйста.» → Он попросил меня помочь."
            }
          ],
          "ref": "reported-speech"
        },
        {
          "label": {
            "en": "negative: not to …",
            "ru": "отрицание: not to …"
          },
          "formula": "told/asked + person + not to + verb",
          "examples": [
            {
              "en": "\"Don't be late.\" → She told us not to be late.",
              "ru": "«Не опаздывайте.» → Она велела нам не опаздывать."
            }
          ],
          "ref": "reported-speech"
        }
      ],
      "pitfalls": [
        {
          "en": "Use \"to + verb\", not \"that\": \"told me to wait\", not \"told me that wait\".",
          "ru": "Используй «to + глагол», не «that»: «told me to wait», а не «told me that wait»."
        },
        {
          "en": "Negative goes before \"to\": \"not to be late\", not \"to not be late\".",
          "ru": "Отрицание перед «to»: «not to be late», а не «to not be late»."
        }
      ]
    },
    {
      "type": "reading",
      "id": "u18.d03.reading",
      "title": {
        "en": "The safety briefing",
        "ru": "Инструктаж по безопасности"
      },
      "blocks": [
        {
          "id": "u18.d03.reading.b1",
          "en": "Before the trip, the guide gave us some instructions. She told us to stay together and asked us not to touch the animals. She also warned us not to leave the path.",
          "ru": "Перед поездкой гид дала нам указания. Она велела нам держаться вместе и попросила не трогать животных. Ещё она предупредила нас не сходить с тропы.",
          "audio": {
            "src": "media/audio/u18.d03.reading.b1.mp3",
            "license": {
              "type": "original",
              "attribution": "Project authors (LLM-assisted)"
            }
          }
        },
        {
          "id": "u18.d03.reading.b2",
          "en": "She reminded everyone to bring water and advised us to wear strong shoes. One man refused to follow the rules, so she told him to wait in the bus. In the end, everyone else had a wonderful day.",
          "ru": "Она напомнила всем взять воду и посоветовала надеть крепкую обувь. Один мужчина отказался соблюдать правила, поэтому она велела ему ждать в автобусе. В итоге все остальные прекрасно провели день.",
          "audio": {
            "src": "media/audio/u18.d03.reading.b2.mp3",
            "license": {
              "type": "original",
              "attribution": "Project authors (LLM-assisted)"
            }
          }
        }
      ],
      "glossary": [
