    {
      "type": "grammar",
      "id": "u28.d02.grammar",
      "title": {
        "en": "The passive (all tenses)",
        "ru": "Пассив (все времена)"
      },
      "rule": {
        "en": "The passive = be + past participle. Use it when the action matters more than who did it. The tense lives in \"be\": is made / was made / has been made / will be made / can be made. Add \"by …\" only if the agent matters.",
        "ru": "Пассив = be + причастие. Используем, когда действие важнее исполнителя. Время — в «be»: is made / was made / has been made / will be made / can be made. «by …» — только если важен исполнитель."
      },
      "patterns": [
        {
          "label": {
            "en": "present / past",
            "ru": "наст. / прош."
          },
          "formula": "is / was + V3",
          "examples": [
            {
              "en": "It is made in Italy. It was built in 1990.",
              "ru": "Это делают в Италии. Это построили в 1990."
            }
          ],
          "ref": "passive"
        },
        {
          "label": {
            "en": "perfect / future",
            "ru": "перфект / будущее"
          },
          "formula": "has been / will be + V3",
          "examples": [
            {
              "en": "It has been sold. It will be delivered.",
              "ru": "Это продано. Это доставят."
            }
          ],
          "ref": "passive"
        },
        {
          "label": {
            "en": "modal",
            "ru": "модальный"
          },
          "formula": "can / should be + V3",
          "examples": [
            {
              "en": "It can be recycled.",
              "ru": "Это можно переработать."
            }
          ],
          "ref": "passive"
        }
      ],
      "pitfalls": [
        {
          "en": "Put the tense on \"be\": \"was built\" (not \"was build\"), \"has been made\" (not \"has made\").",
          "ru": "Время — на «be»: «was built» (не «was build»), «has been made» (не «has made»)."
        },
        {
          "en": "Only transitive verbs go passive: \"It was arrived\" is wrong.",
          "ru": "Пассив — только у переходных глаголов: «It was arrived» — ошибка."
        }
      ]
    },
    {
      "type": "reading",
      "id": "u28.d02.reading",
      "title": {
        "en": "From bean to cup",
        "ru": "От зерна до чашки"
      },
      "blocks": [
        {
          "id": "u28.d02.reading.b1",
          "en": "Coffee is grown in warm regions and then shipped around the world. The beans are picked by hand, dried in the sun, and sorted by size. After that, they are roasted, packed, and sent to shops. Nothing is wasted along the way.",
          "ru": "Кофе выращивают в тёплых регионах, а затем развозят по миру. Зёрна собирают вручную, сушат на солнце и сортируют по размеру. После этого их обжаривают, упаковывают и отправляют в магазины. По пути ничего не пропадает.",
          "audio": {
            "src": "media/audio/u28.d02.reading.b1.mp3",
            "license": {
              "type": "original",
              "attribution": "Project authors (LLM-assisted)"
            }
          }
        },
        {
          "id": "u28.d02.reading.b2",
          "en": "This particular blend was created ten years ago and has been sold in forty countries since. Next year a new decaf version will be launched. Every batch is tested before it can be shipped, so quality is guaranteed.",
          "ru": "Эту смесь создали десять лет назад, и с тех пор её продают в сорока странах. В следующем году запустят новую версию без кофеина. Каждую партию тестируют, прежде чем её можно отправить, так что качество гарантировано.",
          "audio": {
            "src": "media/audio/u28.d02.reading.b2.mp3",
            "license": {
              "type": "original",
              "attribution": "Project authors (LLM-assisted)"
            }
          }
        }
      ],
      "glossary": [
        {
          "word": "roast",
          "ru": "обжаривать",
          "ipa": "/rəʊst/"
        },
        {
          "word": "batch",
          "ru": "партия",
          "ipa": "/bætʃ/"
        }
      ]
    },
