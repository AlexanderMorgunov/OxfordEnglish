    {
      "type": "grammar",
      "id": "u08.d05.grammar",
      "title": {
        "en": "Asking the way & buying a ticket",
        "ru": "Спросить дорогу и купить билет"
      },
      "rule": {
        "en": "Ask the way with \"Excuse me, how do I get to …?\" or \"Is there a … near here?\". Buy a ticket with \"A single/return to …, please.\".",
        "ru": "Спрашивай дорогу: \"Excuse me, how do I get to …?\" или \"Is there a … near here?\". Покупай билет: \"A single/return to …, please.\"."
      },
      "patterns": [
        {
          "label": {
            "en": "ask the way",
            "ru": "спросить путь"
          },
          "formula": "Excuse me, how do I get to …?",
          "examples": [
            {
              "en": "Excuse me, how do I get to the station?",
              "ru": "Извините, как добраться до вокзала?"
            }
          ]
        },
        {
          "label": {
            "en": "is there …?",
            "ru": "is there …?"
          },
          "formula": "Is there a … near here?",
          "examples": [
            {
              "en": "Is there a bank near here?",
              "ru": "Есть ли банк поблизости?"
            }
          ]
        },
        {
          "label": {
            "en": "buy a ticket",
            "ru": "купить билет"
          },
          "formula": "A single / return to …, please.",
          "examples": [
            {
              "en": "A return to the centre, please.",
              "ru": "Туда-обратно до центра, пожалуйста."
            }
          ]
        }
      ],
      "pitfalls": [
        {
          "en": "Start politely with \"Excuse me\" before asking a stranger.",
          "ru": "Начинай вежливо с \"Excuse me\", прежде чем спросить незнакомца."
        },
        {
          "en": "\"single\" = one way, \"return\" = there and back.",
          "ru": "\"single\" = в одну сторону, \"return\" = туда и обратно."
        }
      ]
    },
    {
      "type": "reading",
      "id": "u08.d05.reading",
      "title": {
        "en": "Getting to the centre",
        "ru": "Как доехать до центра"
      },
      "blocks": [
        {
          "id": "u08.d05.reading.b1",
          "en": "\"Excuse me, how do I get to the city centre?\" \"Take the underground. There is a station over there. A single ticket is two pounds.\"",
          "ru": "«Извините, как добраться до центра?» «Езжайте на метро. Станция вон там. Билет в одну сторону стоит два фунта».",
          "audio": {
            "src": "media/audio/u08.d05.reading.b1.wav",
            "license": {
              "type": "original",
              "attribution": "Project authors (LLM-assisted)"
            }
          }
        },
        {
          "id": "u08.d05.reading.b2",
          "en": "\"Do I change trains?\" \"Yes, change at the next station. The centre is only four stops away.\" \"Thank you very much!\" \"You're welcome.\"",
          "ru": "«Мне нужна пересадка?» «Да, пересядьте на следующей станции. Центр всего в четырёх остановках». «Большое спасибо!» «Пожалуйста».",
          "audio": {
            "src": "media/audio/u08.d05.reading.b2.wav",
            "license": {
              "type": "original",
              "attribution": "Project authors (LLM-assisted)"
            }
          }
        }
      ],
      "glossary": [
