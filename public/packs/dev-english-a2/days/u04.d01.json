    {
      "type": "grammar",
      "id": "u04.d01.grammar",
      "title": {
        "en": "How it works",
        "ru": "Как это работает"
      },
      "rule": {
        "en": "Use the Past Simple for finished actions with a known time — what you shipped, fixed, or broke yesterday.",
        "ru": "Past Simple — для завершённых действий с известным временем: что ты задеплоил, починил или сломал вчера."
      },
      "patterns": [
        {
          "label": {
            "en": "Regular verbs — add -ed",
            "ru": "Правильные глаголы — добавляем -ed"
          },
          "formula": "verb + ed",
          "examples": [
            {
              "en": "Yesterday I deployed the new build.",
              "ru": "Вчера я задеплоил новый билд."
            },
            {
              "en": "We merged the feature branch this morning.",
              "ru": "Мы влили ветку с фичей сегодня утром."
            }
          ]
        },
        {
          "label": {
            "en": "Irregular verbs — memorize them",
            "ru": "Неправильные глаголы — их нужно запомнить"
          },
          "formula": "write → wrote · build → built · break → broke",
          "examples": [
            {
              "en": "She wrote the tests and the pipeline ran green.",
              "ru": "Она написала тесты, и пайплайн прошёл."
            }
          ]
        },
        {
          "label": {
            "en": "Negative — didn't + base form",
            "ru": "Отрицание — didn't + начальная форма"
          },
          "formula": "didn't + base",
          "examples": [
            {
              "en": "The build didn't pass, so I didn't push to main.",
              "ru": "Билд не прошёл, поэтому я не запушил в main."
            }
          ]
        },
        {
          "label": {
            "en": "Question — Did + subject + base form",
            "ru": "Вопрос — Did + подлежащее + начальная форма"
          },
          "formula": "Did + subject + base ?",
          "examples": [
            {
              "en": "Did you review my pull request?",
              "ru": "Ты посмотрел мой пул-реквест?"
            }
          ]
        }
      ],
      "pitfalls": [
        {
          "en": "After 'didn't' use the base form, not the past form: 'didn't pass', not 'didn't passed'.",
          "ru": "После 'didn't' — начальная форма, а не прошедшая: 'didn't pass', а не 'didn't passed'."
        },
        {
          "en": "In questions the past is carried by 'did', so the main verb stays base: 'Did you merge?', not 'Did you merged?'.",
          "ru": "В вопросе прошедшее время несёт 'did', основной глагол — в начальной форме: 'Did you merge?', а не 'Did you merged?'."
        }
      ],
      "ref": "past-simple"
    },
