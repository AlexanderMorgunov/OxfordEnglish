    {
      "type": "grammar",
      "id": "u06.d03.grammar",
      "title": {
        "en": "this / that / these / those",
        "ru": "this / that / these / those"
      },
      "rule": {
        "en": "Point to things with demonstratives: this/these for near, that/those for far; this/that for one, these/those for many.",
        "ru": "Указывай на предметы: this/these — близко, that/those — далеко; this/that — один, these/those — много."
      },
      "patterns": [
        {
          "label": {
            "en": "near",
            "ru": "близко"
          },
          "formula": "this (one) · these (many)",
          "examples": [
            {
              "en": "This is my key. These are my books.",
              "ru": "Это мой ключ. Это мои книги."
            }
          ],
          "ref": "demonstratives"
        },
        {
          "label": {
            "en": "far",
            "ru": "далеко"
          },
          "formula": "that (one) · those (many)",
          "examples": [
            {
              "en": "That is your bag. Those are your shoes.",
              "ru": "То — твоя сумка. То — твои туфли."
            }
          ],
          "ref": "demonstratives"
        },
        {
          "label": {
            "en": "question",
            "ru": "вопрос"
          },
          "formula": "What is this / that? What are these / those?",
          "examples": [
            {
              "en": "What is this? What are those?",
              "ru": "Что это? Что то?"
            }
          ],
          "ref": "demonstratives"
        }
      ],
      "pitfalls": [
        {
          "en": "these/those are plural: \"these books\", not \"this books\".",
          "ru": "these/those — множественное: \"these books\", а не \"this books\"."
        },
        {
          "en": "this/these = here (near), that/those = there (far).",
          "ru": "this/these = здесь (близко), that/those = там (далеко)."
        }
      ]
    },
    {
      "type": "reading",
      "id": "u06.d03.reading",
      "title": {
        "en": "A tour of the house",
        "ru": "Экскурсия по дому"
      },
      "blocks": [
        {
          "id": "u06.d03.reading.b1",
          "en": "\"Come in! This is the living room. This sofa is new, and these cushions are very soft. That clock on the wall is old — it was my grandmother's.\"",
          "ru": "«Заходи! Это гостиная. Этот диван новый, а эти подушки очень мягкие. Те часы на стене старые — они были бабушкиными».",
          "audio": {
            "src": "media/audio/u06.d03.reading.b1.mp3",
            "license": {
              "type": "original",
              "attribution": "Project authors (LLM-assisted)"
            }
          }
        },
        {
          "id": "u06.d03.reading.b2",
          "en": "\"Those windows look at the garden. And this door goes to the kitchen. Do you like it?\" \"Yes, this house is beautiful!\"",
          "ru": "«Те окна выходят в сад. А эта дверь ведёт на кухню. Тебе нравится?» «Да, этот дом прекрасен!»",
          "audio": {
            "src": "media/audio/u06.d03.reading.b2.mp3",
            "license": {
              "type": "original",
              "attribution": "Project authors (LLM-assisted)"
            }
          }
        }
      ],
      "glossary": [
