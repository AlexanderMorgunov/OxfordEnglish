    {
      "type": "grammar",
      "id": "u17.d03.grammar",
      "title": {
        "en": "Continuous vs. simple",
        "ru": "Длительная и простая форма"
      },
      "rule": {
        "en": "Use the present perfect CONTINUOUS to focus on the activity or how long it has gone on. Use the present perfect SIMPLE to focus on the finished result or how many.",
        "ru": "Present perfect CONTINUOUS — акцент на процессе или длительности. Present perfect SIMPLE — акцент на завершённом результате или количестве."
      },
      "patterns": [
        {
          "label": {
            "en": "continuous → activity",
            "ru": "длительная → процесс"
          },
          "formula": "have been + -ing",
          "examples": [
            {
              "en": "I've been reading all afternoon.",
              "ru": "Я читаю весь день."
            }
          ],
          "ref": "present-perfect-continuous"
        },
        {
          "label": {
            "en": "simple → result",
            "ru": "простая → результат"
          },
          "formula": "have + past participle",
          "examples": [
            {
              "en": "I've read three books this month.",
              "ru": "Я прочитал три книги за месяц."
            }
          ],
          "ref": "present-perfect"
        },
        {
          "label": {
            "en": "how long vs how many",
            "ru": "как долго и сколько"
          },
          "formula": "been -ing (how long) · V3 (how many)",
          "examples": [
            {
              "en": "She's been writing for an hour and has written two pages.",
              "ru": "Она пишет уже час и написала две страницы."
            }
          ],
          "ref": "perfect-vs-past"
        }
      ],
      "pitfalls": [
        {
          "en": "Finished result / a number → simple: \"I have written three emails\".",
          "ru": "Завершённый результат / число → простая: «I have written three emails»."
        },
        {
          "en": "Ongoing activity / how long → continuous: \"I have been writing emails all day\".",
          "ru": "Продолжающийся процесс / как долго → длительная: «I have been writing emails all day»."
        }
      ]
    },
    {
      "type": "reading",
      "id": "u17.d03.reading",
      "title": {
        "en": "Painting the flat",
        "ru": "Красим квартиру"
      },
      "blocks": [
        {
          "id": "u17.d03.reading.b1",
          "en": "Nina and Sam have been painting their flat all weekend. They have already finished the kitchen and one bedroom. \"We've been working since Saturday morning,\" says Nina, \"and we've painted four rooms so far.\"",
          "ru": "Нина и Сэм красят квартиру все выходные. Они уже закончили кухню и одну спальню. «Мы работаем с утра субботы, — говорит Нина, — и пока покрасили четыре комнаты».",
          "audio": {
            "src": "media/audio/u17.d03.reading.b1.wav",
            "license": {
              "type": "original",
              "attribution": "Project authors (LLM-assisted)"
            }
          }
        },
        {
          "id": "u17.d03.reading.b2",
          "en": "There is paint on their hands and in their hair. They are tired because they have been standing on ladders for hours. But the flat looks great, and they have almost completed the job.",
          "ru": "У них краска на руках и в волосах. Они устали, потому что часами стоят на стремянках. Но квартира выглядит отлично, и работа почти завершена.",
          "audio": {
            "src": "media/audio/u17.d03.reading.b2.wav",
            "license": {
              "type": "original",
              "attribution": "Project authors (LLM-assisted)"
            }
          }
        }
      ],
      "glossary": [
