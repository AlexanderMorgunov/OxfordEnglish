    {
      "type": "grammar",
      "id": "u08.d04.grammar",
      "title": {
        "en": "both / all · another / other · the + places",
        "ru": "both / all · another / other · the + места"
      },
      "rule": {
        "en": "Use \"both\" for two and \"all\" for three or more. \"Another\" = one more (singular); \"other/others\" = different or plural. Use \"the\" with many public places: the bank, the station.",
        "ru": "\"both\" — о двух, \"all\" — о трёх и более. \"Another\" = ещё один (ед. ч.); \"other/others\" = другой или мн. ч. С многими общественными местами — \"the\": the bank, the station."
      },
      "patterns": [
        {
          "label": {
            "en": "both / all",
            "ru": "both / all"
          },
          "formula": "both (of the two) · all (of them)",
          "examples": [
            {
              "en": "Both shops are open. All the shops are closed on Sunday.",
              "ru": "Оба магазина открыты. Все магазины закрыты в воскресенье."
            }
          ]
        },
        {
          "label": {
            "en": "another / other",
            "ru": "another / other"
          },
          "formula": "another + singular · other + plural",
          "examples": [
            {
              "en": "I want another coffee. The other shops are far.",
              "ru": "Я хочу ещё кофе. Другие магазины далеко."
            }
          ]
        },
        {
          "label": {
            "en": "the + places",
            "ru": "the + места"
          },
          "formula": "go to the bank / the station / the market",
          "examples": [
            {
              "en": "First go to the bank, then to the post office.",
              "ru": "Сначала в банк, потом на почту."
            }
          ],
          "ref": "articles"
        }
      ],
      "pitfalls": [
        {
          "en": "\"another\" is one word (an + other) and takes a singular noun: \"another shop\".",
          "ru": "\"another\" — одно слово (an + other), с существительным в ед. ч.: \"another shop\"."
        },
        {
          "en": "\"both\" for exactly two; \"all\" for three or more.",
          "ru": "\"both\" — ровно два; \"all\" — три и более."
        }
      ]
    },
    {
      "type": "reading",
      "id": "u08.d04.reading",
      "title": {
        "en": "Shopping in the centre",
        "ru": "Покупки в центре"
      },
      "blocks": [
        {
          "id": "u08.d04.reading.b1",
          "en": "There are two supermarkets in the centre. Both are open on Saturday, but all the small shops close early. I usually go to the bank first.",
          "ru": "В центре два супермаркета. Оба открыты в субботу, но все маленькие магазины закрываются рано. Обычно я сначала иду в банк.",
          "audio": {
            "src": "media/audio/u08.d04.reading.b1.mp3",
            "license": {
              "type": "original",
              "attribution": "Project authors (LLM-assisted)"
            }
          }
        },
        {
          "id": "u08.d04.reading.b2",
          "en": "Yesterday one bakery was closed, so I went to another one across the road. The other shops — the bookshop and the pharmacy — were open.",
          "ru": "Вчера одна пекарня была закрыта, поэтому я пошёл в другую через дорогу. Остальные магазины — книжный и аптека — были открыты.",
          "audio": {
            "src": "media/audio/u08.d04.reading.b2.mp3",
            "license": {
              "type": "original",
              "attribution": "Project authors (LLM-assisted)"
            }
          }
        }
      ],
      "glossary": [
