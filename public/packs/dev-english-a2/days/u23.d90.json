    {
      "type": "grammar",
      "id": "u23.d90.grammar",
      "title": {
        "en": "used to · would · be/get used to",
        "ru": "used to · would · be/get used to"
      },
      "ref": "used-to",
      "rule": {
        "en": "Use 'used to + verb' for past states or habits that stopped. Use 'would + verb' for repeated past actions. Use 'be used to + verb-ing' for being accustomed now, and 'get used to + verb-ing' for becoming accustomed.",
        "ru": "Используйте «used to + глагол» для прошлых состояний или привычек, которые закончились. Используйте «would + глагол» для повторяющихся действий в прошлом. Используйте «be used to + глагол с -ing» для актуальной привычности, а «get used to + глагол с -ing» для процесса привыкания."
      },
      "patterns": [
        {
          "label": {
            "en": "used to + verb (past habit/state)",
            "ru": "used to + глагол (прошлая привычка/состояние)"
          },
          "formula": "subject + used to + base verb",
          "examples": [
            {
              "en": "We used to have one computer.",
              "ru": "Раньше у нас был один компьютер."
            },
            {
              "en": "There didn't use to be a plant.",
              "ru": "Раньше здесь не было растения."
            }
          ],
          "ref": "used-to"
        },
        {
          "label": {
            "en": "would + verb (repeated past action)",
            "ru": "would + глагол (повторяющееся действие в прошлом)"
          },
          "formula": "subject + would + base verb",
          "examples": [
            {
              "en": "Den would always make the coffee.",
              "ru": "Ден всегда готовил кофе."
            },
            {
              "en": "Valery would grumble every morning.",
              "ru": "Вэлери обычно ворчал каждое утро."
            }
          ],
          "ref": "used-to"
        },
        {
          "label": {
            "en": "be/get used to + verb-ing (accustomed)",
            "ru": "be/get used to + глагол с -ing (привыкший)"
          },
          "formula": "subject + be/get used to + verb-ing",
          "examples": [
            {
              "en": "I'm still getting used to the new coffee machine.",
              "ru": "Я всё ещё привыкаю к новой кофе-машине."
            },
            {
              "en": "We're all used to working together.",
              "ru": "Мы все привыкли работать вместе."
            }
          ],
          "ref": "be-used-to"
        }
      ],
      "pitfalls": [
        {
          "en": "After 'used to', use the base verb: 'We used to have', not 'We used to had'.",
          "ru": "После «used to» — начальная форма: «We used to have», а не «We used to had»."
        },
        {
          "en": "Use 'didn't use to', not 'didn't used to' for past negatives.",
          "ru": "Для отрицания в прошлом используйте «didn't use to», а не «didn't used to»."
        },
        {
          "en": "After 'be/get used to', use a verb with -ing: 'I am used to working', not 'I am used to work'.",
          "ru": "После «be/get used to» используйте глагол с -ing: «I am used to working», а не «I am used to work»."
        },
        {
          "en": "'Would' is for repeated actions, not states: 'We used to have a computer', not 'We would have a computer'.",
          "ru": "«Would» — для повторяющихся действий, а не состояний: «We used to have a computer», а не «We would have a computer»."
        }
      ]
    },
    {
      "type": "reading",
