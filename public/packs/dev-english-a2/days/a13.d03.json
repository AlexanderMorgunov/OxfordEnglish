    {
      "type": "grammar",
      "id": "a13.d03.grammar",
      "title": {
        "en": "like / love / hate and adverbs of frequency",
        "ru": "like / love / hate и наречия частотности"
      },
      "ref": "present-simple",
      "rule": {
        "en": "like, love and hate say how you feel about something: I like tea, she loves music (he/she/it → likes, loves). Adverbs of frequency (always, usually, often, sometimes, never) say HOW OFTEN. They go BEFORE the main verb (I always drink tea) but AFTER be (She is never late).",
        "ru": "like, love, hate говорят, как ты относишься: I like tea, she loves music (he/she/it → likes, loves). Наречия частотности (always, usually, often, sometimes, never) говорят, КАК ЧАСТО. Они стоят ПЕРЕД основным глаголом (I always drink tea), но ПОСЛЕ be (She is never late)."
      },
      "patterns": [
        {
          "label": {
            "en": "like / love / hate + noun",
            "ru": "like / love / hate + слово"
          },
          "formula": "subject + like/love/hate (+ -s) + noun",
          "examples": [
            {
              "en": "I like tea. She loves music.",
              "ru": "Мне нравится чай. Она обожает музыку."
            },
            {
              "en": "He hates coffee.",
              "ru": "Он ненавидит кофе."
            }
          ]
        },
        {
          "label": {
            "en": "frequency before the main verb",
            "ru": "частотность перед основным глаголом"
          },
          "formula": "subject + always/usually/… + verb",
          "examples": [
            {
              "en": "I always drink tea.",
              "ru": "Я всегда пью чай."
            },
            {
              "en": "He never plays football.",
              "ru": "Он никогда не играет в футбол."
            }
          ]
        },
        {
          "label": {
            "en": "frequency after be",
            "ru": "частотность после be"
          },
          "formula": "subject + be + always/never + …",
          "examples": [
            {
              "en": "She is usually late.",
              "ru": "Она обычно опаздывает."
            }
          ]
        }
      ],
      "pitfalls": [
        {
          "en": "Frequency goes before the main verb but after be.",
          "ru": "Частотность — перед основным глаголом, но после be."
        },
        {
          "en": "he/she/it → likes / loves / hates (with -s).",
          "ru": "he/she/it → likes / loves / hates (с -s)."
        }
      ]
    },
