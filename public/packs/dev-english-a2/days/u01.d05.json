      "blocks": [
        {
          "id": "u01.d05.reading.b1",
          "en": "Hello, everyone! My name is Priya and I am your new colleague. I am from India and I am an engineer.",
          "ru": "Всем привет! Меня зовут Прия, я ваш новый коллега. Я из Индии и я инженер.",
          "audio": {
            "src": "media/audio/u01.d05.reading.b1.mp3",
            "license": {
              "type": "original",
              "attribution": "Project authors (LLM-assisted)"
            }
          }
        },
        {
          "id": "u01.d05.reading.b2",
          "en": "I have got a husband and a young daughter. I am glad to meet you all, and I hope we work well together!",
          "ru": "У меня есть муж и маленькая дочь. Рада со всеми познакомиться и надеюсь, мы будем хорошо работать вместе!",
          "audio": {
            "src": "media/audio/u01.d05.reading.b2.mp3",
            "license": {
              "type": "original",
              "attribution": "Project authors (LLM-assisted)"
            }
