    {
      "type": "grammar",
      "id": "u01.d05.grammar",
      "title": {
        "en": "Review: be, have got, pronouns",
        "ru": "Повтор: be, have got, местоимения"
      },
      "rule": {
        "en": "Put it together to introduce yourself: \"I am… / I have got… / This is my…\". Ask back with \"And you?\".",
        "ru": "Соедини всё, чтобы представиться: \"I am… / I have got… / This is my…\". Верни вопрос: \"And you?\"."
      },
      "patterns": [
        {
          "label": {
            "en": "Introduce",
            "ru": "Представиться"
          },
          "formula": "I am … · I have got … · This is my …",
          "examples": [
            {
              "en": "I am Anna. I have got a brother. This is my friend Tom.",
              "ru": "Я Анна. У меня есть брат. Это мой друг Том."
            }
          ],
          "ref": "verb-be"
        }
      ],
      "pitfalls": [
        {
          "en": "Don't forget \"be\": \"I am a student\", \"I am from Russia\".",
          "ru": "Не забывай \"be\": \"I am a student\", \"I am from Russia\"."
        }
      ]
    },
    {
      "type": "reading",
      "id": "u01.d05.reading",
      "title": {
        "en": "A first day at work",
        "ru": "Первый день на работе"
