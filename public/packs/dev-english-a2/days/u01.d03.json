    {
      "type": "grammar",
      "id": "u01.d03.grammar",
      "title": {
        "en": "me/you/him/her & who questions",
        "ru": "me/you/him/her и вопросы who"
      },
      "rule": {
        "en": "Object pronouns (me, you, him, her, us, them) come after the verb. \"Who + verb?\" asks about the subject; \"Who + do/does + subject + verb?\" asks about the object.",
        "ru": "Объектные местоимения (me, you, him, her, us, them) стоят после глагола. \"Who + глагол?\" спрашивает о подлежащем; \"Who + do/does + подлежащее + глагол?\" — об объекте."
      },
      "patterns": [
        {
          "label": {
            "en": "Object pronoun",
            "ru": "Объектное местоимение"
          },
          "formula": "verb + me/him/her/them",
          "examples": [
            {
              "en": "I know him. Call me.",
              "ru": "Я его знаю. Позвони мне."
            }
          ],
          "ref": "pronouns"
        },
        {
          "label": {
            "en": "Subject vs object question",
            "ru": "Вопрос о подлежащем/объекте"
          },
          "formula": "Who knows Anna? / Who does Anna know?",
          "examples": [
            {
              "en": "Who called you?",
              "ru": "Кто тебе звонил?"
            }
          ],
          "ref": "pronouns"
        }
      ],
      "pitfalls": [
        {
          "en": "After a verb use the object form: \"know him\", not \"know he\".",
          "ru": "После глагола — объектная форма: \"know him\", а не \"know he\"."
        },
        {
          "en": "Subject questions need no \"do\": \"Who called?\", not \"Who did call?\".",
          "ru": "Вопрос о подлежащем без \"do\": \"Who called?\", а не \"Who did call?\"."
        }
      ]
    },
