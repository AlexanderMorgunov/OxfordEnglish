    {
      "type": "grammar",
      "id": "u07.d90.grammar",
      "title": {
        "en": "Quantifiers (much, many, a little, a lot of)",
        "ru": "Слова количества (much, many, a little, a lot of)"
      },
      "ref": "quantifiers",
      "rule": {
        "en": "Use much with uncountable nouns in questions and negatives. Use many with plural countable nouns. Use a little with uncountable nouns for a small amount. Use a lot of with both countable and uncountable nouns in affirmative sentences. Enough means as much as needed.",
        "ru": "Much используется с неисчисляемыми существительными в вопросах и отрицаниях. Many — с исчисляемыми во множественном числе. A little — с неисчисляемыми для небольшого количества. A lot of — с исчисляемыми и неисчисляемыми в утвердительных предложениях. Enough означает «достаточно»."
      },
      "patterns": [
        {
          "label": {
            "en": "much + uncountable (questions / negatives)",
            "ru": "much + неисчисляемое (вопросы / отрицания)"
          },
          "formula": "How much + uncountable noun? / not much + uncountable noun",
          "examples": [
            {
              "en": "There isn't much coffee powder left.",
              "ru": "Осталось немного кофейного порошка."
            }
          ],
          "ref": "quantifiers"
        },
        {
          "label": {
            "en": "many + plural countable",
            "ru": "many + исчисляемое во множественном числе"
          },
          "formula": "How many + plural noun? / not many + plural noun",
          "examples": [
            {
              "en": "How many cups do we have?",
              "ru": "Сколько у нас чашек?"
            }
          ],
          "ref": "quantifiers"
        },
        {
          "label": {
            "en": "a little + uncountable",
            "ru": "a little + неисчисляемое"
          },
          "formula": "a little + uncountable noun",
          "examples": [
            {
              "en": "Alex spills a little milk.",
              "ru": "Алекс проливает немного молока."
            }
          ],
          "ref": "quantifiers"
        },
        {
          "label": {
            "en": "a lot of + countable / uncountable",
            "ru": "a lot of + исчисляемое / неисчисляемое"
          },
          "formula": "a lot of + noun (plural countable / uncountable)",
          "examples": [
            {
              "en": "Den puts a lot of sugar in his cup.",
              "ru": "Ден кладёт много сахара в свою чашку."
            },
            {
              "en": "Kate orders a lot of coffee.",
              "ru": "Кейт заказывает много кофе."
            }
          ],
          "ref": "quantifiers"
        }
      ],
      "pitfalls": [
        {
          "en": "Don't use much in affirmative sentences: \"I have much coffee\" → use \"I have a lot of coffee\".",
          "ru": "Не используй much в утвердительных предложениях: «I have much coffee» → правильно «I have a lot of coffee»."
        },
        {
          "en": "Much is only for uncountable nouns; many is only for countable nouns. \"Many milk\" and \"much cups\" are wrong.",
          "ru": "Much — только с неисчисляемыми; many — только с исчисляемыми. «Many milk» и «much cups» — ошибка."
        }
      ]
    },
