    {
      "type": "grammar",
      "id": "u06.d05.grammar",
      "title": {
        "en": "Describing a place or a person",
        "ru": "Описываем место или человека"
      },
      "rule": {
        "en": "Describe a place with \"There is/are ...\", \"It has ...\", \"It is + adjective\". Describe a person with \"He/She is ...\", \"He/She has ...\", \"He/She looks ...\".",
        "ru": "Место: \"There is/are ...\", \"It has ...\", \"It is + прилагательное\". Человек: \"He/She is ...\", \"He/She has ...\", \"He/She looks ...\"."
      },
      "patterns": [
        {
          "label": {
            "en": "a place",
            "ru": "место"
          },
          "formula": "It is a + adj + noun · There is …",
          "examples": [
            {
              "en": "It is a small quiet flat. There is a nice view.",
              "ru": "Это маленькая тихая квартира. Отсюда красивый вид."
            }
          ]
        },
        {
          "label": {
            "en": "a person",
            "ru": "человек"
          },
          "formula": "He/She is … · has … · looks …",
          "examples": [
            {
              "en": "She is tall and has long hair. She looks friendly.",
              "ru": "Она высокая, с длинными волосами. Выглядит дружелюбной."
            }
          ]
        }
      ],
      "pitfalls": [
        {
          "en": "Use \"has\" for features: \"The room has two windows.\"",
          "ru": "Для деталей — \"has\": \"The room has two windows.\""
        },
        {
          "en": "\"looks\" + adjective (looks nice), \"looks like\" + noun (looks like a castle).",
          "ru": "\"looks\" + прилагательное (looks nice), \"looks like\" + существительное (looks like a castle)."
        }
      ]
    },
    {
      "type": "reading",
      "id": "u06.d05.reading",
      "title": {
        "en": "My favourite place",
        "ru": "Моё любимое место"
      },
      "blocks": [
        {
          "id": "u06.d05.reading.b1",
          "en": "My favourite place is my grandmother's house. It is an old but comfortable house near a small lake. It has a big garden and a quiet street.",
          "ru": "Моё любимое место — дом бабушки. Это старый, но уютный дом у небольшого озера. У него большой сад и тихая улица.",
          "audio": {
            "src": "media/audio/u06.d05.reading.b1.mp3",
            "license": {
              "type": "original",
              "attribution": "Project authors (LLM-assisted)"
            }
          }
        },
        {
          "id": "u06.d05.reading.b2",
          "en": "My grandmother is short and has grey hair and kind eyes. She always looks happy. When I am there, everything is calm and I feel at home.",
          "ru": "Бабушка невысокая, с седыми волосами и добрыми глазами. Она всегда выглядит счастливой. Когда я там, всё спокойно, и я чувствую себя как дома.",
          "audio": {
            "src": "media/audio/u06.d05.reading.b2.mp3",
            "license": {
              "type": "original",
              "attribution": "Project authors (LLM-assisted)"
            }
          }
        }
      ],
