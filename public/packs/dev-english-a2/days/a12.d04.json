    {
      "type": "grammar",
      "id": "a12.d04.grammar",
      "title": {
        "en": "Prepositions of place",
        "ru": "Предлоги места"
      },
      "ref": "prepositions-place",
      "rule": {
        "en": "Prepositions say WHERE something is: in (inside), on (a surface), under (below), next to (beside), behind (at the back), in front of (before). Use them after be: The cat is under the table.",
        "ru": "Предлоги говорят, ГДЕ что-то находится: in (внутри), on (на поверхности), under (под), next to (рядом), behind (позади), in front of (перед). Ставим их после be: The cat is under the table."
      },
      "patterns": [
        {
          "label": {
            "en": "be + preposition + the + place",
            "ru": "be + предлог + the + место"
          },
          "formula": "thing + is/are + preposition + the + noun",
          "examples": [
            {
              "en": "The cup is on the table.",
              "ru": "Чашка на столе."
            },
            {
              "en": "The keys are in the bag.",
              "ru": "Ключи в сумке."
            }
          ]
        },
        {
          "label": {
            "en": "in / on / under",
            "ru": "in / on / under"
          },
          "formula": "in = inside · on = surface · under = below",
          "examples": [
            {
              "en": "The cat is under the bed.",
              "ru": "Кот под кроватью."
            },
            {
              "en": "The clock is on the wall.",
              "ru": "Часы на стене."
            }
          ]
        },
        {
          "label": {
            "en": "next to / behind / in front of",
            "ru": "next to / behind / in front of"
          },
          "formula": "beside · at the back · before",
          "examples": [
            {
              "en": "The lamp is next to the bed.",
              "ru": "Лампа рядом с кроватью."
            },
            {
              "en": "The car is in front of the house.",
              "ru": "Машина перед домом."
            }
          ]
        }
      ],
      "pitfalls": [
        {
          "en": "in = inside, on = on a surface: \"in the bag\" vs \"on the table\".",
          "ru": "in = внутри, on = на поверхности: «in the bag» и «on the table»."
        },
        {
          "en": "next to = beside (very near), not \"near to\".",
          "ru": "next to = рядом (совсем близко), не «near to»."
        }
      ]
    },
