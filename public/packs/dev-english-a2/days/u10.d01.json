    {
      "type": "grammar",
      "id": "u10.d01.grammar",
      "title": {
        "en": "be going to",
        "ru": "be going to"
      },
      "rule": {
        "en": "Talk about plans and intentions with \"be going to + verb\". Form: am/is/are + going to + verb.",
        "ru": "О планах и намерениях — \"be going to + глагол\". Форма: am/is/are + going to + глагол."
      },
      "patterns": [
        {
          "label": {
            "en": "positive",
            "ru": "утверждение"
          },
          "formula": "am/is/are + going to + verb",
          "examples": [
            {
              "en": "I am going to visit my family.",
              "ru": "Я собираюсь навестить семью."
            }
          ]
        },
        {
          "label": {
            "en": "negative",
            "ru": "отрицание"
          },
          "formula": "am/is/are not + going to + verb",
          "examples": [
            {
              "en": "We aren't going to travel this year.",
              "ru": "В этом году мы не собираемся путешествовать."
            }
          ]
        },
        {
          "label": {
            "en": "question",
            "ru": "вопрос"
          },
          "formula": "What are you going to do?",
          "examples": [
            {
              "en": "What are you going to do next week?",
              "ru": "Что ты собираешься делать на следующей неделе?"
            }
          ]
        }
      ],
      "pitfalls": [
        {
          "en": "Keep \"going to\" + base verb: \"going to go\", \"going to see\".",
          "ru": "Сохраняй \"going to\" + начальную форму: \"going to go\", \"going to see\"."
        },
        {
          "en": "Match be to the subject: I am, he/she is, we/you/they are.",
          "ru": "Согласуй be с подлежащим: I am, he/she is, we/you/they are."
        }
      ]
    },
    {
