    {
      "type": "grammar",
      "id": "u13.d05.grammar",
      "title": {
        "en": "Opinions · so/neither do I · question tags",
        "ru": "Мнения · so/neither do I · вопросы-концовки"
      },
      "rule": {
        "en": "Give an opinion with \"I think…\" / \"In my opinion…\". Agree with \"So do I\" (positive) and \"Neither do I\" (negative). Check with a question tag: \"…, isn't it?\".",
        "ru": "Мнение — \"I think…\" / \"In my opinion…\". Согласие — \"So do I\" (в плюс) и \"Neither do I\" (в минус). Уточнение — вопрос-концовка: \"…, isn't it?\"."
      },
      "patterns": [
        {
          "label": {
            "en": "opinion",
            "ru": "мнение"
          },
          "formula": "I think … / In my opinion …",
          "examples": [
            {
              "en": "I think English is useful.",
              "ru": "Думаю, английский полезен."
            }
          ]
        },
        {
          "label": {
            "en": "so / neither",
            "ru": "so / neither"
          },
          "formula": "So do I. · Neither do I.",
          "examples": [
            {
              "en": "I like tea. — So do I. I don't smoke. — Neither do I.",
              "ru": "Я люблю чай. — И я. Я не курю. — И я нет."
            }
          ],
          "ref": "so-neither-tags"
        },
        {
          "label": {
            "en": "question tag",
            "ru": "вопрос-концовка"
          },
          "formula": "positive sentence, negative tag?",
          "examples": [
            {
              "en": "It's cold today, isn't it?",
              "ru": "Сегодня холодно, не так ли?"
            }
          ],
          "ref": "so-neither-tags"
        }
      ],
      "pitfalls": [
        {
          "en": "Dependent prepositions are fixed: interested IN, good AT, afraid OF.",
          "ru": "Предлоги при словах фиксированы: interested IN, good AT, afraid OF."
        },
        {
          "en": "Positive sentence → negative tag: \"You like it, don't you?\"",
          "ru": "Утверждение → отрицательная концовка: \"You like it, don't you?\""
        }
      ]
    },
    {
      "type": "reading",
      "id": "u13.d05.reading",
      "title": {
        "en": "A friendly argument",
        "ru": "Дружеский спор"
      },
      "blocks": [
        {
          "id": "u13.d05.reading.b1",
          "en": "\"I think winter is the best season,\" said Tom. \"Really? I don't agree,\" said Mia. \"In my opinion, summer is better.\" \"You love the sea, don't you?\" \"Yes, I do!\"",
          "ru": "«Думаю, зима — лучшее время года», — сказал Том. «Правда? Не согласна», — сказала Мия. «По-моему, лето лучше». «Ты ведь любишь море?» «Да!»",
          "audio": {
            "src": "media/audio/u13.d05.reading.b1.mp3",
            "license": {
              "type": "original",
              "attribution": "Project authors (LLM-assisted)"
            }
          }
        },
        {
          "id": "u13.d05.reading.b2",
          "en": "\"I'm interested in winter sports,\" said Tom. \"So am I, actually,\" said Mia. \"But I'm afraid of the cold.\" \"Neither of us likes storms, that's for sure!\" They both laughed.",
          "ru": "«Мне интересны зимние виды спорта», — сказал Том. «Мне вообще-то тоже», — сказала Мия. «Но я боюсь холода». «Грозы точно никто из нас не любит!» Оба засмеялись.",
          "audio": {
            "src": "media/audio/u13.d05.reading.b2.mp3",
            "license": {
              "type": "original",
              "attribution": "Project authors (LLM-assisted)"
            }
          }
        }
      ],
      "glossary": [
        {
          "word": "argument",
          "ru": "спор",
          "ipa": "/ˈɑːrɡjumənt/"
        },
        {
          "word": "actually",
          "ru": "на самом деле",
          "ipa": "/ˈæktʃuəli/"
        }
      ]
    },
