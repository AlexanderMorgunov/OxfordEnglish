    {
      "type": "grammar",
      "id": "u20.d02.grammar",
      "title": {
        "en": "Verb + to-infinitive",
        "ru": "Глагол + инфинитив с to"
      },
      "rule": {
        "en": "Many verbs are followed by \"to + verb\" (the to-infinitive). Common ones: want, decide, hope, need, promise, learn, plan, offer, refuse, manage, agree. This group is just as important as the -ing group.",
        "ru": "После многих глаголов идёт «to + глагол» (инфинитив с to). Частые: want, decide, hope, need, promise, learn, plan, offer, refuse, manage, agree. Эта группа так же важна, как группа с -ing."
      },
      "patterns": [
        {
          "label": {
            "en": "want / need + to",
            "ru": "want / need + to"
          },
          "formula": "want/need/hope + to + verb",
          "examples": [
            {
              "en": "I want to learn Spanish.",
              "ru": "Я хочу выучить испанский."
            }
          ],
          "ref": "gerund-infinitive"
        },
        {
          "label": {
            "en": "decide / plan + to",
            "ru": "decide / plan + to"
          },
          "formula": "decide/plan/agree + to + verb",
          "examples": [
            {
              "en": "We decided to move.",
              "ru": "Мы решили переехать."
            }
          ],
          "ref": "gerund-infinitive"
        },
        {
          "label": {
            "en": "promise / offer + to",
            "ru": "promise / offer + to"
          },
          "formula": "promise/offer/refuse + to + verb",
          "examples": [
            {
              "en": "She offered to drive.",
              "ru": "Она предложила сесть за руль."
            }
          ],
          "ref": "gerund-infinitive"
        }
      ],
      "pitfalls": [
        {
          "en": "These verbs need \"to + verb\", not -ing: \"I want to go\", not \"I want going\".",
          "ru": "Этим глаголам нужен «to + глагол», не -ing: «I want to go», а не «I want going»."
        },
        {
          "en": "Use the bare verb after \"to\": \"hope to see\", not \"hope to seeing\".",
          "ru": "После «to» — начальная форма: «hope to see», а не «hope to seeing»."
        }
      ]
    },
    {
      "type": "reading",
      "id": "u20.d02.reading",
      "title": {
        "en": "A new goal",
        "ru": "Новая цель"
      },
      "blocks": [
        {
          "id": "u20.d02.reading.b1",
          "en": "This year, Maya decided to learn to swim. She had always wanted to, but she was afraid of water. \"I promised myself to try,\" she said. She planned to take one lesson a week and hoped to swim a whole length by summer.",
          "ru": "В этом году Майя решила научиться плавать. Ей всегда этого хотелось, но она боялась воды. «Я пообещала себе попробовать», — сказала она. Она планировала брать по одному уроку в неделю и надеялась к лету проплыть целую дорожку.",
          "audio": {
            "src": "media/audio/u20.d02.reading.b1.mp3",
            "license": {
              "type": "original",
              "attribution": "Project authors (LLM-assisted)"
            }
          }
        },
        {
          "id": "u20.d02.reading.b2",
          "en": "At first she wanted to give up, but her teacher offered to help her more. After three months, she managed to swim across the pool. \"I couldn't afford to quit,\" she laughed. \"Now I can't wait to try the sea.\"",
          "ru": "Сначала она хотела бросить, но учитель предложил помогать ей больше. Через три месяца ей удалось переплыть бассейн. «Я не могла позволить себе сдаться», — засмеялась она. «Теперь мне не терпится попробовать море».",
          "audio": {
            "src": "media/audio/u20.d02.reading.b2.mp3",
            "license": {
              "type": "original",
              "attribution": "Project authors (LLM-assisted)"
            }
          }
        }
      ],
      "glossary": [
        {
          "word": "give up",
          "ru": "сдаваться",
          "ipa": "/ɡɪv ʌp/"
        },
        {
          "word": "length",
          "ru": "дорожка (в бассейне)",
          "ipa": "/leŋθ/"
        }
      ]
    },
