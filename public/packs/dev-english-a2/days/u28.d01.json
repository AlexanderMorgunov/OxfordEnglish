    {
      "type": "grammar",
      "id": "u28.d01.grammar",
      "title": {
        "en": "have / get something done",
        "ru": "have / get something done"
      },
      "rule": {
        "en": "Use \"have/get + object + past participle\" when someone ELSE does the job for you. \"I had my car repaired\" = a mechanic repaired it. \"get\" is a bit more informal.",
        "ru": "«have/get + объект + причастие», когда работу делает КТО-ТО ДРУГОЙ. «I had my car repaired» = машину починил механик. «get» — чуть неформальнее."
      },
      "patterns": [
        {
          "label": {
            "en": "arrange a service",
            "ru": "заказать услугу"
          },
          "formula": "have + object + V3",
          "examples": [
            {
              "en": "I had my hair cut.",
              "ru": "Мне подстригли волосы."
            }
          ],
          "ref": "causative"
        },
        {
          "label": {
            "en": "informal",
            "ru": "неформально"
          },
          "formula": "get + object + V3",
          "examples": [
            {
              "en": "I got my phone fixed.",
              "ru": "Мне починили телефон."
            }
          ],
          "ref": "causative"
        },
        {
          "label": {
            "en": "question",
            "ru": "вопрос"
          },
          "formula": "Where did you have/get … done?",
          "examples": [
            {
              "en": "Where did you get your hair cut?",
              "ru": "Где ты подстригся?"
            }
          ],
          "ref": "causative"
        }
      ],
      "pitfalls": [
        {
          "en": "Word order: have + OBJECT + past participle. \"I had my car repaired\", not \"I had repaired my car\".",
          "ru": "Порядок: have + ОБЪЕКТ + причастие. «I had my car repaired», не «I had repaired my car»."
        },
        {
          "en": "\"I cut my hair\" = you did it yourself; \"I had my hair cut\" = someone did it for you.",
          "ru": "«I cut my hair» = сам; «I had my hair cut» = тебе сделали."
        }
      ]
    },
    {
      "type": "reading",
      "id": "u28.d01.reading",
      "title": {
        "en": "Moving in",
        "ru": "Переезд"
      },
      "blocks": [
        {
          "id": "u28.d01.reading.b1",
          "en": "We just bought an old flat, so there’s a lot to arrange. This week we’re having the walls painted and getting new windows installed. We had the heating checked yesterday, and tomorrow we’re getting the locks changed.",
          "ru": "Мы только купили старую квартиру, так что дел много. На этой неделе нам красят стены и устанавливают новые окна. Вчера нам проверили отопление, а завтра поменяют замки.",
          "audio": {
            "src": "media/audio/u28.d01.reading.b1.mp3",
            "license": {
              "type": "original",
              "attribution": "Project authors (LLM-assisted)"
            }
          }
        },
        {
          "id": "u28.d01.reading.b2",
          "en": "I could do some of it myself, but I’d rather have professionals do it. We got a quote for the kitchen, and we’re having it fitted next month. It’s expensive, but at least it gets done properly.",
          "ru": "Часть я мог бы сделать сам, но лучше пусть делают специалисты. Мы взяли смету на кухню и в следующем месяце её установят. Дорого, зато сделано как надо.",
          "audio": {
            "src": "media/audio/u28.d01.reading.b2.mp3",
            "license": {
              "type": "original",
              "attribution": "Project authors (LLM-assisted)"
            }
          }
        }
      ],
      "glossary": [
        {
          "word": "fit",
          "ru": "устанавливать",
          "ipa": "/fɪt/"
        },
        {
          "word": "properly",
