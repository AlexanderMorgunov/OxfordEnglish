    {
      "type": "grammar",
      "id": "u01.d02.grammar",
      "title": {
        "en": "have got",
        "ru": "have got"
      },
      "rule": {
        "en": "Use \"have got\" for possession and description. \"I/you/we/they have got\", \"he/she/it has got\".",
        "ru": "\"have got\" — для обладания и описания. \"I/you/we/they have got\", \"he/she/it has got\"."
      },
      "patterns": [
        {
          "label": {
            "en": "Statement",
            "ru": "Утверждение"
          },
          "formula": "'ve got · 's got",
          "examples": [
            {
              "en": "She has got two children.",
              "ru": "У неё двое детей."
            }
          ]
        },
        {
          "label": {
            "en": "Question / negative",
            "ru": "Вопрос / отрицание"
          },
          "formula": "Have you got…? · haven't got",
          "examples": [
            {
              "en": "Have you got a phone? — No, I haven't got one.",
              "ru": "У тебя есть телефон? — Нет."
            }
          ]
        }
      ],
      "pitfalls": [
        {
          "en": "\"has got\" for he/she/it, \"have got\" for the rest.",
          "ru": "\"has got\" — для he/she/it, \"have got\" — для остальных."
        },
        {
          "en": "In questions/negatives use \"have/has\", not \"do\": \"Have you got…?\", not \"Do you have got…?\".",
          "ru": "В вопросах/отрицаниях — \"have/has\", не \"do\": \"Have you got…?\", а не \"Do you have got…?\"."
        }
      ]
    },
    {
