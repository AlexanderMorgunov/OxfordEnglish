    {
      "type": "grammar",
      "id": "u11.d02.grammar",
      "title": {
        "en": "have to / don't have to / had to",
        "ru": "have to / don't have to / had to"
      },
      "rule": {
        "en": "\"have to\" = it is necessary (a rule from outside). \"don't have to\" = it is not necessary. The past of both is \"had to / didn't have to\".",
        "ru": "\"have to\" = нужно (внешнее правило). \"don't have to\" = не обязательно. Прошедшее — \"had to / didn't have to\"."
      },
      "patterns": [
        {
          "label": {
            "en": "have to",
            "ru": "have to"
          },
          "formula": "have/has to + verb",
          "examples": [
            {
              "en": "She has to wear a uniform.",
              "ru": "Ей нужно носить форму."
            }
          ]
        },
        {
          "label": {
            "en": "don't have to",
            "ru": "don't have to"
          },
          "formula": "don't/doesn't have to + verb",
          "examples": [
            {
              "en": "We don't have to work on Sunday.",
              "ru": "В воскресенье нам не нужно работать."
            }
          ]
        },
        {
          "label": {
            "en": "had to (past)",
            "ru": "had to (прошлое)"
          },
          "formula": "had to + verb",
          "examples": [
            {
              "en": "Yesterday I had to stay late.",
              "ru": "Вчера мне пришлось остаться допоздна."
            }
          ]
        }
      ],
      "pitfalls": [
        {
          "en": "Use \"has to\" for he/she/it: \"he has to go\".",
          "ru": "Для he/she/it — \"has to\": \"he has to go\"."
        },
        {
          "en": "\"don't have to\" = not necessary (you can choose), not \"prohibited\".",
          "ru": "\"don't have to\" = не обязательно (можно выбрать), а не \"запрещено\"."
        }
      ]
    },
    {
      "type": "reading",
      "id": "u11.d02.reading",
      "title": {
        "en": "My first job",
        "ru": "Моя первая работа"
      },
      "blocks": [
        {
          "id": "u11.d02.reading.b1",
          "en": "At my first job I had to wear a uniform and I had to arrive at eight o'clock. I didn't have to work at weekends, but I often had to stay late.",
          "ru": "На первой работе мне нужно было носить форму и приходить к восьми. По выходным работать было не обязательно, но часто приходилось задерживаться.",
          "audio": {
            "src": "media/audio/u11.d02.reading.b1.wav",
            "license": {
              "type": "original",
              "attribution": "Project authors (LLM-assisted)"
            }
          }
        },
        {
          "id": "u11.d02.reading.b2",
          "en": "Now I work from home. I don't have to wear a uniform and I don't have to travel. But I still have to finish my tasks on time. Rules are rules.",
          "ru": "Сейчас я работаю из дома. Мне не нужно носить форму и не нужно ездить. Но задачи всё равно нужно сдавать вовремя. Правила есть правила.",
          "audio": {
            "src": "media/audio/u11.d02.reading.b2.wav",
            "license": {
              "type": "original",
              "attribution": "Project authors (LLM-assisted)"
            }
          }
        }
      ],
