    {
      "type": "grammar",
      "id": "u02.d04.grammar",
      "title": {
        "en": "a/the & there is/are",
        "ru": "a/the и there is/are"
      },
      "rule": {
        "en": "Use \"a/an\" for a new thing, \"the\" for a known one, no article for general plurals. \"There is\" for one, \"there are\" for many.",
        "ru": "\"a/an\" — для нового, \"the\" — для известного, без артикля для общих множественных. \"There is\" — для одного, \"there are\" — для многих."
      },
      "patterns": [
        {
          "label": {
            "en": "a → the",
            "ru": "a → the"
          },
          "formula": "There's a shop. The shop is open.",
          "examples": [
            {
              "en": "There's a park. The park is big.",
              "ru": "Есть парк. Парк большой."
            }
          ],
          "ref": "articles"
        },
        {
          "label": {
            "en": "there is / are",
            "ru": "there is / are"
          },
          "formula": "There is + one · There are + many",
          "examples": [
            {
              "en": "There are two shops on the street.",
              "ru": "На улице два магазина."
            }
          ],
          "ref": "there-is"
        }
      ],
      "pitfalls": [
        {
          "en": "Match the verb: \"there is one park\", \"there are two parks\".",
          "ru": "Согласуй глагол: \"there is one park\", \"there are two parks\"."
        },
        {
          "en": "Use \"some/any\" with plurals: \"there are some shops\", \"there aren't any parks\".",
          "ru": "С множественным — \"some/any\": \"there are some shops\", \"there aren't any parks\"."
        }
      ]
    },
    {
      "type": "reading",
      "id": "u02.d04.reading",
      "title": {
        "en": "My street",
        "ru": "Моя улица"
      },
      "blocks": [
        {
          "id": "u02.d04.reading.b1",
          "en": "I live in a small city. There is a shop on the corner and a park near my house.",
          "ru": "Я живу в маленьком городе. На углу есть магазин, а рядом с домом — парк.",
          "audio": {
            "src": "media/audio/u02.d04.reading.b1.mp3",
            "license": {
              "type": "original",
              "attribution": "Project authors (LLM-assisted)"
            }
          }
        },
        {
          "id": "u02.d04.reading.b2",
          "en": "There are two cafés on my street, but there aren't any big buildings. It is a quiet place with friendly people.",
          "ru": "На моей улице два кафе, но нет больших зданий. Это тихое место с дружелюбными людьми.",
          "audio": {
            "src": "media/audio/u02.d04.reading.b2.mp3",
