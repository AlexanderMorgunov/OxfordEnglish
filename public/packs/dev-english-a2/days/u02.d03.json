    {
      "type": "grammar",
      "id": "u02.d03.grammar",
      "title": {
        "en": "Adverbs of frequency & at/in/on",
        "ru": "Наречия частоты и at/in/on"
      },
      "rule": {
        "en": "Adverbs of frequency (always, usually, often, sometimes, never) go before the main verb, but after \"be\". Time: at + clock, in + parts of day/months, on + days.",
        "ru": "Наречия частоты (always, usually, often, sometimes, never) — перед основным глаголом, но после \"be\". Время: at + часы, in + части дня/месяцы, on + дни."
      },
      "patterns": [
        {
          "label": {
            "en": "Position",
            "ru": "Позиция"
          },
          "formula": "subject + adverb + verb",
          "examples": [
            {
              "en": "She often works late.",
              "ru": "Она часто работает допоздна."
            }
          ]
        },
        {
          "label": {
            "en": "at / in / on",
            "ru": "at / in / on"
          },
          "formula": "at 7 · in the morning · on Monday",
          "examples": [
            {
              "en": "On Monday, at nine, in the morning.",
              "ru": "В понедельник, в девять, утром."
            }
          ]
        }
      ],
      "pitfalls": [
        {
          "en": "Adverb goes after \"be\": \"She is always late\", not \"She always is late\".",
          "ru": "Наречие после \"be\": \"She is always late\", а не \"She always is late\"."
        },
        {
          "en": "\"at the weekend\", \"in the morning\", \"on Sunday\" — fixed prepositions.",
          "ru": "\"at the weekend\", \"in the morning\", \"on Sunday\" — фиксированные предлоги."
        }
      ]
    },
    {
