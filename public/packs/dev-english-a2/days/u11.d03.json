    {
      "type": "grammar",
      "id": "u11.d03.grammar",
      "title": {
        "en": "should / shouldn't",
        "ru": "should / shouldn't"
      },
      "rule": {
        "en": "Give advice with \"should + verb\" (a good idea) and \"shouldn't + verb\" (a bad idea).",
        "ru": "Совет — \"should + глагол\" (хорошая идея) и \"shouldn't + глагол\" (плохая идея)."
      },
      "patterns": [
        {
          "label": {
            "en": "should",
            "ru": "should"
          },
          "formula": "should + verb",
          "examples": [
            {
              "en": "You should drink more water.",
              "ru": "Тебе стоит пить больше воды."
            }
          ],
          "ref": "modals-obligation"
        },
        {
          "label": {
            "en": "shouldn't",
            "ru": "shouldn't"
          },
          "formula": "shouldn't + verb",
          "examples": [
            {
              "en": "You shouldn't eat so late.",
              "ru": "Тебе не стоит есть так поздно."
            }
          ],
          "ref": "modals-obligation"
        },
        {
          "label": {
            "en": "question",
            "ru": "вопрос"
          },
          "formula": "Should I …?",
          "examples": [
            {
              "en": "Should I see a doctor?",
              "ru": "Мне стоит сходить к врачу?"
            }
          ],
          "ref": "modals-obligation"
        }
      ],
      "pitfalls": [
        {
          "en": "Base verb after should: \"should go\", not \"should to go\".",
          "ru": "После should — начальная форма: \"should go\", а не \"should to go\"."
        },
        {
          "en": "Same form for all persons: he should, they should.",
          "ru": "Форма одна для всех лиц: he should, they should."
        }
      ]
    },
    {
      "type": "reading",
      "id": "u11.d03.reading",
      "title": {
        "en": "Feeling tired",
        "ru": "Постоянная усталость"
      },
      "blocks": [
        {
          "id": "u11.d03.reading.b1",
          "en": "Tom always feels tired and he often has a headache. His friend says, \"You should sleep more and you shouldn't drink so much coffee.\"",
          "ru": "Том всё время устал и часто с головной болью. Друг говорит: «Тебе стоит больше спать и не стоит пить столько кофе».",
          "audio": {
            "src": "media/audio/u11.d03.reading.b1.mp3",
            "license": {
              "type": "original",
              "attribution": "Project authors (LLM-assisted)"
            }
          }
        },
        {
          "id": "u11.d03.reading.b2",
          "en": "\"You should also exercise and eat healthy food. And you shouldn't work at night.\" Tom followed the advice, and after a week he felt much better.",
          "ru": "«Ещё тебе стоит заниматься спортом и есть здоровую еду. И не стоит работать по ночам». Том последовал совету и через неделю почувствовал себя гораздо лучше.",
          "audio": {
            "src": "media/audio/u11.d03.reading.b2.mp3",
            "license": {
              "type": "original",
              "attribution": "Project authors (LLM-assisted)"
            }
          }
        }
      ],
      "glossary": [
