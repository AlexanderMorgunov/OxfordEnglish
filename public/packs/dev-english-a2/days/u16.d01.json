    {
      "type": "grammar",
      "id": "u16.d01.grammar",
      "title": {
        "en": "Past perfect",
        "ru": "Past perfect"
      },
      "rule": {
        "en": "Use the past perfect (had + past participle) for an action that happened BEFORE another past action — an earlier past inside a story.",
        "ru": "Past perfect (had + причастие) — действие, случившееся ДО другого прошлого действия; более раннее прошлое внутри истории."
      },
      "patterns": [
        {
          "label": {
            "en": "had + V3",
            "ru": "had + V3"
          },
          "formula": "had + past participle",
          "examples": [
            {
              "en": "When I arrived, the train had already left.",
              "ru": "Когда я пришёл, поезд уже ушёл."
            }
          ],
          "ref": "past-perfect"
        },
        {
          "label": {
            "en": "negative",
            "ru": "отрицание"
          },
          "formula": "hadn't + past participle",
          "examples": [
            {
              "en": "She hadn't finished when we called.",
              "ru": "Она не закончила, когда мы позвонили."
            }
          ],
          "ref": "past-perfect"
        },
        {
          "label": {
            "en": "question",
            "ru": "вопрос"
          },
          "formula": "Had + subject + V3?",
          "examples": [
            {
              "en": "Had you met him before that day?",
              "ru": "Ты встречал его до того дня?"
            }
          ],
          "ref": "past-perfect"
        }
      ],
      "pitfalls": [
        {
          "en": "Same \"had\" for all persons: I/he/we had gone.",
          "ru": "Одно \"had\" для всех лиц: I/he/we had gone."
        },
        {
          "en": "Use it for the EARLIER of two past events; the later one stays past simple.",
          "ru": "Оно — для более раннего из двух прошлых событий; позднее остаётся в past simple."
        }
      ]
    },
    {
      "type": "reading",
      "id": "u16.d01.reading",
      "title": {
        "en": "A missed train",
        "ru": "Упущенный поезд"
      },
      "blocks": [
        {
          "id": "u16.d01.reading.b1",
          "en": "When Anna finally got to the station, she realised that the train had already left. She had spent too long saying goodbye to her friends, and now the platform was empty. She hadn't planned for this at all.",
          "ru": "Когда Анна наконец добралась до вокзала, она поняла, что поезд уже ушёл. Она слишком долго прощалась с друзьями, и теперь платформа была пуста. Она совсем этого не планировала.",
          "audio": {
            "src": "media/audio/u16.d01.reading.b1.mp3",
            "license": {
              "type": "original",
              "attribution": "Project authors (LLM-assisted)"
            }
          }
        },
        {
          "id": "u16.d01.reading.b2",
          "en": "She checked her bag and realised something worse: she had left her wallet in the taxi. By the time she understood what had happened, the taxi had disappeared into the traffic. In the end, a kind stranger lent her some money for the next train.",
          "ru": "Она проверила сумку и поняла кое-что похуже: она оставила кошелёк в такси. К тому моменту, как она осознала произошедшее, такси уже растворилось в потоке машин. В итоге добрый незнакомец одолжил ей денег на следующий поезд.",
          "audio": {
            "src": "media/audio/u16.d01.reading.b2.mp3",
            "license": {
              "type": "original",
              "attribution": "Project authors (LLM-assisted)"
            }
          }
        }
      ],
      "glossary": [
        {
          "word": "platform",
          "ru": "платформа",
          "ipa": "/ˈplætfɔːrm/"
        },
        {
          "word": "stranger",
          "ru": "незнакомец",
          "ipa": "/ˈstreɪndʒər/"
        }
      ]
    },
