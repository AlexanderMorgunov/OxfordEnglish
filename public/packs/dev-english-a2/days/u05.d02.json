    {
      "type": "grammar",
      "id": "u05.d02.grammar",
      "title": {
        "en": "Past continuous",
        "ru": "Past continuous"
      },
      "rule": {
        "en": "Use the past continuous (was/were + -ing) for an action in progress at a moment in the past — the background of a story.",
        "ru": "Past continuous (was/were + -ing) — действие, которое шло в определённый момент в прошлом; фон истории."
      },
      "patterns": [
        {
          "label": {
            "en": "was + -ing",
            "ru": "was + -ing"
          },
          "formula": "I/he/she/it was + verb-ing",
          "examples": [
            {
              "en": "At 8pm I was reading.",
              "ru": "В 8 вечера я читал."
            }
          ],
          "ref": "past-continuous"
        },
        {
          "label": {
            "en": "were + -ing",
            "ru": "were + -ing"
          },
          "formula": "we/you/they were + verb-ing",
          "examples": [
            {
              "en": "They were waiting at the station.",
              "ru": "Они ждали на вокзале."
            }
          ],
          "ref": "past-continuous"
        },
        {
          "label": {
            "en": "question",
            "ru": "вопрос"
          },
          "formula": "was/were + subject + -ing?",
          "examples": [
            {
              "en": "What were you doing?",
              "ru": "Что ты делал?"
            }
          ],
          "ref": "past-continuous"
        }
      ],
      "pitfalls": [
        {
          "en": "Choose was or were by the subject: I/he/she/it → was, we/you/they → were.",
          "ru": "was или were — по подлежащему: I/he/she/it → was, we/you/they → were."
        },
        {
          "en": "Stative verbs (know, want) usually stay simple, not continuous.",
          "ru": "Глаголы состояния (know, want) обычно не ставят в continuous."
        }
      ]
    },
    {
