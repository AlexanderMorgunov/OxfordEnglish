    {
      "type": "grammar",
      "id": "u12.d02.grammar",
      "title": {
        "en": "just / yet / already",
        "ru": "just / yet / already"
      },
      "rule": {
        "en": "With the present perfect: \"just\" = a moment ago; \"already\" = before now (sooner than expected); \"yet\" = up to now, in questions and negatives.",
        "ru": "С present perfect: \"just\" = только что; \"already\" = уже (раньше, чем ожидали); \"yet\" = пока/уже — в вопросах и отрицаниях."
      },
      "patterns": [
        {
          "label": {
            "en": "just",
            "ru": "just"
          },
          "formula": "have just + V3",
          "examples": [
            {
              "en": "I've just finished my work.",
              "ru": "Я только что закончил работу."
            }
          ]
        },
        {
          "label": {
            "en": "already",
            "ru": "already"
          },
          "formula": "have already + V3",
          "examples": [
            {
              "en": "She has already left.",
              "ru": "Она уже ушла."
            }
          ]
        },
        {
          "label": {
            "en": "yet",
            "ru": "yet"
          },
          "formula": "… yet? · haven't … yet",
          "examples": [
            {
              "en": "Have you eaten yet? I haven't eaten yet.",
              "ru": "Ты уже поел? Я ещё не поел."
            }
          ]
        }
      ],
      "pitfalls": [
        {
          "en": "\"yet\" goes at the end: \"Have you finished yet?\"",
          "ru": "\"yet\" — в конце: \"Have you finished yet?\""
        },
        {
          "en": "\"just\" and \"already\" go before the past participle.",
          "ru": "\"just\" и \"already\" — перед причастием."
        }
      ]
    },
    {
      "type": "reading",
      "id": "u12.d02.reading",
      "title": {
        "en": "Before the trip",
