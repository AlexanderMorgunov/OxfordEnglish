    {
      "type": "grammar",
      "id": "u28.d05.grammar",
      "title": {
        "en": "Passive & causative — review",
        "ru": "Пассив и каузатив — обзор"
      },
      "rule": {
        "en": "Three tools: the passive (be + V3) when the doer doesn’t matter; the causative (have/get + object + V3) when you arrange a service; the get-passive (get + V3) for informal events that happen to you.",
        "ru": "Три инструмента: пассив (be + V3), когда исполнитель не важен; каузатив (have/get + объект + V3), когда заказываешь услугу; get-пассив (get + V3) — о неформальных событиях с тобой."
      },
      "patterns": [
        {
          "label": {
            "en": "passive",
            "ru": "пассив"
          },
          "formula": "be + V3",
          "examples": [
            {
              "en": "Orders are processed daily.",
              "ru": "Заказы обрабатывают ежедневно."
            }
          ],
          "ref": "passive"
        },
        {
          "label": {
            "en": "causative",
            "ru": "каузатив"
          },
          "formula": "have/get + object + V3",
          "examples": [
            {
              "en": "I had the car fixed.",
              "ru": "Мне починили машину."
            }
          ],
          "ref": "causative"
        },
        {
          "label": {
            "en": "get-passive",
            "ru": "get-пассив"
          },
          "formula": "get + V3",
          "examples": [
            {
              "en": "It got shipped yesterday.",
              "ru": "Это отправили вчера."
            }
          ],
          "ref": "passive"
        }
      ],
      "pitfalls": [
        {
          "en": "Causative word order: have + OBJECT + V3 — \"I had my hair cut\".",
          "ru": "Порядок каузатива: have + ОБЪЕКТ + V3 — «I had my hair cut»."
        },
        {
          "en": "Tense lives on \"be\"/\"get\": \"was sent\", \"got delayed\" — never drop it.",
          "ru": "Время — на «be»/«get»: «was sent», «got delayed» — не теряй его."
        }
      ]
    },
    {
      "type": "reading",
      "id": "u28.d05.reading",
      "title": {
        "en": "How the shop runs",
        "ru": "Как работает магазин"
      },
      "blocks": [
        {
          "id": "u28.d05.reading.b1",
          "en": "Everything in our online shop is automated. Orders are received, payments are processed, and confirmations are sent within seconds. If something breaks, we have it fixed the same day. Nothing gets ignored — every message is answered.",
          "ru": "В нашем интернет-магазине всё автоматизировано. Заказы принимаются, платежи обрабатываются, подтверждения отправляются за секунды. Если что-то ломается, мы это чиним в тот же день. Ничего не игнорируется — на каждое сообщение отвечают.",
          "audio": {
            "src": "media/audio/u28.d05.reading.b1.mp3",
            "license": {
              "type": "original",
              "attribution": "Project authors (LLM-assisted)"
            }
          }
        },
        {
          "id": "u28.d05.reading.b2",
          "en": "Last week a package got lost in transit, so we had a new one sent free of charge. The customer got a refund too. We also get the whole system checked every month, because trust is built slowly and lost quickly.",
          "ru": "На прошлой неделе посылка потерялась в пути, поэтому мы бесплатно отправили новую. Клиенту ещё и вернули деньги. Мы также проверяем всю систему каждый месяц, ведь доверие строится медленно, а теряется быстро.",
          "audio": {
            "src": "media/audio/u28.d05.reading.b2.mp3",
            "license": {
              "type": "original",
              "attribution": "Project authors (LLM-assisted)"
            }
          }
        }
      ],
      "glossary": [
        {
          "word": "transit",
          "ru": "транзит/доставка",
          "ipa": "/ˈtrænsɪt/"
        },
        {
          "word": "trust",
          "ru": "доверие",
          "ipa": "/trʌst/"
        }
      ]
    },
