    {
      "type": "grammar",
      "id": "u03.d02.grammar",
      "title": {
        "en": "Present simple vs continuous",
        "ru": "Present simple и continuous"
      },
      "rule": {
        "en": "Present simple = routines and facts (every day, usually). Present continuous = things happening now (am/is/are + -ing).",
        "ru": "Present simple — привычки и факты (every day, usually). Present continuous — то, что происходит сейчас (am/is/are + -ing)."
      },
      "patterns": [
        {
          "label": {
            "en": "usually",
            "ru": "обычно"
          },
          "formula": "subject + verb(s) — every day",
          "examples": [
            {
              "en": "I play football every Sunday.",
              "ru": "Я играю в футбол каждое воскресенье."
            }
          ],
          "ref": "present-vs-continuous"
        },
        {
          "label": {
            "en": "now",
            "ru": "сейчас"
          },
          "formula": "am/is/are + verb-ing",
          "examples": [
            {
              "en": "I am playing football now.",
              "ru": "Я сейчас играю в футбол."
            }
          ],
          "ref": "present-vs-continuous"
        }
      ],
      "pitfalls": [
        {
          "en": "Stative verbs (know, like, want, need) are not used in continuous: \"I know\", not \"I am knowing\".",
          "ru": "Глаголы состояния (know, like, want, need) не ставят в continuous: \"I know\", а не \"I am knowing\"."
        },
        {
          "en": "Time words help: usually/every day → simple; now/at the moment → continuous.",
          "ru": "Помогают маркеры: usually/every day → simple; now/at the moment → continuous."
        }
      ]
    },
    {
      "type": "reading",
      "id": "u03.d02.reading",
      "title": {
        "en": "Sam's weekend",
        "ru": "Выходные Сэма"
      },
      "blocks": [
        {
          "id": "u03.d02.reading.b1",
          "en": "Sam usually works from Monday to Friday. On weekends he relaxes. He often plays football with friends and cooks a big lunch.",
          "ru": "Сэм обычно работает с понедельника по пятницу. На выходных он отдыхает. Часто играет в футбол с друзьями и готовит большой обед.",
          "audio": {
            "src": "media/audio/u03.d02.reading.b1.mp3",
            "license": {
              "type": "original",
              "attribution": "Project authors (LLM-assisted)"
            }
          }
        },
        {
          "id": "u03.d02.reading.b2",
          "en": "But it is Saturday now, and it is raining. So today Sam is not playing football. He is sitting at home, drawing and listening to music.",
          "ru": "Но сейчас суббота, и идёт дождь. Поэтому сегодня Сэм не играет в футбол. Он сидит дома, рисует и слушает музыку.",
          "audio": {
            "src": "media/audio/u03.d02.reading.b2.mp3",
