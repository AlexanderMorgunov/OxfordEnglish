  "sections": [
    {
      "type": "grammar",
      "id": "u08.d01.grammar",
      "title": {
        "en": "There is / there are · Where is…?",
        "ru": "There is / there are · Where is…?"
      },
      "rule": {
        "en": "Use \"there is\" for one thing, \"there are\" for many. Ask \"Where is…?\" to find something.",
        "ru": "Используй \"there is\" для одного, \"there are\" для многих. Спрашивай \"Where is…?\", чтобы что-то найти."
      },
      "patterns": [
        {
          "label": {
            "en": "there is / are",
            "ru": "there is / are"
          },
          "formula": "there is + singular · there are + plural",
          "examples": [
            {
              "en": "There is a shop near here. There are two cafés.",
              "ru": "Рядом есть магазин. Есть два кафе."
            }
          ]
        },
        {
          "label": {
            "en": "Where…?",
            "ru": "Где…?"
          },
          "formula": "Where is / are + noun ?",
          "examples": [
            {
              "en": "Where is the water?",
              "ru": "Где вода?"
            }
          ]
        }
      ],
      "pitfalls": [
        {
          "en": "Match the verb to the noun: \"there is one apple\", \"there are three apples\".",
          "ru": "Согласуй глагол с существительным: \"there is one apple\", \"there are three apples\"."
        },
        {
          "en": "Prepositions of place: at, in, on, near, next to, between.",
          "ru": "Предлоги места: at, in, on, near, next to, between."
        }
      ]
    },
