    {
      "type": "grammar",
      "id": "u17.d01.grammar",
      "title": {
        "en": "Present perfect continuous",
        "ru": "Present perfect continuous"
      },
      "rule": {
        "en": "Use the present perfect continuous (have/has been + -ing) for an action that started in the past and is still going on, or has just stopped — with the focus on the activity itself.",
        "ru": "Present perfect continuous (have/has been + -ing) — действие, которое началось в прошлом и всё ещё идёт (или только что закончилось); акцент на самом процессе."
      },
      "patterns": [
        {
          "label": {
            "en": "positive",
            "ru": "утверждение"
          },
          "formula": "have/has been + verb-ing",
          "examples": [
            {
              "en": "I've been working all day.",
              "ru": "Я работаю весь день."
            }
          ],
          "ref": "present-perfect-continuous"
        },
        {
          "label": {
            "en": "negative",
            "ru": "отрицание"
          },
          "formula": "haven't/hasn't been + verb-ing",
          "examples": [
            {
              "en": "She hasn't been sleeping well.",
              "ru": "Она плохо спит в последнее время."
            }
          ],
          "ref": "present-perfect-continuous"
        },
        {
          "label": {
            "en": "question",
            "ru": "вопрос"
          },
          "formula": "Have/Has + subject + been + verb-ing?",
          "examples": [
            {
              "en": "What have you been doing?",
              "ru": "Чем ты занимался?"
            }
          ],
          "ref": "present-perfect-continuous"
        }
      ],
      "pitfalls": [
        {
          "en": "Keep \"been\" in: \"I have BEEN working\", not \"I have working\".",
          "ru": "Не теряй «been»: «I have BEEN working», а не «I have working»."
        },
        {
          "en": "Same \"have/has been\" for the whole verb — only the main verb takes -ing.",
          "ru": "Одно «have/has been» на всё сказуемое — окончание -ing только у смыслового глагола."
        }
      ]
    },
    {
      "type": "reading",
      "id": "u17.d01.reading",
      "title": {
        "en": "A long day",
        "ru": "Длинный день"
      },
      "blocks": [
        {
          "id": "u17.d01.reading.b1",
          "en": "It's six o'clock and Marco is still at his desk. He has been working since eight this morning, and he hasn't even stopped for lunch. His team has been preparing for a big product launch, and the deadline is tomorrow.",
          "ru": "Шесть часов, а Марко всё ещё за столом. Он работает с восьми утра и даже не прервался на обед. Его команда готовится к большому запуску продукта, и срок — завтра.",
          "audio": {
            "src": "media/audio/u17.d01.reading.b1.mp3",
            "license": {
              "type": "original",
              "attribution": "Project authors (LLM-assisted)"
            }
          }
        },
        {
          "id": "u17.d01.reading.b2",
          "en": "\"I've been staring at this screen for ten hours,\" he says. \"My eyes hurt.\" But he is happy: the project has been going well, and everyone has been helping each other. Soon they will finish, and then he will finally go home.",
          "ru": "«Я десять часов смотрю в этот экран, — говорит он. — Глаза болят». Но он доволен: проект идёт хорошо, и все помогают друг другу. Скоро они закончат, и тогда он наконец пойдёт домой.",
          "audio": {
            "src": "media/audio/u17.d01.reading.b2.mp3",
            "license": {
              "type": "original",
              "attribution": "Project authors (LLM-assisted)"
            }
          }
        }
      ],
