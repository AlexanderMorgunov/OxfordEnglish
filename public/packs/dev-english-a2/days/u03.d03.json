    {
      "type": "grammar",
      "id": "u03.d03.grammar",
      "title": {
        "en": "Ability: can / could / be able to",
        "ru": "Умение: can / could / be able to"
      },
      "rule": {
        "en": "Use can + verb for ability now, could for past ability, and be able to for other tenses. No \"to\" after can/could.",
        "ru": "can + глагол — умение сейчас, could — в прошлом, be able to — в других временах. После can/could нет \"to\"."
      },
      "patterns": [
        {
          "label": {
            "en": "can (now)",
            "ru": "can (сейчас)"
          },
          "formula": "can + verb",
          "examples": [
            {
              "en": "I can swim.",
              "ru": "Я умею плавать."
            }
          ],
          "ref": "modals-can"
        },
        {
          "label": {
            "en": "could (past)",
            "ru": "could (прошлое)"
          },
          "formula": "could + verb",
          "examples": [
            {
              "en": "I could swim at five.",
              "ru": "Я умел плавать в пять лет."
            }
          ],
          "ref": "modals-can"
        },
        {
          "label": {
            "en": "be able to",
            "ru": "be able to"
          },
          "formula": "am/is/are able to + verb",
          "examples": [
            {
              "en": "She is able to drive.",
              "ru": "Она умеет водить."
            }
          ],
          "ref": "modals-can"
        }
      ],
      "pitfalls": [
        {
          "en": "No \"to\" after can/could: \"I can swim\", not \"I can to swim\".",
          "ru": "После can/could нет \"to\": \"I can swim\", а не \"I can to swim\"."
        },
        {
          "en": "Same form for all persons: he can (not \"he cans\").",
          "ru": "Форма одна для всех лиц: he can (не \"he cans\")."
        }
      ]
    },
    {
      "type": "reading",
      "id": "u03.d03.reading",
      "title": {
        "en": "Learning new things",
        "ru": "Учимся новому"
      },
      "blocks": [
        {
          "id": "u03.d03.reading.b1",
          "en": "Two years ago, Mia could not code. She could not write a single line. But she started a course and practised every day.",
          "ru": "Два года назад Мия не умела программировать. Не могла написать ни строчки. Но она пошла на курс и занималась каждый день.",
          "audio": {
            "src": "media/audio/u03.d03.reading.b1.mp3",
            "license": {
              "type": "original",
              "attribution": "Project authors (LLM-assisted)"
            }
          }
        },
        {
          "id": "u03.d03.reading.b2",
          "en": "Now Mia can build small apps. She can also fix simple bugs. Next year she wants to be able to work as a developer.",
          "ru": "Теперь Мия умеет делать небольшие приложения. Ещё она может чинить простые баги. В следующем году она хочет уметь работать разработчиком.",
          "audio": {
            "src": "media/audio/u03.d03.reading.b2.mp3",
            "license": {
              "type": "original",
              "attribution": "Project authors (LLM-assisted)"
            }
          }
        }
      ],
