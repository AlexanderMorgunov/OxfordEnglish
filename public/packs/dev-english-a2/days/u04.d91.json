    {
      "type": "grammar",
      "id": "u04.d91.grammar",
      "title": {
        "en": "Past simple",
        "ru": "Past simple"
      },
      "ref": "past-simple",
      "rule": {
        "en": "Use the past simple for finished actions in the past. Regular verbs add -ed (visit → visited). Many common verbs are irregular and must be learned: build → built, do → did, sleep → slept.",
        "ru": "Past simple — для законченных действий в прошлом. Правильные глаголы получают -ed (visit → visited). Многие частые глаголы неправильные, их нужно запомнить: build → built, do → did, sleep → slept."
      },
      "patterns": [
        {
          "label": {
            "en": "regular (+ed)",
            "ru": "правильные (+ed)"
          },
          "formula": "subject + verb-ed",
          "examples": [
            {
              "en": "Kate visited her sister.",
              "ru": "Кейт навестила сестру."
            }
          ],
          "ref": "past-simple"
        },
        {
          "label": {
            "en": "irregular",
            "ru": "неправильные"
          },
          "formula": "subject + past form",
          "examples": [
            {
              "en": "Alex built a huge fort.",
              "ru": "Алекс построил огромную крепость."
            }
          ],
          "ref": "past-simple"
        },
        {
          "label": {
            "en": "negative with did not",
            "ru": "отрицание с did not"
          },
          "formula": "subject + did not + base verb",
          "examples": [
            {
              "en": "Alex did not sleep.",
              "ru": "Алекс не спал."
            }
          ],
          "ref": "past-simple"
        }
      ],
      "pitfalls": [
        {
          "en": "After \"did not\", use the base verb: \"did not sleep\", not \"did not slept\".",
          "ru": "После «did not» — начальная форма: «did not sleep», а не «did not slept»."
        },
        {
          "en": "Irregular verbs have no -ed: \"built\", not \"builded\"; \"did\", not \"doed\".",
          "ru": "У неправильных глаголов нет -ed: «built», а не «builded»; «did», а не «doed»."
        }
      ]
    },
    {
