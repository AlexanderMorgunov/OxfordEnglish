    {
      "type": "grammar",
      "id": "u22.d05.grammar",
      "title": {
        "en": "Describing with relative clauses",
        "ru": "Описываем через придаточные"
      },
      "rule": {
        "en": "Relative clauses are perfect for describing people and places. Use \"the kind/type of person who…\" and \"a place where…\" to give a clear picture.",
        "ru": "Относительные придаточные идеальны для описания людей и мест. Используй «the kind/type of person who…» и «a place where…», чтобы дать ясную картину."
      },
      "patterns": [
        {
          "label": {
            "en": "the kind of person who",
            "ru": "человек, который"
          },
          "formula": "the type/kind of person who + verb",
          "examples": [
            {
              "en": "She's the kind of person who always helps.",
              "ru": "Она из тех, кто всегда помогает."
            }
          ],
          "ref": "relative-clauses"
        },
        {
          "label": {
            "en": "a place where",
            "ru": "место, где"
          },
          "formula": "a place where + subject + verb",
          "examples": [
            {
              "en": "It's a place where I feel calm.",
              "ru": "Это место, где я чувствую спокойствие."
            }
          ],
          "ref": "relative-clauses"
        },
        {
          "label": {
            "en": "with whose/that",
            "ru": "с whose/that"
          },
          "formula": "someone whose … / something that …",
          "examples": [
            {
              "en": "A friend whose advice I trust.",
              "ru": "Друг, чьим советам я доверяю."
            }
          ],
          "ref": "relative-clauses"
        }
      ],
      "pitfalls": [
        {
          "en": "\"the kind of person who\" + verb: describes a type of person.",
          "ru": "«the kind of person who» + глагол: описывает тип человека."
        },
        {
          "en": "Combine clauses to describe richly: \"a friend who listens and whose advice I trust\".",
          "ru": "Соединяй придаточные для богатого описания: «a friend who listens and whose advice I trust»."
        }
      ]
    },
    {
      "type": "reading",
      "id": "u22.d05.reading",
      "title": {
        "en": "My best friend",
        "ru": "Мой лучший друг"
      },
      "blocks": [
        {
          "id": "u22.d05.reading.b1",
          "en": "My best friend, Dan, is the kind of person who always listens. He's someone whose advice I completely trust, and a friend who never judges. He's honest, patient, and incredibly reliable.",
          "ru": "Мой лучший друг Дэн — из тех, кто всегда выслушает. Это человек, чьим советам я полностью доверяю, и друг, который никогда не осуждает. Он честный, терпеливый и невероятно надёжный.",
          "audio": {
            "src": "media/audio/u22.d05.reading.b1.mp3",
            "license": {
              "type": "original",
              "attribution": "Project authors (LLM-assisted)"
            }
          }
        },
        {
          "id": "u22.d05.reading.b2",
          "en": "We often go to a small café where we can talk for hours. It's the sort of place where nobody rushes you. \"A good friend,\" Dan says, \"is someone you can call at three in the morning.\" He's exactly that kind of friend.",
          "ru": "Мы часто ходим в маленькое кафе, где можем говорить часами. Это такое место, где тебя никто не торопит. «Хороший друг, — говорит Дэн, — это тот, кому можно позвонить в три часа ночи». Он именно такой друг.",
          "audio": {
            "src": "media/audio/u22.d05.reading.b2.mp3",
            "license": {
              "type": "original",
              "attribution": "Project authors (LLM-assisted)"
            }
          }
        }
      ],
      "glossary": [
        {
          "word": "judge",
          "ru": "осуждать, судить",
