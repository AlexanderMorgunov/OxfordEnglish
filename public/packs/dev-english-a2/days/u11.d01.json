    {
      "type": "grammar",
      "id": "u11.d01.grammar",
      "title": {
        "en": "must / mustn't",
        "ru": "must / mustn't"
      },
      "rule": {
        "en": "Use \"must + verb\" for a strong obligation or a rule. Use \"mustn't + verb\" for something prohibited (don't do it).",
        "ru": "\"must + глагол\" — сильная обязанность или правило. \"mustn't + глагол\" — то, что запрещено (нельзя делать)."
      },
      "patterns": [
        {
          "label": {
            "en": "must",
            "ru": "must"
          },
          "formula": "must + verb (necessary)",
          "examples": [
            {
              "en": "You must wear a helmet.",
              "ru": "Ты должен надеть шлем."
            }
          ],
          "ref": "modals-obligation"
        },
        {
          "label": {
            "en": "mustn't",
            "ru": "mustn't"
          },
          "formula": "mustn't + verb (prohibited)",
          "examples": [
            {
              "en": "You mustn't use your phone here.",
              "ru": "Здесь нельзя пользоваться телефоном."
            }
          ],
          "ref": "modals-obligation"
        }
      ],
      "pitfalls": [
        {
          "en": "Use the base verb after must: \"must go\", not \"must to go\".",
          "ru": "После must — начальная форма: \"must go\", а не \"must to go\"."
        },
        {
          "en": "\"mustn't\" = prohibited; it is not the same as \"don't have to\" (= not necessary).",
          "ru": "\"mustn't\" = запрещено; это не то же самое, что \"don't have to\" (= не обязательно)."
        }
      ]
    },
    {
      "type": "reading",
      "id": "u11.d01.reading",
      "title": {
        "en": "Gym rules",
        "ru": "Правила зала"
      },
      "blocks": [
        {
          "id": "u11.d01.reading.b1",
          "en": "There are some rules at the gym. You must wear clean shoes and you must bring a towel. You must drink a lot of water when you train.",
          "ru": "В зале есть правила. Нужно быть в чистой обуви и приносить полотенце. Во время тренировки нужно пить много воды.",
          "audio": {
            "src": "media/audio/u11.d01.reading.b1.mp3",
            "license": {
              "type": "original",
              "attribution": "Project authors (LLM-assisted)"
            }
          }
        },
        {
          "id": "u11.d01.reading.b2",
          "en": "You mustn't eat in the training room, and you mustn't drop the weights on the floor. If you follow the rules, your body will be healthy and strong.",
          "ru": "Нельзя есть в тренировочном зале и нельзя бросать веса на пол. Если соблюдать правила, тело будет здоровым и сильным.",
          "audio": {
            "src": "media/audio/u11.d01.reading.b2.mp3",
