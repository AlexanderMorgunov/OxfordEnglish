    {
      "type": "grammar",
      "id": "u11.d05.grammar",
      "title": {
        "en": "At the doctor's",
        "ru": "У врача"
      },
      "rule": {
        "en": "The doctor asks \"What's the matter?\" / \"How do you feel?\". Say \"I have a … (headache/pain)\". The doctor gives advice with \"You should …\" and \"Take …\".",
        "ru": "Врач спрашивает \"What's the matter?\" / \"How do you feel?\". Отвечай \"I have a … (headache/pain)\". Врач советует \"You should …\" и \"Take …\"."
      },
      "patterns": [
        {
          "label": {
            "en": "symptom",
            "ru": "симптом"
          },
          "formula": "I have a + illness/pain",
          "examples": [
            {
              "en": "I have a headache and a sore throat.",
              "ru": "У меня болит голова и горло."
            }
          ]
        },
        {
          "label": {
            "en": "ask",
            "ru": "вопрос"
          },
          "formula": "What's the matter? · How do you feel?",
          "examples": [
            {
              "en": "What's the matter? How do you feel?",
              "ru": "Что случилось? Как вы себя чувствуете?"
            }
          ]
        },
        {
          "label": {
            "en": "advice",
            "ru": "совет"
          },
          "formula": "You should … · Take …",
          "examples": [
            {
              "en": "You should rest. Take this medicine.",
              "ru": "Вам стоит отдохнуть. Принимайте это лекарство."
            }
          ]
        }
      ],
      "pitfalls": [
        {
          "en": "Say \"I have a headache\", not \"I am headache\".",
          "ru": "Говори \"I have a headache\", а не \"I am headache\"."
        },
        {
          "en": "Use \"a\" with aches: \"a headache\", \"a stomach ache\".",
          "ru": "С болями — \"a\": \"a headache\", \"a stomach ache\"."
        }
      ]
    },
    {
      "type": "reading",
      "id": "u11.d05.reading",
      "title": {
        "en": "A visit to the doctor",
        "ru": "Визит к врачу"
      },
      "blocks": [
        {
          "id": "u11.d05.reading.b1",
          "en": "\"Good morning. What's the matter?\" asked the doctor. \"I feel sick and I have a bad headache,\" said Kate. \"How long have you felt like this?\"",
          "ru": "«Доброе утро. Что случилось?» — спросил врач. «Мне нездоровится и сильно болит голова», — сказала Кейт. «Как давно вы так себя чувствуете?»",
          "audio": {
            "src": "media/audio/u11.d05.reading.b1.mp3",
            "license": {
              "type": "original",
              "attribution": "Project authors (LLM-assisted)"
            }
          }
        },
        {
          "id": "u11.d05.reading.b2",
          "en": "\"For two days.\" The doctor said, \"You have a cold. You should rest and drink water. Take these pills twice a day. You'll feel better soon.\"",
          "ru": "«Уже два дня». Врач сказал: «У вас простуда. Вам стоит отдыхать и пить воду. Принимайте эти таблетки дважды в день. Скоро станет лучше».",
          "audio": {
            "src": "media/audio/u11.d05.reading.b2.mp3",
            "license": {
              "type": "original",
              "attribution": "Project authors (LLM-assisted)"
            }
          }
        }
      ],
      "glossary": [
        {
          "word": "throat",
          "ru": "горло",
          "ipa": "/θroʊt/"
        },
        {
          "word": "twice",
          "ru": "дважды",
          "ipa": "/twaɪs/"
        }
      ]
    },
