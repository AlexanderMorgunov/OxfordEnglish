    {
      "type": "grammar",
      "id": "u02.d01.grammar",
      "title": {
        "en": "Present simple",
        "ru": "Present simple"
      },
      "rule": {
        "en": "Use the present simple for habits and routines. Add -s for he/she/it: I work → she works.",
        "ru": "Present simple — для привычек и распорядка. Для he/she/it добавляем -s: I work → she works."
      },
      "patterns": [
        {
          "label": {
            "en": "I/you/we/they",
            "ru": "I/you/we/they"
          },
          "formula": "subject + verb",
          "examples": [
            {
              "en": "I get up at seven.",
              "ru": "Я встаю в семь."
            }
          ],
          "ref": "present-simple"
        },
        {
          "label": {
            "en": "he/she/it (+s)",
            "ru": "he/she/it (+s)"
          },
          "formula": "subject + verb-s",
          "examples": [
            {
              "en": "She finishes at five.",
              "ru": "Она заканчивает в пять."
            }
          ],
          "ref": "present-simple"
        }
      ],
      "pitfalls": [
        {
          "en": "Don't forget -s for he/she/it: \"she works\", not \"she work\".",
          "ru": "Не забывай -s для he/she/it: \"she works\", а не \"she work\"."
        },
        {
          "en": "Spelling: -es after -sh/-ch/-s/-x/-o: \"finishes\", \"watches\", \"goes\".",
          "ru": "Написание: -es после -sh/-ch/-s/-x/-o: \"finishes\", \"watches\", \"goes\"."
        }
      ]
    },
    {
