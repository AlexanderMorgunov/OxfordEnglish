    {
      "type": "grammar",
      "id": "a11.d01.grammar",
      "title": {
        "en": "Subject pronouns and the verb be (am / is / are)",
        "ru": "Личные местоимения и глагол be (am / is / are)"
      },
      "ref": "verb-be",
      "rule": {
        "en": "English needs the verb be in almost every sentence about who or what someone is. It has three present forms: I → am, he/she/it → is, you/we/they → are. In speech we usually shorten it: I'm, he's, she's, it's, you're, we're, they're.",
        "ru": "В английском почти в каждом предложении о том, кто человек или какой он, нужен глагол be. У него три формы в настоящем: I → am, he/she/it → is, you/we/they → are. В речи обычно сокращаем: I'm, he's, she's, it's, you're, we're, they're."
      },
      "patterns": [
        {
          "label": {
            "en": "I am / I'm",
            "ru": "I am / I'm"
          },
          "formula": "I + am (+ a/an + noun)",
          "examples": [
            {
              "en": "I am a student.",
              "ru": "Я студент."
            },
            {
              "en": "I'm from Russia.",
              "ru": "Я из России."
            }
          ]
        },
        {
          "label": {
            "en": "he / she / it is",
            "ru": "he / she / it is"
          },
          "formula": "he/she/it + is",
          "examples": [
            {
              "en": "She is a teacher.",
              "ru": "Она учитель."
            },
            {
              "en": "He's my friend.",
              "ru": "Он мой друг."
            }
          ]
        },
        {
          "label": {
            "en": "you / we / they are",
            "ru": "you / we / they are"
          },
          "formula": "you/we/they + are",
          "examples": [
            {
              "en": "We are friends.",
              "ru": "Мы друзья."
            },
            {
              "en": "They're from England.",
              "ru": "Они из Англии."
            }
          ]
        }
      ],
      "pitfalls": [
        {
          "en": "Don't drop be: not \"I a student\" but \"I am a student.\"",
          "ru": "Нельзя пропускать be: не «I a student», а «I am a student»."
        },
        {
          "en": "he/she/it takes is, not are: \"She is\", not \"She are.\"",
          "ru": "После he/she/it — is, а не are: «She is», не «She are»."
        }
      ]
    },
