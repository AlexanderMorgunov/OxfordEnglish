    {
      "type": "grammar",
      "id": "u14.d01.grammar",
      "title": {
        "en": "Tenses review",
        "ru": "Повторение времён"
      },
      "rule": {
        "en": "Recap: present simple for routines, past simple for finished actions, present perfect for experiences, going to / will for the future.",
        "ru": "Повторим: present simple — привычки, past simple — законченные действия, present perfect — опыт, going to / will — будущее."
      },
      "patterns": [
        {
          "label": {
            "en": "present / past",
            "ru": "present / past"
          },
          "formula": "I work · I worked",
          "examples": [
            {
              "en": "I usually work, but yesterday I rested.",
              "ru": "Обычно я работаю, но вчера отдыхал."
            }
          ]
        },
        {
          "label": {
            "en": "present perfect",
            "ru": "present perfect"
          },
          "formula": "I have + V3",
          "examples": [
            {
              "en": "I have been to many parties.",
              "ru": "Я был на многих вечеринках."
            }
          ]
        },
        {
          "label": {
            "en": "future",
            "ru": "будущее"
          },
          "formula": "going to / will",
          "examples": [
            {
              "en": "We are going to celebrate tonight.",
              "ru": "Сегодня вечером мы будем праздновать."
            }
          ]
        }
      ],
      "pitfalls": [
        {
          "en": "Time words tell you the tense: yesterday → past, every day → present, tomorrow → future.",
          "ru": "Слова-маркеры подсказывают время: yesterday → past, every day → present, tomorrow → future."
        },
        {
          "en": "Use present perfect (not past) when there is no exact time.",
          "ru": "Используй present perfect (не past), когда точного времени нет."
        }
      ]
    },
    {
      "type": "reading",
      "id": "u14.d01.reading",
      "title": {
        "en": "A birthday to remember",
        "ru": "Запоминающийся день рождения"
      },
      "blocks": [
        {
          "id": "u14.d01.reading.b1",
          "en": "Last Saturday we celebrated my sister's birthday. Ten guests came and we had a big cake with candles. She got a lot of presents.",
          "ru": "В прошлую субботу мы отпраздновали день рождения сестры. Пришло десять гостей, у нас был большой торт со свечами. Она получила много подарков.",
          "audio": {
            "src": "media/audio/u14.d01.reading.b1.wav",
            "license": {
              "type": "original",
              "attribution": "Project authors (LLM-assisted)"
            }
          }
        },
        {
          "id": "u14.d01.reading.b2",
          "en": "She has never had such a happy day. Next year we are going to make an even bigger party. Celebrations always bring the family together.",
          "ru": "У неё никогда не было такого счастливого дня. В следующем году мы устроим ещё большую вечеринку. Праздники всегда собирают семью вместе.",
          "audio": {
            "src": "media/audio/u14.d01.reading.b2.wav",
            "license": {
              "type": "original",
              "attribution": "Project authors (LLM-assisted)"
            }
          }
        }
      ],
