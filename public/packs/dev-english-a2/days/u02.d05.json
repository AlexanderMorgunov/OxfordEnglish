    {
      "type": "grammar",
      "id": "u02.d05.grammar",
      "title": {
        "en": "Review: routines & questions",
        "ru": "Повтор: распорядок и вопросы"
      },
      "rule": {
        "en": "Put it together: talk about your day and ask about theirs. \"What do you do? / How often…? / Are you free…?\"",
        "ru": "Соедини всё: расскажи про свой день и спроси про их. \"What do you do? / How often…? / Are you free…?\""
      },
      "patterns": [
        {
          "label": {
            "en": "Small talk",
            "ru": "Small talk"
          },
          "formula": "How are you? · Any plans? · Let's meet.",
          "examples": [
            {
              "en": "How are you? — Fine, a bit busy. Any plans?",
              "ru": "Как дела? — Нормально, немного занят. Планы есть?"
            }
          ]
        }
      ],
      "pitfalls": [
        {
          "en": "\"How are you?\" ≠ \"How old are you?\" — the first asks about your day.",
          "ru": "\"How are you?\" ≠ \"How old are you?\" — первое про состояние/дела."
        }
      ]
    },
    {
