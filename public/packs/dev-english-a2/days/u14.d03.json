    {
      "type": "grammar",
      "id": "u14.d03.grammar",
      "title": {
        "en": "Reported speech (intro)",
        "ru": "Косвенная речь (введение)"
      },
      "rule": {
        "en": "To report what someone said, use \"say\" or \"tell + person\" and move the tense back one step: present → past, will → would, can → could.",
        "ru": "Чтобы передать чужие слова, используй \"say\" или \"tell + кому\" и сдвинь время на шаг назад: present → past, will → would, can → could."
      },
      "patterns": [
        {
          "label": {
            "en": "present → past",
            "ru": "present → past"
          },
          "formula": "\"I am tired\" → She said she was tired",
          "examples": [
            {
              "en": "She said she was tired.",
              "ru": "Она сказала, что устала."
            }
          ],
          "ref": "reported-speech"
        },
        {
          "label": {
            "en": "say / tell",
            "ru": "say / tell"
          },
          "formula": "say (that) · tell + person (that)",
          "examples": [
            {
              "en": "He told me that he was late.",
              "ru": "Он сказал мне, что опаздывает."
            }
          ],
          "ref": "reported-speech"
        },
        {
          "label": {
            "en": "will → would",
            "ru": "will → would"
          },
          "formula": "\"I will come\" → He said he would come",
          "examples": [
            {
              "en": "He said he would come.",
              "ru": "Он сказал, что придёт."
            }
          ],
          "ref": "reported-speech"
        }
      ],
      "pitfalls": [
        {
          "en": "Use \"tell\" with a person, \"say\" without: \"She told me\", \"She said\".",
          "ru": "\"tell\" — с человеком, \"say\" — без: \"She told me\", \"She said\"."
        },
        {
          "en": "Move the tense back: is → was, have → had, will → would.",
          "ru": "Сдвигай время назад: is → was, have → had, will → would."
        }
      ]
    },
    {
