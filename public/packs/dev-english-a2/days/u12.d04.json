    {
      "type": "grammar",
      "id": "u12.d04.grammar",
      "title": {
        "en": "Present perfect vs past simple",
        "ru": "Present perfect и past simple"
      },
      "rule": {
        "en": "Use the present perfect for experiences with no time (Have you seen…?). Use the past simple when you say WHEN (yesterday, last week, in 2010).",
        "ru": "Present perfect — об опыте без указания времени (Have you seen…?). Past simple — когда назван МОМЕНТ (yesterday, last week, in 2010)."
      },
      "patterns": [
        {
          "label": {
            "en": "perfect (no time)",
            "ru": "perfect (без времени)"
          },
          "formula": "Have you + V3?",
          "examples": [
            {
              "en": "Have you seen this film?",
              "ru": "Ты видел этот фильм?"
            }
          ],
          "ref": "perfect-vs-past"
        },
        {
          "label": {
            "en": "past (with time)",
            "ru": "past (со временем)"
          },
          "formula": "Did you + verb + time?",
          "examples": [
            {
              "en": "Did you see it yesterday?",
              "ru": "Ты видел это вчера?"
            }
          ],
          "ref": "perfect-vs-past"
        },
        {
          "label": {
            "en": "together",
            "ru": "вместе"
          },
          "formula": "perfect → then past for details",
          "examples": [
            {
              "en": "I've been to Rome. I went there in 2019.",
              "ru": "Я был в Риме. Я ездил туда в 2019."
            }
          ],
          "ref": "perfect-vs-past"
        }
      ],
      "pitfalls": [
        {
          "en": "With a past time word use the past simple: \"I saw it yesterday\", not \"I have seen it yesterday\".",
          "ru": "Со словом о прошлом — past simple: \"I saw it yesterday\", а не \"I have seen it yesterday\"."
        },
        {
          "en": "No exact time → present perfect; exact time → past simple.",
          "ru": "Нет точного времени → present perfect; есть → past simple."
        }
      ]
    },
