    {
      "type": "grammar",
      "id": "u03.d01.grammar",
      "title": {
        "en": "Happening now",
        "ru": "Происходит сейчас"
      },
      "rule": {
        "en": "For something happening right now, use am / is / are + verb-ing.",
        "ru": "Для действия, которое происходит прямо сейчас, используй am / is / are + глагол-ing."
      },
      "patterns": [
        {
          "label": {
            "en": "Statement",
            "ru": "Утверждение"
          },
          "formula": "subject + am/is/are + verb-ing",
          "examples": [
            {
              "en": "She is waving.",
              "ru": "Она машет."
            }
          ],
          "ref": "present-continuous"
        },
        {
          "label": {
            "en": "Question",
            "ru": "Вопрос"
          },
          "formula": "What + am/is/are + subject + verb-ing ?",
          "examples": [
            {
              "en": "What are you doing?",
              "ru": "Что ты делаешь?"
            }
          ],
          "ref": "present-continuous"
        }
      ],
      "pitfalls": [
        {
          "en": "Present continuous = now. Present simple = habits: \"I work every day\" vs \"I am working now\".",
          "ru": "Present continuous — сейчас. Present simple — привычки: \"I work every day\" против \"I am working now\"."
        },
        {
          "en": "Spelling of -ing: wave → waving (drop e), sit → sitting (double the t).",
          "ru": "Написание -ing: wave → waving (убираем e), sit → sitting (удваиваем t)."
        }
      ]
    },
