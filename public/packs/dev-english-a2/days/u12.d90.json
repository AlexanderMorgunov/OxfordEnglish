    {
      "type": "grammar",
      "id": "u12.d90.grammar",
      "title": {
        "en": "Present perfect",
        "ru": "Present perfect"
      },
      "ref": "present-perfect",
      "rule": {
        "en": "Present perfect = have/has + past participle (V3). We use it for actions that happened at some time before now, when the exact time is not important. Questions: Have/Has + subject + ever + V3? \"Have you ever watered a plant?\" Negatives: have/has + never/not + V3.",
        "ru": "Present perfect = have/has + третья форма глагола (V3). Используем для действий, которые произошли когда-то до настоящего, когда точное время не важно. Вопросы: Have/Has + подлежащее + ever + V3? «Have you ever watered a plant?» Отрицания: have/has + never/not + V3."
      },
      "patterns": [
        {
          "label": {
            "en": "affirmative",
            "ru": "утверждение"
          },
          "formula": "subject + have/has + V3",
          "examples": [
            {
              "en": "Kate has bought a plant.",
              "ru": "Кейт купила растение."
            },
            {
              "en": "Pol has poured his smoothie into it.",
              "ru": "Пол вылил в него свой смузи."
            }
          ],
          "ref": "present-perfect"
        },
        {
          "label": {
            "en": "negative / never",
            "ru": "отрицание / never"
          },
          "formula": "subject + have/has + never/not + V3",
          "examples": [
            {
              "en": "Den has never liked office plants.",
              "ru": "Ден никогда не любил офисные растения."
            },
            {
              "en": "Alex has not watered it.",
              "ru": "Алекс его не поливал."
            }
          ],
          "ref": "present-perfect"
        },
        {
          "label": {
            "en": "question with ever",
            "ru": "вопрос с ever"
          },
          "formula": "Have/Has + subject + ever + V3?",
          "examples": [
            {
              "en": "Have you ever watered this plant?",
              "ru": "Ты когда-нибудь поливал это растение?"
            },
            {
              "en": "Has Alex forgotten about it?",
              "ru": "Алекс забыл о нём?"
            }
          ],
          "ref": "present-perfect"
        }
      ],
      "pitfalls": [
        {
          "en": "Use the past participle, not the past simple: \"Kate has bought\", not \"Kate has buyed\".",
          "ru": "Используй третью форму, а не прошлую: «Kate has bought», а не «Kate has buyed»."
        },
        {
          "en": "After have/has use V3: \"has forgotten\", not \"has forgot\".",
          "ru": "После have/has — третья форма: «has forgotten», а не «has forgot»."
        },
        {
          "en": "With ever, word order is fixed: \"Have you ever watered...\", not \"Have you watered ever...\".",
          "ru": "С ever порядок слов фиксированный: «Have you ever watered...», а не «Have you watered ever...»."
        }
      ]
    },
    {
      "type": "reading",
      "id": "u12.d90.reading",
      "title": {
        "en": "The Dead Plant",
