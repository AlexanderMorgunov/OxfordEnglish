    {
      "type": "grammar",
      "id": "u03.d04.grammar",
      "title": {
        "en": "like/enjoy + -ing · want + to · to for purpose",
        "ru": "like/enjoy + -ing · want + to · to для цели"
      },
      "rule": {
        "en": "After like, love, enjoy, hate, prefer use verb + -ing. After want, need, would like use to + verb. Use to + verb to explain purpose (why).",
        "ru": "После like, love, enjoy, hate, prefer — глагол + -ing. После want, need, would like — to + глагол. Чтобы объяснить цель (зачем) — to + глагол."
      },
      "patterns": [
        {
          "label": {
            "en": "enjoy + -ing",
            "ru": "enjoy + -ing"
          },
          "formula": "enjoy/like + verb-ing",
          "examples": [
            {
              "en": "I enjoy coding.",
              "ru": "Мне нравится программировать."
            }
          ]
        },
        {
          "label": {
            "en": "want + to",
            "ru": "want + to"
          },
          "formula": "want/need + to + verb",
          "examples": [
            {
              "en": "I want to rest.",
              "ru": "Я хочу отдохнуть."
            }
          ]
        },
        {
          "label": {
            "en": "to (purpose)",
            "ru": "to (цель)"
          },
          "formula": "... to + verb (why)",
          "examples": [
            {
              "en": "I use Git to save my work.",
              "ru": "Я использую Git, чтобы сохранять работу."
            }
          ]
        }
      ],
      "pitfalls": [
        {
          "en": "After enjoy use -ing, not to: \"enjoy reading\", not \"enjoy to read\".",
          "ru": "После enjoy — -ing, не to: \"enjoy reading\", а не \"enjoy to read\"."
        },
        {
          "en": "After want use to: \"want to go\", not \"want going\".",
          "ru": "После want — to: \"want to go\", а не \"want going\"."
        }
      ]
    },
    {
      "type": "reading",
      "id": "u03.d04.reading",
      "title": {
        "en": "Why I code",
        "ru": "Почему я программирую"
      },
      "blocks": [
        {
          "id": "u03.d04.reading.b1",
          "en": "Leo enjoys building things. He likes learning new tools and he loves solving problems. In his free time he plays the guitar to relax.",
          "ru": "Лео нравится создавать. Ему нравится изучать новые инструменты, и он обожает решать задачи. В свободное время он играет на гитаре, чтобы расслабиться.",
          "audio": {
            "src": "media/audio/u03.d04.reading.b1.mp3",
            "license": {
              "type": "original",
              "attribution": "Project authors (LLM-assisted)"
            }
          }
        },
        {
          "id": "u03.d04.reading.b2",
          "en": "He doesn't like long meetings and he hates waiting for slow builds. But he wants to become a better developer, so he practises every evening.",
          "ru": "Ему не нравятся долгие встречи, и он ненавидит ждать медленные сборки. Но он хочет стать лучше как разработчик, поэтому занимается каждый вечер.",
          "audio": {
            "src": "media/audio/u03.d04.reading.b2.mp3",
            "license": {
              "type": "original",
              "attribution": "Project authors (LLM-assisted)"
            }
          }
        }
      ],
