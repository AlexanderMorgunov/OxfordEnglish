    {
      "type": "grammar",
      "id": "u13.d03.grammar",
      "title": {
        "en": "Relative clauses: who / which / that",
        "ru": "Относительные придаточные: who / which / that"
      },
      "rule": {
        "en": "Add information about a noun with a relative clause: \"who\" for people, \"which\" for things, \"that\" for both.",
        "ru": "Добавляй информацию к существительному придаточным: \"who\" — о людях, \"which\" — о вещах, \"that\" — о том и другом."
      },
      "patterns": [
        {
          "label": {
            "en": "who (people)",
            "ru": "who (люди)"
          },
          "formula": "the person who + verb",
          "examples": [
            {
              "en": "The man who helped me was kind.",
              "ru": "Человек, который мне помог, был добрым."
            }
          ],
          "ref": "relative-clauses"
        },
        {
          "label": {
            "en": "which (things)",
            "ru": "which (вещи)"
          },
          "formula": "the thing which + verb",
          "examples": [
            {
              "en": "This is the app which saves my work.",
              "ru": "Это приложение, которое сохраняет мою работу."
            }
          ],
          "ref": "relative-clauses"
        },
        {
          "label": {
            "en": "that (both)",
            "ru": "that (оба)"
          },
          "formula": "the … that + verb",
          "examples": [
            {
              "en": "A doctor is a person that helps you.",
              "ru": "Врач — это человек, который тебе помогает."
            }
          ],
          "ref": "relative-clauses"
        }
      ],
      "pitfalls": [
        {
          "en": "Use \"who\" for people, \"which\" for things; \"that\" works for both.",
          "ru": "\"who\" — для людей, \"which\" — для вещей; \"that\" — для обоих."
        },
        {
          "en": "Don't repeat the subject: \"the man who helped me\", not \"the man who he helped me\".",
          "ru": "Не дублируй подлежащее: \"the man who helped me\", а не \"the man who he helped me\"."
        }
      ]
    },
    {
      "type": "reading",
      "id": "u13.d03.reading",
      "title": {
        "en": "People who help",
        "ru": "Люди, которые помогают"
      },
      "blocks": [
        {
          "id": "u13.d03.reading.b1",
          "en": "A teacher is a person who helps you learn. A doctor is someone who helps you when you are ill. A friend is a person who is always there for you.",
          "ru": "Учитель — это человек, который помогает тебе учиться. Врач — тот, кто помогает, когда ты болен. Друг — человек, который всегда рядом.",
          "audio": {
            "src": "media/audio/u13.d03.reading.b1.mp3",
            "license": {
              "type": "original",
              "attribution": "Project authors (LLM-assisted)"
            }
          }
        },
        {
          "id": "u13.d03.reading.b2",
          "en": "A phone is a thing which connects people. The internet is an invention that changed the world. These are things that make life easier every day.",
          "ru": "Телефон — вещь, которая соединяет людей. Интернет — изобретение, которое изменило мир. Это вещи, которые каждый день упрощают жизнь.",
          "audio": {
            "src": "media/audio/u13.d03.reading.b2.mp3",
            "license": {
              "type": "original",
              "attribution": "Project authors (LLM-assisted)"
            }
          }
        }
      ],
      "glossary": [
        {
          "word": "connect",
