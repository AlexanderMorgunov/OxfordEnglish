    {
      "type": "grammar",
      "id": "u23.d01.grammar",
      "title": {
        "en": "used to",
        "ru": "used to"
      },
      "rule": {
        "en": "Use \"used to + verb\" for a habit or a state that was true in the past but is not true now. It is only for the past — there is no present form.",
        "ru": "Используй «used to + глагол» для привычки или состояния, которое было в прошлом, но не сейчас. Это только для прошлого — настоящей формы нет."
      },
      "patterns": [
        {
          "label": {
            "en": "past habit",
            "ru": "прошлая привычка"
          },
          "formula": "used to + verb",
          "examples": [
            {
              "en": "I used to play outside every day.",
              "ru": "Раньше я каждый день играл на улице."
            }
          ],
          "ref": "used-to"
        },
        {
          "label": {
            "en": "past state",
            "ru": "прошлое состояние"
          },
          "formula": "used to + be/have/like…",
          "examples": [
            {
              "en": "There used to be a shop here.",
              "ru": "Раньше здесь был магазин."
            }
          ],
          "ref": "used-to"
        },
        {
          "label": {
            "en": "negative / question",
            "ru": "отрицание / вопрос"
          },
          "formula": "didn't use to · Did you use to …?",
          "examples": [
            {
              "en": "I didn't use to like coffee. Did you use to smoke?",
              "ru": "Раньше я не любил кофе. Ты раньше курил?"
            }
          ],
          "ref": "used-to"
        }
      ],
      "pitfalls": [
        {
          "en": "In negatives and questions, drop the -d: \"didn't use to\", \"Did you use to…?\"",
          "ru": "В отрицании и вопросе теряется -d: «didn't use to», «Did you use to…?»"
        },
        {
          "en": "\"used to\" is only past — for a present habit use the present simple: \"I usually walk\".",
          "ru": "«used to» — только прошлое; для настоящей привычки — present simple: «I usually walk»."
        }
      ]
    },
    {
      "type": "reading",
      "id": "u23.d01.reading",
      "title": {
        "en": "How things were",
        "ru": "Как всё было"
      },
      "blocks": [
        {
          "id": "u23.d01.reading.b1",
          "en": "When my grandfather was young, life used to be very different. There didn't use to be televisions or phones. Children used to play in the streets until dark, and everyone used to know their neighbours.",
          "ru": "Когда мой дед был молод, жизнь была совсем другой. Раньше не было телевизоров и телефонов. Дети играли на улицах до темноты, и все знали своих соседей.",
          "audio": {
            "src": "media/audio/u23.d01.reading.b1.wav",
            "license": {
              "type": "original",
              "attribution": "Project authors (LLM-assisted)"
            }
          }
        },
        {
          "id": "u23.d01.reading.b2",
          "en": "\"We used to grow our own vegetables,\" he told me. \"And on Sundays, the whole family used to eat together.\" There used to be a small cinema in town, but it closed years ago. \"Things change,\" he said, \"but the memories stay.\"",
          "ru": "«Мы сами выращивали овощи, — рассказал он мне. — А по воскресеньям вся семья ела вместе». Раньше в городе был маленький кинотеатр, но он закрылся много лет назад. «Всё меняется, — сказал он, — но воспоминания остаются».",
          "audio": {
            "src": "media/audio/u23.d01.reading.b2.wav",
            "license": {
              "type": "original",
              "attribution": "Project authors (LLM-assisted)"
            }
          }
        }
      ],
      "glossary": [
