    {
      "type": "grammar",
      "id": "u27.d05.grammar",
      "title": {
        "en": "Past modals — review",
        "ru": "Прошлые модальные — обзор"
      },
      "rule": {
        "en": "All past modals are modal + have + V3. Regret: should(n’t) have. Deduction: must / can’t / might have. Unnecessary: needn’t have. Imagined: would / could have.",
        "ru": "Все прошлые модальные — модальный + have + V3. Сожаление: should(n’t) have. Дедукция: must / can’t / might have. Зря: needn’t have. Воображение: would / could have."
      },
      "patterns": [
        {
          "label": {
            "en": "regret / criticism",
            "ru": "сожаление / критика"
          },
          "formula": "should(n’t) have + V3",
          "examples": [
            {
              "en": "I should have saved it.",
              "ru": "Мне стоило это сохранить."
            }
          ],
          "ref": "past-modals"
        },
        {
          "label": {
            "en": "deduction",
            "ru": "дедукция"
          },
          "formula": "must / can’t / might have + V3",
          "examples": [
            {
              "en": "He must have forgotten.",
              "ru": "Он, должно быть, забыл."
            }
          ],
          "ref": "past-modals"
        },
        {
          "label": {
            "en": "imagined / unnecessary",
            "ru": "воображение / зря"
          },
          "formula": "would / could / needn’t have + V3",
          "examples": [
            {
              "en": "You needn’t have worried.",
              "ru": "Не нужно было волноваться."
            }
          ],
          "ref": "past-modals"
        }
      ],
      "pitfalls": [
        {
          "en": "Never \"should of / would of / could of\" — always \"have\".",
          "ru": "Никогда «should of / would of / could of» — всегда «have»."
        },
        {
          "en": "\"can’t have\" (sure not), not \"mustn’t have\", for a past deduction.",
          "ru": "Для дедукции о прошлом «can’t have» (уверен, что нет), не «mustn’t have»."
        }
      ]
    },
    {
      "type": "reading",
      "id": "u27.d05.reading",
      "title": {
        "en": "A year later",
        "ru": "Год спустя"
      },
      "blocks": [
        {
          "id": "u27.d05.reading.b1",
          "en": "A year after I quit, I can finally reflect honestly. I should have negotiated instead of leaving so fast — that was foolish. But I couldn’t have stayed either; I was miserable. Overall, I think I made the right call.",
          "ru": "Через год после ухода я наконец могу честно поразмышлять. Мне стоило договориться, а не уходить так быстро — это было глупо. Но и остаться я не мог; я был несчастен. В целом, думаю, я поступил правильно.",
          "audio": {
            "src": "media/audio/u27.d05.reading.b1.mp3",
            "license": {
              "type": "original",
              "attribution": "Project authors (LLM-assisted)"
            }
          }
        },
        {
          "id": "u27.d05.reading.b2",
          "en": "My old boss must have been surprised — I never explained. I needn’t have worried about references, though; they were kind. With perspective, I see the growth. I wouldn’t have changed careers if I’d stayed comfortable.",
          "ru": "Мой бывший начальник, должно быть, удивился — я так и не объяснил. Хотя зря я переживал о рекомендациях; они были добры. С расстояния я вижу рост. Я бы не сменил профессию, если бы остался в зоне комфорта.",
          "audio": {
            "src": "media/audio/u27.d05.reading.b2.mp3",
            "license": {
              "type": "original",
              "attribution": "Project authors (LLM-assisted)"
            }
          }
        }
      ],
      "glossary": [
        {
          "word": "negotiate",
          "ru": "договариваться",
          "ipa": "/nɪˈɡəʊʃieɪt/"
        },
        {
          "word": "miserable",
          "ru": "несчастный",
          "ipa": "/ˈmɪzrəbl/"
        }
      ]
    },
