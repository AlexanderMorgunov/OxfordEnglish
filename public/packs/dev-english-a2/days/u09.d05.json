        {
          "start": 0,
          "end": 3,
          "en": "How much are these shoes?",
          "ru": "Сколько стоит эта обувь?"
        },
        {
          "start": 3,
          "end": 6,
          "en": "They're thirty pounds. Would you like to try them on?",
          "ru": "Тридцать фунтов. Хотите примерить?"
        },
        {
          "start": 6,
          "end": 9,
          "en": "Yes... They fit well. I'll take them.",
          "ru": "Да... Хорошо сидят. Я беру."
        },
        {
          "start": 9,
          "end": 12,
          "en": "Great. Can you pay by card? Here's your receipt.",
          "ru": "Отлично. Оплатите картой? Вот ваш чек."
        }
      ],
