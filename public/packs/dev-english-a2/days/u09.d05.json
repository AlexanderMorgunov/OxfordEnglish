    {
      "type": "grammar",
      "id": "u09.d05.grammar",
      "title": {
        "en": "Shopping & paying",
        "ru": "Покупки и оплата"
      },
      "rule": {
        "en": "Ask the price with \"How much is it?\". Ask to try with \"Can I try this on?\". Decide with \"I'll take it\". Pay with \"Can I pay by card / in cash?\".",
        "ru": "Цена — \"How much is it?\". Примерка — \"Can I try this on?\". Решение — \"I'll take it\". Оплата — \"Can I pay by card / in cash?\"."
      },
      "patterns": [
        {
          "label": {
            "en": "price / try",
            "ru": "цена / примерка"
          },
          "formula": "How much is it? · Can I try it on?",
          "examples": [
            {
              "en": "How much is this shirt? Can I try it on?",
              "ru": "Сколько стоит эта рубашка? Можно примерить?"
            }
          ]
        },
        {
          "label": {
            "en": "decide",
            "ru": "решение"
          },
          "formula": "I'll take it / them.",
          "examples": [
            {
              "en": "It fits well. I'll take it.",
              "ru": "Хорошо сидит. Я беру."
            }
          ]
        },
        {
          "label": {
            "en": "pay",
            "ru": "оплата"
          },
          "formula": "Can I pay by card / in cash?",
          "examples": [
            {
              "en": "Can I pay by card? Here is your receipt.",
              "ru": "Можно картой? Вот ваш чек."
            }
          ]
        }
      ],
      "pitfalls": [
        {
          "en": "Say \"pay by card\" but \"pay in cash\".",
          "ru": "Говори \"pay by card\", но \"pay in cash\"."
        },
        {
          "en": "\"How much is it?\" for price, \"How many?\" for number.",
          "ru": "\"How much is it?\" — о цене, \"How many?\" — о количестве."
        }
      ]
    },
    {
      "type": "reading",
      "id": "u09.d05.reading",
      "title": {
        "en": "Buying a shirt",
        "ru": "Покупаем рубашку"
      },
      "blocks": [
        {
          "id": "u09.d05.reading.b1",
          "en": "\"How much is this shirt?\" \"It's twenty pounds.\" \"Can I try it on?\" \"Yes, the fitting room is over there.\" The shirt was a good size and colour.",
          "ru": "«Сколько стоит эта рубашка?» «Двадцать фунтов». «Можно примерить?» «Да, примерочная вон там». Рубашка была подходящего размера и цвета.",
          "audio": {
            "src": "media/audio/u09.d05.reading.b1.mp3",
            "license": {
              "type": "original",
              "attribution": "Project authors (LLM-assisted)"
            }
          }
        },
        {
          "id": "u09.d05.reading.b2",
          "en": "\"It fits well. I'll take it.\" \"Cash or card?\" \"By card, please.\" \"Here is your receipt. Do you want a bag?\" \"Yes, please. Thank you!\"",
          "ru": "«Хорошо сидит. Беру». «Наличные или карта?» «Картой, пожалуйста». «Вот ваш чек. Пакет нужен?» «Да, спасибо!»",
          "audio": {
            "src": "media/audio/u09.d05.reading.b2.mp3",
            "license": {
              "type": "original",
              "attribution": "Project authors (LLM-assisted)"
            }
          }
        }
      ],
      "glossary": [
        {
          "word": "pound",
