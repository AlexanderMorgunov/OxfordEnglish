    {
      "type": "grammar",
      "id": "u23.d03.grammar",
      "title": {
        "en": "be used to / get used to",
        "ru": "be used to / get used to"
      },
      "rule": {
        "en": "\"be used to + -ing/noun\" means you are ACCUSTOMED to something (it feels normal now). \"get used to\" means you are becoming accustomed. Note the -ing form, not the bare verb.",
        "ru": "«be used to + -ing/существительное» значит, что ты ПРИВЫК к чему-то (теперь это нормально). «get used to» — привыкаешь. Внимание: форма -ing, а не голый глагол."
      },
      "patterns": [
        {
          "label": {
            "en": "be used to + -ing",
            "ru": "be used to + -ing"
          },
          "formula": "am/is/are used to + verb-ing/noun",
          "examples": [
            {
              "en": "I'm used to getting up early.",
              "ru": "Я привык рано вставать."
            }
          ],
          "ref": "used-to"
        },
        {
          "label": {
            "en": "get used to (become)",
            "ru": "get used to (привыкать)"
          },
          "formula": "get used to + verb-ing/noun",
          "examples": [
            {
              "en": "She's getting used to the cold.",
              "ru": "Она привыкает к холоду."
            }
          ],
          "ref": "used-to"
        },
        {
          "label": {
            "en": "not used to",
            "ru": "не привык"
          },
          "formula": "not used to + -ing/noun",
          "examples": [
            {
              "en": "I'm not used to driving here.",
              "ru": "Я не привык здесь водить."
            }
          ],
          "ref": "used-to"
        }
      ],
      "pitfalls": [
        {
          "en": "\"be used to\" + -ing or a noun, NOT the bare verb: \"used to living\", not \"used to live\".",
          "ru": "«be used to» + -ing или существительное, НЕ голый глагол: «used to living», а не «used to live»."
        },
        {
          "en": "Do not confuse with \"used to + verb\" (past habit): \"I used to live\" vs \"I'm used to living\".",
          "ru": "Не путай с «used to + глагол» (прошлая привычка): «I used to live» и «I'm used to living»."
        }
      ]
    },
    {
      "type": "reading",
      "id": "u23.d03.reading",
      "title": {
        "en": "A new country",
        "ru": "Новая страна"
      },
      "blocks": [
        {
          "id": "u23.d03.reading.b1",
          "en": "When Elena first moved to Norway, everything felt strange. She wasn't used to the long, dark winters, and she wasn't used to eating dinner so early. \"At first, I couldn't get used to the silence,\" she said.",
          "ru": "Когда Елена только переехала в Норвегию, всё казалось странным. Она не привыкла к долгим тёмным зимам и к такому раннему ужину. «Сначала я никак не могла привыкнуть к тишине», — сказала она.",
          "audio": {
            "src": "media/audio/u23.d03.reading.b1.mp3",
            "license": {
              "type": "original",
              "attribution": "Project authors (LLM-assisted)"
            }
          }
        },
        {
          "id": "u23.d03.reading.b2",
          "en": "But gradually, she adapted. \"Now I'm used to the cold, and I'm even getting used to skiing to work! It's funny how you get used to almost anything. This place used to feel foreign, but now it feels like home.\"",
          "ru": "Но постепенно она приспособилась. «Теперь я привыкла к холоду и даже привыкаю ездить на работу на лыжах! Забавно, как ко всему привыкаешь. Раньше это место казалось чужим, а теперь ощущается как дом».",
          "audio": {
            "src": "media/audio/u23.d03.reading.b2.mp3",
            "license": {
              "type": "original",
              "attribution": "Project authors (LLM-assisted)"
            }
          }
        }
      ],
      "glossary": [
        {
          "word": "foreign",
