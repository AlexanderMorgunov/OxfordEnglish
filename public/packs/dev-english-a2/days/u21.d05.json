    {
      "type": "grammar",
      "id": "u21.d05.grammar",
      "title": {
        "en": "Arranging to meet",
        "ru": "Как договориться о встрече"
      },
      "rule": {
        "en": "To arrange plans, ask \"Are you free…?\" or \"Does … suit you?\", suggest a time, and confirm. Use the present continuous for the arrangement you make.",
        "ru": "Чтобы договориться: спроси «Are you free…?» или «Does … suit you?», предложи время и подтверди. Для договорённости используй present continuous."
      },
      "patterns": [
        {
          "label": {
            "en": "ask about free time",
            "ru": "спросить о свободном времени"
          },
          "formula": "Are you free …? / Does … suit you?",
          "examples": [
            {
              "en": "Are you free on Friday?",
              "ru": "Ты свободен в пятницу?"
            }
          ]
        },
        {
          "label": {
            "en": "suggest / confirm",
            "ru": "предложить / подтвердить"
          },
          "formula": "How about …? / Let's say …",
          "examples": [
            {
              "en": "How about seven? — Great, let's say seven.",
              "ru": "Как насчёт семи? — Отлично, договорились на семь."
            }
          ],
          "ref": "future-forms"
        },
        {
          "label": {
            "en": "the arrangement",
            "ru": "договорённость"
          },
          "formula": "So we're meeting at …",
          "examples": [
            {
              "en": "So we're meeting at seven on Friday.",
              "ru": "Итак, встречаемся в семь в пятницу."
            }
          ],
          "ref": "future-forms"
        }
      ],
      "pitfalls": [
        {
          "en": "Use present continuous for a fixed arrangement: \"We're meeting at seven\".",
          "ru": "Для назначенной встречи — present continuous: «We're meeting at seven»."
        },
        {
          "en": "\"Does Monday suit you?\" is a natural way to check a time.",
          "ru": "«Does Monday suit you?» — естественный способ уточнить время."
        }
      ]
    },
    {
      "type": "reading",
      "id": "u21.d05.reading",
      "title": {
        "en": "Finding a time",
        "ru": "Ищем время"
      },
      "blocks": [
        {
          "id": "u21.d05.reading.b1",
          "en": "\"Let's meet up this week,\" said Tom. \"Are you free on Tuesday?\" \"Tuesday doesn't suit me,\" said Amy. \"I'm working late. How about Thursday?\" \"Thursday's perfect. What time suits you?\"",
          "ru": "«Давай встретимся на этой неделе, — сказал Том. — Ты свободна во вторник?» «Вторник мне не подходит, — сказала Эми. — Я работаю допоздна. Как насчёт четверга?» «Четверг отлично. Во сколько тебе удобно?»",
          "audio": {
            "src": "media/audio/u21.d05.reading.b1.mp3",
            "license": {
              "type": "original",
              "attribution": "Project authors (LLM-assisted)"
            }
          }
        },
        {
          "id": "u21.d05.reading.b2",
          "en": "\"Let's say six at the café near the station.\" \"Great, I'll put it in my calendar. So we're meeting on Thursday at six — I'll confirm in the morning.\" \"Perfect. See you then!\"",
          "ru": "«Давай в шесть в кафе у станции». «Отлично, запишу в календарь. Итак, встречаемся в четверг в шесть — подтвержу утром». «Отлично. До встречи!»",
          "audio": {
            "src": "media/audio/u21.d05.reading.b2.mp3",
            "license": {
              "type": "original",
              "attribution": "Project authors (LLM-assisted)"
            }
          }
        }
      ],
      "glossary": [
        {
          "word": "near",
          "ru": "рядом с",
          "ipa": "/nɪər/"
        },
        {
          "word": "perfect",
          "ru": "идеальный",
          "ipa": "/ˈpɜːrfɪkt/"
        }
      ]
    },
