      "blocks": [
        {
          "id": "a13.d02.reading.b1",
          "en": "\"Do you work here?\" \"Yes, I do. I work in this office.\"",
          "ru": "«Ты здесь работаешь?» «Да. Я работаю в этом офисе.»",
          "audio": {
