        },
        {
          "id": "a13.d02.reading.b2",
          "en": "\"Where do you live?\" \"I live near the office. I don't drive; I walk.\"",
          "ru": "«Где ты живёшь?» «Я живу рядом с офисом. Я не езжу на машине; я хожу пешком.»",
          "audio": {
            "src": "media/audio/a13.d02.reading.b2.mp3",
            "license": {
              "type": "original",
              "attribution": "Project authors (LLM-assisted)"
            }
          }
        },
        {
          "id": "a13.d02.reading.b3",
          "en": "Ben doesn't work at the weekend. He doesn't get up early on Sunday.",
          "ru": "Бен не работает на выходных. В воскресенье он не встаёт рано.",
          "audio": {
            "src": "media/audio/a13.d02.reading.b3.mp3",
            "license": {
              "type": "original",
              "attribution": "Project authors (LLM-assisted)"
            }
          }
        }
      ],
      "glossary": [
        {
          "word": "to walk",
