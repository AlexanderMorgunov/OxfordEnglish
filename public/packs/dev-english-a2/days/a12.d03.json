    {
      "type": "grammar",
      "id": "a12.d03.grammar",
      "title": {
        "en": "there is / there are",
        "ru": "there is / there are (есть, имеется)"
      },
      "ref": "there-is",
      "rule": {
        "en": "Use There is for ONE thing and There are for MORE than one to say what exists in a place. Negative: There isn't / There aren't. Question: Is there…? / Are there…? With plural things use some (There are some chairs) and any in questions/negatives (Is there any…?).",
        "ru": "There is — для ОДНОГО, There are — для НЕСКОЛЬКИХ: что есть в месте. Отрицание: There isn't / There aren't. Вопрос: Is there…? / Are there…? С множественным — some (There are some chairs), в вопросах/отрицаниях — any (Is there any…?)."
      },
      "patterns": [
        {
          "label": {
            "en": "There is (one)",
            "ru": "There is (один)"
          },
          "formula": "There is + a/one + singular",
          "examples": [
            {
              "en": "There is a kitchen.",
              "ru": "Здесь есть кухня."
            },
            {
              "en": "There is one bathroom.",
              "ru": "Здесь одна ванная."
            }
          ]
        },
        {
          "label": {
            "en": "There are (many)",
            "ru": "There are (много)"
          },
          "formula": "There are + number/some + plural",
          "examples": [
            {
              "en": "There are two bedrooms.",
              "ru": "Здесь две спальни."
            },
            {
              "en": "There are some chairs.",
              "ru": "Здесь есть стулья."
            }
          ]
        },
        {
          "label": {
            "en": "Question & negative",
            "ru": "Вопрос и отрицание"
          },
          "formula": "Is/Are there…? · There isn't/aren't…",
          "examples": [
            {
              "en": "Is there a garden?",
              "ru": "Здесь есть сад?"
            },
            {
              "en": "There aren't any windows.",
              "ru": "Здесь нет окон."
            }
          ]
        }
      ],
      "pitfalls": [
        {
          "en": "One → There is; many → There are.",
          "ru": "Один → There is; много → There are."
        },
        {
          "en": "Question starts with Is/Are there…?, not \"There is…?\".",
          "ru": "Вопрос начинается с Is/Are there…?, а не «There is…?»."
        }
      ]
    },
