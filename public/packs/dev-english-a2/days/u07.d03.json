    {
      "type": "grammar",
      "id": "u07.d03.grammar",
      "title": {
        "en": "Ordering: a / some / would like",
        "ru": "Заказ: a / some / would like"
      },
      "rule": {
        "en": "Order with \"I'd like…\". Use \"a/an\" for one countable thing, \"some\" for uncountable or plural.",
        "ru": "Заказывай через \"I'd like…\". \"a/an\" — для одного исчисляемого, \"some\" — для неисчисляемого или множественного."
      },
      "patterns": [
        {
          "label": {
            "en": "a / an",
            "ru": "a / an"
          },
          "formula": "I'd like a + countable",
          "examples": [
            {
              "en": "I'd like a sandwich.",
              "ru": "Мне сэндвич."
            }
          ]
        },
        {
          "label": {
            "en": "some",
            "ru": "some"
          },
          "formula": "I'd like some + uncountable",
          "examples": [
            {
              "en": "I'd like some water.",
              "ru": "Мне воды."
            }
          ]
        }
      ],
      "pitfalls": [
        {
          "en": "Uncountable food takes \"some\", not \"a\": \"some soup\", not \"a soup\".",
          "ru": "С неисчисляемой едой — \"some\", не \"a\": \"some soup\", а не \"a soup\"."
        }
      ]
    },
    {
      "type": "reading",
      "id": "u07.d03.reading",
      "title": {
        "en": "Lunch with a friend",
        "ru": "Обед с другом"
      },
      "blocks": [
        {
          "id": "u07.d03.reading.b1",
          "en": "It was one o'clock, so my friend and I went to a café for lunch. The waiter gave us the menu and a glass of water.",
          "ru": "Был час дня, и мы с другом пошли в кафе на обед. Официант дал нам меню и стакан воды.",
          "audio": {
            "src": "media/audio/u07.d03.reading.b1.mp3",
            "license": {
              "type": "original",
              "attribution": "Project authors (LLM-assisted)"
            }
          }
        },
        {
          "id": "u07.d03.reading.b2",
          "en": "I ordered a cheese sandwich and a coffee. My friend had soup and a fresh salad. The food was delicious. After lunch, I asked the waiter for the bill.",
          "ru": "Я заказал сэндвич с сыром и кофе. Друг взял суп и свежий салат. Еда была вкусной. После обеда я попросил у официанта счёт.",
          "audio": {
            "src": "media/audio/u07.d03.reading.b2.mp3",
            "license": {
              "type": "original",
              "attribution": "Project authors (LLM-assisted)"
            }
          }
        }
      ],
