    {
      "type": "grammar",
      "id": "u10.d03.grammar",
      "title": {
        "en": "will vs going to · present continuous for arrangements",
        "ru": "will vs going to · present continuous для договорённостей"
      },
      "rule": {
        "en": "Use \"going to\" for a plan you already have, \"will\" for a decision you make now. Use the present continuous for fixed arrangements with a time or place.",
        "ru": "\"going to\" — план, который уже есть; \"will\" — решение прямо сейчас. Present continuous — договорённость с указанием времени/места."
      },
      "patterns": [
        {
          "label": {
            "en": "going to (plan)",
            "ru": "going to (план)"
          },
          "formula": "be going to + verb",
          "examples": [
            {
              "en": "We are going to paint the flat.",
              "ru": "Мы собираемся покрасить квартиру."
            }
          ]
        },
        {
          "label": {
            "en": "will (now)",
            "ru": "will (сейчас)"
          },
          "formula": "I'll + verb (decide now)",
          "examples": [
            {
              "en": "The phone is ringing. I'll get it.",
              "ru": "Телефон звонит. Я возьму."
            }
          ]
        },
        {
          "label": {
            "en": "arrangement",
            "ru": "договорённость"
          },
          "formula": "am/is/are + -ing + time",
          "examples": [
            {
              "en": "I'm meeting Tom at six on Friday.",
              "ru": "Я встречаюсь с Томом в шесть в пятницу."
            }
          ]
        }
      ],
      "pitfalls": [
        {
          "en": "For a fixed arrangement with a time, the present continuous is natural: \"I'm seeing the doctor at 3\".",
          "ru": "Для назначенной встречи со временем естественен present continuous: \"I'm seeing the doctor at 3\"."
        },
        {
          "en": "A decision at the moment of speaking = will, not going to.",
          "ru": "Решение в момент речи = will, не going to."
        }
      ]
    },
