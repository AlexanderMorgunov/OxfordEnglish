    {
      "type": "grammar",
      "id": "a11.d02.grammar",
      "title": {
        "en": "The verb be: negatives and questions",
        "ru": "Глагол be: отрицания и вопросы"
      },
      "ref": "verb-be",
      "rule": {
        "en": "To make a negative, put not after be: I am not, he is not (isn't), they are not (aren't). To make a yes/no question, put be BEFORE the person: Am I…? Is he…? Are you…? Short answers keep be: Yes, I am. / No, he isn't.",
        "ru": "Для отрицания ставим not после be: I am not, he is not (isn't), they are not (aren't). Для вопроса «да/нет» ставим be ПЕРЕД лицом: Am I…? Is he…? Are you…? В коротком ответе be сохраняется: Yes, I am. / No, he isn't."
      },
      "patterns": [
        {
          "label": {
            "en": "Negative: be + not",
            "ru": "Отрицание: be + not"
          },
          "formula": "subject + be + not",
          "examples": [
            {
              "en": "I'm not a doctor.",
              "ru": "Я не врач."
            },
            {
              "en": "He isn't from England.",
              "ru": "Он не из Англии."
            }
          ]
        },
        {
          "label": {
            "en": "Yes/No question: be first",
            "ru": "Вопрос да/нет: be впереди"
          },
          "formula": "be + subject + …?",
          "examples": [
            {
              "en": "Are you a student?",
              "ru": "Ты студент?"
            },
            {
              "en": "Is she a teacher?",
              "ru": "Она учитель?"
            }
          ]
        },
        {
          "label": {
            "en": "Short answers",
            "ru": "Короткие ответы"
          },
          "formula": "Yes, subject + be. / No, subject + be + n't.",
          "examples": [
            {
              "en": "Yes, I am. / No, I'm not.",
              "ru": "Да. / Нет."
            },
            {
              "en": "Yes, he is. / No, he isn't.",
              "ru": "Да. / Нет."
            }
          ]
        }
      ],
      "pitfalls": [
        {
          "en": "Question word order: \"Are you…?\", not \"You are…?\"",
          "ru": "Порядок слов в вопросе: «Are you…?», а не «You are…?»."
        },
        {
          "en": "Keep be in the short answer: \"Yes, I am\", not just \"Yes\".",
          "ru": "В коротком ответе оставляем be: «Yes, I am», а не просто «Yes»."
        }
      ]
    },
