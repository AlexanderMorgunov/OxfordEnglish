    {
      "type": "grammar",
      "id": "u06.d02.grammar",
      "title": {
        "en": "Prepositions of place",
        "ru": "Предлоги места"
      },
      "rule": {
        "en": "Say where things are with prepositions: in, on, under, behind, in front of, next to, between.",
        "ru": "Где находятся предметы — предлогами: in, on, under, behind, in front of, next to, between."
      },
      "patterns": [
        {
          "label": {
            "en": "in / on / under",
            "ru": "in / on / under"
          },
          "formula": "in a box · on the table · under the bed",
          "examples": [
            {
              "en": "The keys are on the table.",
              "ru": "Ключи на столе."
            }
          ]
        },
        {
          "label": {
            "en": "next to / between",
            "ru": "next to / between"
          },
          "formula": "next to X · between X and Y",
          "examples": [
            {
              "en": "The lamp is next to the bed.",
              "ru": "Лампа рядом с кроватью."
            }
          ]
        },
        {
          "label": {
            "en": "behind / in front of",
            "ru": "behind / in front of"
          },
          "formula": "behind X · in front of X",
          "examples": [
            {
              "en": "The car is in front of the house.",
              "ru": "Машина перед домом."
            }
          ]
        }
      ],
      "pitfalls": [
        {
          "en": "Use \"on\" for surfaces, \"in\" for closed spaces: \"on the wall\", \"in the box\".",
          "ru": "\"on\" — для поверхностей, \"in\" — для закрытых пространств: \"on the wall\", \"in the box\"."
        },
        {
          "en": "\"between\" needs two things: \"between the sofa and the wall\".",
          "ru": "\"between\" — между двумя предметами: \"between the sofa and the wall\"."
        }
      ]
    },
    {
