    {
      "type": "grammar",
      "id": "u14.d04.grammar",
      "title": {
        "en": "Which tense?",
        "ru": "Какое время?"
      },
      "rule": {
        "en": "Choose the tense from the meaning: routine → present simple, now → present continuous, finished past → past simple, experience → present perfect.",
        "ru": "Выбирай время по смыслу: привычка → present simple, сейчас → present continuous, законченное прошлое → past simple, опыт → present perfect."
      },
      "patterns": [
        {
          "label": {
            "en": "now vs usually",
            "ru": "сейчас vs обычно"
          },
          "formula": "am -ing vs verb(s)",
          "examples": [
            {
              "en": "I usually walk, but now I am driving.",
              "ru": "Обычно я хожу пешком, но сейчас еду за рулём."
            }
          ],
          "ref": "present-vs-continuous"
        },
        {
          "label": {
            "en": "past vs perfect",
            "ru": "past vs perfect"
          },
          "formula": "V2 (when) vs have V3 (ever)",
          "examples": [
            {
              "en": "I saw it yesterday. I have seen it before.",
              "ru": "Я видел это вчера. Я видел это раньше."
            }
          ],
          "ref": "perfect-vs-past"
        },
        {
          "label": {
            "en": "future",
            "ru": "будущее"
          },
          "formula": "going to / will / -ing",
          "examples": [
            {
              "en": "I'm meeting Tom at six. It will be fun.",
              "ru": "Я встречаюсь с Томом в шесть. Будет весело."
            }
          ],
          "ref": "future-forms"
        }
      ],
      "pitfalls": [
        {
          "en": "Stative verbs (know, like) stay simple, not continuous.",
          "ru": "Глаголы состояния (know, like) — в simple, не в continuous."
        },
        {
          "en": "A time word (yesterday, ever, now) is your best clue for the tense.",
          "ru": "Слово времени (yesterday, ever, now) — лучшая подсказка для времени."
        }
      ]
    },
