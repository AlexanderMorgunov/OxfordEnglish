    {
      "type": "grammar",
      "id": "u24.d04.grammar",
      "title": {
        "en": "It is said that / He is said to",
        "ru": "It is said that / He is said to"
      },
      "rule": {
        "en": "To report what people generally believe or say, without naming them, use \"It is said/believed/thought that…\" or \"He/She is said/believed to…\". Common with news and science.",
        "ru": "Чтобы передать, что люди в целом думают или говорят, не называя их, используй «It is said/believed/thought that…» или «He/She is said/believed to…». Часто в новостях и науке."
      },
      "patterns": [
        {
          "label": {
            "en": "It is said that + clause",
            "ru": "It is said that + предложение"
          },
          "formula": "It is said/believed/thought that …",
          "examples": [
            {
              "en": "It is said that the castle is haunted.",
              "ru": "Говорят, что в замке водятся привидения."
            }
          ],
          "ref": "passive-report"
        },
        {
          "label": {
            "en": "He is said to + verb",
            "ru": "He is said to + глагол"
          },
          "formula": "subject + is said/believed to + verb",
          "examples": [
            {
              "en": "She is believed to be very rich.",
              "ru": "Считается, что она очень богата."
            }
          ],
          "ref": "passive-report"
        },
        {
          "label": {
            "en": "is expected to / known to",
            "ru": "is expected to / known to"
          },
          "formula": "is expected/known to + verb",
          "examples": [
            {
              "en": "The team is expected to win.",
              "ru": "Ожидается, что команда победит."
            }
          ],
          "ref": "passive-report"
        }
      ],
      "pitfalls": [
        {
          "en": "\"It is said THAT + clause\" but \"He is said TO + verb\".",
          "ru": "«It is said THAT + предложение», но «He is said TO + глагол»."
        },
        {
          "en": "Use these to sound objective — you report a belief without saying whose.",
          "ru": "Так звучишь объективно — передаёшь мнение, не называя чьё."
        }
      ]
    },
    {
      "type": "reading",
      "id": "u24.d04.reading",
      "title": {
        "en": "The mystery island",
        "ru": "Загадочный остров"
      },
      "blocks": [
        {
          "id": "u24.d04.reading.b1",
          "en": "It is said that a small island in the Pacific holds a great secret. It is believed that treasure was hidden there hundreds of years ago. The island is thought to be dangerous, and few people are allowed to visit.",
          "ru": "Говорят, что маленький остров в Тихом океане хранит большую тайну. Считается, что сотни лет назад там спрятали сокровища. Остров считают опасным, и мало кому разрешают его посещать.",
          "audio": {
            "src": "media/audio/u24.d04.reading.b1.wav",
            "license": {
              "type": "original",
              "attribution": "Project authors (LLM-assisted)"
            }
          }
        },
        {
          "id": "u24.d04.reading.b2",
          "en": "One local man is known to have searched for the treasure for forty years. He is said to have found old maps, but nothing more. \"It is estimated that thousands have tried,\" a historian explained. \"But the secret is still believed to be safe.\"",
          "ru": "Известно, что один местный житель искал сокровища сорок лет. Говорят, он нашёл старые карты, но не более того. «По оценкам, пытались тысячи, — объяснил историк. — Но тайна, как считают, всё ещё в сохранности».",
          "audio": {
            "src": "media/audio/u24.d04.reading.b2.wav",
            "license": {
              "type": "original",
              "attribution": "Project authors (LLM-assisted)"
            }
          }
        }
      ],
      "glossary": [
        {
          "word": "treasure",
          "ru": "сокровище",
          "ipa": "/ˈtreʒər/"
        },
        {
          "word": "historian",
