    {
      "type": "grammar",
      "id": "u12.d03.grammar",
      "title": {
        "en": "for / since",
        "ru": "for / since"
      },
      "rule": {
        "en": "With the present perfect, use \"for\" + a period of time and \"since\" + a point in time to say how long.",
        "ru": "С present perfect: \"for\" + промежуток времени, \"since\" + момент во времени — чтобы сказать, как долго."
      },
      "patterns": [
        {
          "label": {
            "en": "for + period",
            "ru": "for + промежуток"
          },
          "formula": "for + two years / a week",
          "examples": [
            {
              "en": "I have lived here for five years.",
              "ru": "Я живу здесь пять лет."
            }
          ],
          "ref": "present-perfect-signals"
        },
        {
          "label": {
            "en": "since + point",
            "ru": "since + момент"
          },
          "formula": "since + 2020 / Monday",
          "examples": [
            {
              "en": "I have known her since 2015.",
              "ru": "Я знаю её с 2015 года."
            }
          ],
          "ref": "present-perfect-signals"
        },
        {
          "label": {
            "en": "How long…?",
            "ru": "How long…?"
          },
          "formula": "How long have you …?",
          "examples": [
            {
              "en": "How long have you worked here?",
              "ru": "Как долго ты здесь работаешь?"
            }
          ],
          "ref": "present-perfect-signals"
        }
      ],
      "pitfalls": [
        {
          "en": "\"for\" + length (for two hours); \"since\" + start point (since Monday).",
          "ru": "\"for\" + длительность (for two hours); \"since\" + начало (since Monday)."
        },
        {
          "en": "Use the present perfect, not present simple: \"I have lived here for years\".",
          "ru": "Используй present perfect, не present simple: \"I have lived here for years\"."
        }
      ]
    },
    {
      "type": "reading",
