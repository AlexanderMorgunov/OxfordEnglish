  "grammar": {
    "title": {
      "en": "Past simple vs past continuous",
      "ru": "Past simple и past continuous"
    },
    "ref": "narrative-tenses",
    "rule": {
      "en": "Use the past continuous (was/were + -ing) for actions that were in progress in the past. Use the past simple for short events that happened suddenly.",
      "ru": "Используйте Past Continuous (was/were + -ing) для действий, которые продолжались в прошлом. Используйте Past Simple для коротких событий, которые произошли внезапно."
    },
    "patterns": [
      {
        "label": {
          "en": "Background action + interruption",
          "ru": "Действие в процессе + прерывание"
        },
        "formula": "While I was doing..., something happened.",
        "examples": [
          {
            "en": "While they were going up, the lift stopped.",
            "ru": "Пока они поднимались, лифт остановился."
          }
        ],
        "ref": "narrative-tenses"
      },
      {
        "label": {
          "en": "Two actions at the same time",
          "ru": "Два одновременных действия"
        },
        "formula": "X was doing... while Y was doing...",
        "examples": [
          {
            "en": "Pol was doing yoga while Alex was sleeping.",
            "ru": "Пол занимался йогой, пока Алекс спал."
          }
        ],
        "ref": "narrative-tenses"
      },
      {
        "label": {
          "en": "Action in progress + short event",
          "ru": "Процесс + короткое событие"
        },
        "formula": "X was... when Y happened.",
        "examples": [
          {
            "en": "Valery was looking at his watch when the alarm rang.",
            "ru": "Валерий смотрел на часы, когда зазвенел сигнал."
          }
        ],
        "ref": "narrative-tenses"
      }
    ],
    "pitfalls": [
      {
        "en": "Do not use the past continuous for finished actions. Say 'I ate lunch', not 'I was eating lunch' if it is a finished fact.",
        "ru": "Не используйте Past Continuous для законченных действий. Говорите 'I ate lunch', а не 'I was eating lunch', если действие завершено."
      },
      {
        "en": "With 'when' we often use the past simple for the new short action and the past continuous for the background action.",
        "ru": "С 'when' часто используем Past Simple для нового короткого действия, а Past Continuous для фонового."
      }
    ]
  },
  "reading": {
    "title": {
      "en": "Stuck in the Lift",
      "ru": "Застряли в лифте"
    },
    "blocks": [
      {
        "en": "Kate and the others were going up to the third floor. Den was eating his lunch. Suddenly the lift stopped. The lights went off. It was dark.",
        "ru": "Кейт и остальные поднимались на третий этаж. Ден ел свой обед. Вдруг лифт остановился. Свет погас. Было темно.",
        "image": "b1",
        "alt": {
          "en": "The team is in the lift and the lights go off",
          "ru": "Команда в лифте, и свет гаснет"
        }
      },
      {
        "en": "Everyone was surprised. Pol was calm. He was doing yoga in the corner. Alex was falling asleep. Valery was looking at his watch. It was almost six.",
        "ru": "Все были удивлены. Пол был спокоен. Он занимался йогой в углу. Алекс засыпал. Валерий смотрел на часы. Было почти шесть."
      },
      {
        "en": "Suddenly the alarm rang. After forty minutes the doors opened. Everyone cheered. Pol smiled and said, 'That was a good break.'",
        "ru": "Вдруг зазвенел сигнал. Через сорок минут двери открылись. Все закричали от радости. Пол улыбнулся и сказал: «Это был хороший перерыв».",
        "image": "b3",
        "alt": {
          "en": "The doors open and the team cheers",
          "ru": "Двери открываются, и команда радуется"
        }
      }
    ],
