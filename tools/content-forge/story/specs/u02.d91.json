  "grammar": {
    "title": {
      "en": "Present simple vs Present continuous",
      "ru": "Present simple и Present continuous"
    },
    "ref": "present-vs-continuous",
    "rule": {
      "en": "Use the present simple for habits and facts. Use the present continuous for actions happening now.",
      "ru": "Используйте present simple для привычек и фактов. Используйте present continuous для действий, происходящих сейчас."
    },
    "patterns": [
      {
        "label": {
          "en": "Habits and facts (present simple)",
          "ru": "Привычки и факты (present simple)"
        },
        "formula": "subject + verb (s/es)",
        "examples": [
          {
            "en": "Den usually sits at his desk.",
            "ru": "Ден обычно сидит за своим столом."
          },
          {
            "en": "He drinks coffee every morning.",
            "ru": "Он пьёт кофе каждое утро."
          }
        ],
        "ref": "present-simple"
      },
      {
        "label": {
          "en": "Actions now (present continuous)",
          "ru": "Действия сейчас (present continuous)"
        },
        "formula": "subject + am/is/are + verb-ing",
        "examples": [
          {
            "en": "Right now Den is standing.",
            "ru": "Прямо сейчас Ден стоит."
          },
          {
            "en": "Kate is drinking coffee at the moment.",
            "ru": "Кейт сейчас пьёт кофе."
          }
        ],
        "ref": "present-continuous"
      },
      {
        "label": {
          "en": "Time words",
          "ru": "Слова-указатели"
        },
        "formula": "usually / every day / always / right now / at the moment",
        "examples": [
          {
            "en": "Usually I sit, but right now I am standing.",
            "ru": "Обычно я сижу, но прямо сейчас я стою."
          }
        ],
        "ref": "time-words"
      }
    ],
    "pitfalls": [
      {
        "en": "Don't use present continuous for habits: \"I am working every day\" is wrong. Say \"I work every day\".",
        "ru": "Не используйте present continuous для привычек: «I am working every day» — неправильно. Скажите «I work every day»."
      },
      {
        "en": "Don't use present simple for actions happening now: \"He is standing now\" is correct, not \"He stands now\".",
        "ru": "Не используйте present simple для действий, происходящих сейчас: «He is standing now» — правильно, а не «He stands now»."
      }
    ]
  },
  "reading": {
    "title": {
      "en": "The Standing Desk",
      "ru": "Стол для работы стоя"
    },
    "blocks": [
      {
        "en": "Today Den has a new standing desk. He usually sits, but right now he is standing. \"Look at me!\" he says. \"I am working and standing at the same time!\"",
        "ru": "Сегодня у Дена новый стол для работы стоя. Обычно он сидит, но прямо сейчас он стоит. «Посмотрите на меня! — говорит он. — Я работаю и стою одновременно!»",
        "image": "b1",
        "alt": {
          "en": "Den stands proudly at his new standing desk",
          "ru": "Ден гордо стоит у своего нового стола для работы стоя"
        }
      },
      {
        "en": "Alex watches Den and smiles. He says: \"Kate is drinking coffee, Pol is making a smoothie, and Den is showing us his desk again.\" Peter is new. He asks: \"Does Den always stand?\" Alex answers: \"No, he usually sits. Today is special.\"",
        "ru": "Алекс смотрит на Дена и улыбается. Он говорит: «Кейт пьёт кофе, Пол делает смузи, а Ден снова показывает нам свой стол». Питер новенький. Он спрашивает: «Ден всегда стоит?» Алекс отвечает: «Нет, обычно он сидит. Сегодня особенный день»."
      },
      {
        "en": "Kate comes over. She says: \"Den, this is great! A healthy team is a happy team. Right now we are all working together.\" Den smiles. \"Yes! And tomorrow I will stand again!\"",
        "ru": "Кейт подходит. Она говорит: «Ден, это здорово! Здоровая команда — счастливая команда. Прямо сейчас мы все работаем вместе». Ден улыбается. «Да! И завтра я снова буду стоять!»",
        "image": "b3",
        "alt": {
          "en": "Kate and the team watch Den at his standing desk",
          "ru": "Кейт и команда смотрят на Дена у его стола для работы стоя"
        }
      }
    ],
