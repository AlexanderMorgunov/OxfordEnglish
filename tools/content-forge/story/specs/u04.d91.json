  "grammar": {
    "title": {
      "en": "Past simple",
      "ru": "Past simple"
    },
    "ref": "past-simple",
    "rule": {
      "en": "Use the past simple for finished actions in the past. Regular verbs add -ed (visit → visited). Many common verbs are irregular and must be learned: build → built, do → did, sleep → slept.",
      "ru": "Past simple — для законченных действий в прошлом. Правильные глаголы получают -ed (visit → visited). Многие частые глаголы неправильные, их нужно запомнить: build → built, do → did, sleep → slept."
    },
    "patterns": [
      {
        "label": {
          "en": "regular (+ed)",
          "ru": "правильные (+ed)"
        },
        "formula": "subject + verb-ed",
        "examples": [
          {
            "en": "Kate visited her sister.",
            "ru": "Кейт навестила сестру."
          }
        ],
        "ref": "past-simple"
      },
      {
        "label": {
          "en": "irregular",
          "ru": "неправильные"
        },
        "formula": "subject + past form",
        "examples": [
          {
            "en": "Alex built a huge fort.",
            "ru": "Алекс построил огромную крепость."
          }
        ],
        "ref": "past-simple"
      },
      {
        "label": {
          "en": "negative with did not",
          "ru": "отрицание с did not"
        },
        "formula": "subject + did not + base verb",
        "examples": [
          {
            "en": "Alex did not sleep.",
            "ru": "Алекс не спал."
          }
        ],
        "ref": "past-simple"
      }
    ],
    "pitfalls": [
      {
        "en": "After \"did not\", use the base verb: \"did not sleep\", not \"did not slept\".",
        "ru": "После «did not» — начальная форма: «did not sleep», а не «did not slept»."
      },
      {
        "en": "Irregular verbs have no -ed: \"built\", not \"builded\"; \"did\", not \"doed\".",
        "ru": "У неправильных глаголов нет -ed: «built», а не «builded»; «did», а не «doed»."
      }
    ]
  },
  "reading": {
    "title": {
      "en": "The Weekend Stories",
      "ru": "Истории выходных"
    },
    "blocks": [
      {
        "en": "Monday morning. Kate asked the team, \"How was your weekend?\" She visited her sister and they cooked all day. Den cleaned his flat and organised his mugs by size.",
        "ru": "Утро понедельника. Кейт спросила команду: «Как прошли ваши выходные?» Она навестила сестру, и они готовили весь день. Ден убрал свою квартиру и разложил кружки по размеру.",
        "image": "b1",
        "alt": {
          "en": "Kate asks the team about their weekend",
          "ru": "Кейт спрашивает команду о выходных"
        }
      },
      {
        "en": "Pol tried a new smoothie bar and cycled thirty kilometres. Alex did not sleep. He watched cartoons with his kids and built a huge blanket fort. Valery stayed home. He said, \"I did nothing, and it was perfect.\"",
        "ru": "Пол попробовал новый смузи-бар и проехал на велосипеде тридцать километров. Алекс не спал. Он смотрел мультфильмы с детьми и построил огромную крепость из одеял. Валерий остался дома. Он сказал: «Я ничего не делал, и это было прекрасно»."
      },
      {
        "en": "Peter was shy. \"I studied English all weekend,\" he said. Kate smiled. \"You are our hero, Peter!\" The team laughed. It was a cosy Monday.",
        "ru": "Питер был застенчив. «Я учил английский все выходные», — сказал он. Кейт улыбнулась. «Ты наш герой, Питер!» Команда засмеялась. Это был уютный понедельник.",
        "image": "b3",
        "alt": {
          "en": "Peter tells the team he studied English",
          "ru": "Питер говорит команде, что учил английский"
        }
      }
    ],
