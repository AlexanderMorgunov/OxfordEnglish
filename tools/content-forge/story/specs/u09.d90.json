  "grammar": {
    "title": {
      "en": "Comparatives (bigger, more comfortable)",
      "ru": "Сравнительная степень (bigger, more comfortable)"
    },
    "ref": "comparatives",
    "rule": {
      "en": "Use comparative adjectives to compare two things. Add -er to short adjectives (hot → hotter, big → bigger). Use more with long adjectives (comfortable → more comfortable). Some adjectives are irregular: good → better, bad → worse.",
      "ru": "Сравнительная степень нужна, чтобы сравнить два предмета. К коротким прилагательным добавляй -er (hot → hotter, big → bigger). С длинными используй more (comfortable → more comfortable). Некоторые неправильные: good → better, bad → worse."
    },
    "patterns": [
      {
        "label": {
          "en": "short adjectives (+er)",
          "ru": "короткие прилагательные (+er)"
        },
        "formula": "adjective + -er + than",
        "examples": [
          {
            "en": "Today is hotter than yesterday.",
            "ru": "Сегодня жарче, чем вчера."
          },
          {
            "en": "The shirt is brighter than the shorts.",
            "ru": "Рубашка ярче, чем шорты."
          }
        ],
        "ref": "comparatives"
      },
      {
        "label": {
          "en": "long adjectives (more + adjective)",
          "ru": "длинные прилагательные (more + прилагательное)"
        },
        "formula": "more + adjective + than",
        "examples": [
          {
            "en": "Shorts are more comfortable than jeans.",
            "ru": "Шорты удобнее, чем джинсы."
          }
        ],
        "ref": "comparatives"
      },
      {
        "label": {
          "en": "irregular comparatives",
          "ru": "неправильные сравнительные формы"
        },
        "formula": "irregular form + than",
        "examples": [
          {
            "en": "Your clothes are worse than I thought.",
            "ru": "Ваша одежда хуже, чем я думала."
          }
        ],
        "ref": "comparatives"
      }
    ],
    "pitfalls": [
      {
        "en": "Don't use more + -er together: \"more hotter\" is wrong. Use \"hotter\".",
        "ru": "Не используй more + -er вместе: «more hotter» неверно. Правильно «hotter»."
      },
      {
        "en": "Use than when you compare two things: \"Shorts are more comfortable than jeans\".",
        "ru": "Используй than при сравнении двух вещей: «Shorts are more comfortable than jeans»."
      },
      {
        "en": "Watch the irregular forms: good → better, bad → worse.",
        "ru": "Запомни неправильные формы: good → better, bad → worse."
      }
    ]
  },
  "reading": {
    "title": {
      "en": "Casual Friday",
      "ru": "Повседневная пятница"
    },
    "blocks": [
      {
        "en": "It is Friday. Alex comes to the office in shorts and flip-flops. The weather is hot. He says, \"Today is hotter than yesterday. Shorts are more comfortable than jeans.\"",
        "ru": "Пятница. Алекс приходит в офис в шортах и шлёпанцах. Погода жаркая. Он говорит: «Сегодня жарче, чем вчера. Шорты удобнее, чем джинсы».",
        "image": "b1",
        "alt": {
          "en": "Alex arrives in shorts and flip-flops on a hot Friday",
          "ru": "Алекс приходит в шортах и шлёпанцах в жаркую пятницу"
        }
      },
      {
        "en": "Den wears jeans and a T-shirt. He says, \"Jeans look better than shorts. You are not at the beach.\" Alex laughs. \"But my flip-flops are more fun than your shoes.\" Den shakes his head.",
        "ru": "Ден носит джинсы и футболку. Он говорит: «Джинсы выглядят лучше, чем шорты. Ты не на пляже». Алекс смеётся. «Но мои шлёпанцы веселее, чем твои туфли». Ден качает головой."
      },
      {
        "en": "Valery arrives in a very loud Hawaiian shirt. It is brighter than Alex's shorts. Kate looks at everyone. \"Your clothes are worse than I thought,\" she says. \"But it is Friday, so it is fine.\" Nobody really cares. Alex and Valery smile.",
        "ru": "Валери приходит в очень кричащей гавайской рубашке. Она ярче, чем шорты Алекса. Кейт смотрит на всех. «Ваша одежда хуже, чем я думала, — говорит она. — Но сегодня пятница, так что всё нормально». Всем, по правде, всё равно. Алекс и Валери улыбаются.",
        "image": "b3",
        "alt": {
          "en": "Valery wears a loud Hawaiian shirt and Kate looks surprised",
          "ru": "Валери в кричащей гавайской рубашке, Кейт удивлена"
        }
      }
    ],
