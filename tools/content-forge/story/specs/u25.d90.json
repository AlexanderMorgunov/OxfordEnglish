  "grammar": {
    "title": {
      "en": "too much / too many / enough · so / such",
      "ru": "too much / too many / enough · so / such"
    },
    "ref": "too-enough",
    "rule": {
      "en": "Use too much with uncountable nouns, too many with countable nouns, and (not) enough before a noun. Enough comes after an adjective. So makes adjectives stronger; such is used before a noun phrase. Use so much / so many before nouns.",
      "ru": "Используйте too much с неисчисляемыми существительными, too many с исчисляемыми, а (not) enough — перед существительным. Enough стоит после прилагательного. So усиливает прилагательные; such используется перед существительной фразой. Используйте so much / so many перед существительными."
    },
    "patterns": [
      {
        "label": {
          "en": "too much + uncount. / too many + count.",
          "ru": "too much + неисчисляемое / too many + исчисляемое"
        },
        "formula": "too much + uncountable noun / too many + countable noun",
        "examples": [
          {
            "en": "There is too much coffee.",
            "ru": "Здесь слишком много кофе."
          },
          {
            "en": "There are too many meetings.",
            "ru": "Здесь слишком много встреч."
          }
        ],
        "ref": "too-enough"
      },
      {
        "label": {
          "en": "enough + noun / adjective + enough",
          "ru": "enough + существительное / прилагательное + enough"
        },
        "formula": "(not) enough + noun / adjective + enough",
        "examples": [
          {
            "en": "There isn't enough time.",
            "ru": "Недостаточно времени."
          },
          {
            "en": "He is old enough to drive.",
            "ru": "Он достаточно взрослый, чтобы водить машину."
          }
        ],
        "ref": "too-enough"
      },
      {
        "label": {
          "en": "so + adjective/adverb",
          "ru": "so + прилагательное/наречие"
        },
        "formula": "so + adjective/adverb",
        "examples": [
          {
            "en": "Kate is so happy.",
            "ru": "Кейт так счастлива."
          },
          {
            "en": "Alex works so slowly.",
            "ru": "Алекс работает так медленно."
          }
        ],
        "ref": "so-such"
      },
      {
        "label": {
          "en": "such (a) + noun",
          "ru": "such (a) + существительное"
        },
        "formula": "such a + singular noun / such + plural noun",
        "examples": [
          {
            "en": "It's such a good idea.",
            "ru": "Это такая хорошая идея."
          },
          {
            "en": "They are such nice people.",
            "ru": "Они такие приятные люди."
          }
        ],
        "ref": "so-such"
      },
      {
        "label": {
          "en": "so much + uncount. / so many + count.",
          "ru": "so much + неисчисляемое / so many + исчисляемое"
        },
        "formula": "so much + uncountable noun / so many + countable noun",
        "examples": [
          {
            "en": "We have so much work.",
            "ru": "У нас так много работы."
          },
          {
            "en": "There are so many emails.",
            "ru": "Здесь так много писем."
          }
        ],
        "ref": "so-such"
      }
    ],
    "pitfalls": [
      {
        "en": "Use 'too many' with countable nouns and 'too much' with uncountable nouns.",
        "ru": "Используйте 'too many' с исчисляемыми и 'too much' с неисчисляемыми."
      },
      {
        "en": "'Enough' comes before a noun (enough time) but after an adjective (good enough).",
        "ru": "'Enough' стоит перед существительным (enough time), но после прилагательного (good enough)."
      },
      {
        "en": "Use 'such a' before a singular noun phrase: 'such a good idea', not 'so a good idea'.",
        "ru": "Используйте 'such a' перед единственным числом: 'such a good idea', а не 'so a good idea'."
      }
    ]
  },
  "reading": {
    "title": {
      "en": "Too Many Meetings",
      "ru": "Слишком много встреч"
    },
    "blocks": [
      {
        "en": "Kate planned more team-building games. 'We have too many meetings!' said Den. 'There isn't enough time for work.'",
        "ru": "Кейт запланировала больше тимбилдингов. «У нас слишком много встреч!» — сказал Ден. «Недостаточно времени для работы».",
        "image": "b1",
        "alt": {
          "en": "Kate shows a schedule full of team-building meetings",
          "ru": "Кейт показывает расписание, полное тимбилдингов"
        }
      },
      {
        "en": "Alex yawned. 'So much coffee, so little sleep.' Pol said, 'There isn't enough fruit for my smoothie.' Peter counted, 'We have too much cake and too many emails!'",
        "ru": "Алекс зевнул. «Так много кофе, так мало сна». Пол сказал: «Недостаточно фруктов для моего смузи». Питер подсчитал: «У нас слишком много торта и слишком много писем!»"
      },
      {
        "en": "Kate smiled. 'It's such a good idea! We are such a great team!' She looked at the schedule. 'Maybe one meeting is too many.' She cancelled it. 'Finally, enough time to work!' everyone cheered.",
        "ru": "Кейт улыбнулась. «Это такая хорошая идея! Мы такая отличная команда!» Она посмотрела на расписание. «Может, одна встреча — это слишком много». Она отменила её. «Наконец-то достаточно времени для работы!» — все закричали.",
        "image": "b3",
        "alt": {
          "en": "Kate cancels a meeting and everyone cheers",
          "ru": "Кейт отменяет встречу, и все радуются"
        }
      }
    ],
    "glossary": [
      {
        "word": "yawned",
        "ru": "зевнул",
        "ipa": "/jɔːnd/"
      },
      {
        "word": "counted",
        "ru": "подсчитал",
        "ipa": "/ˈkaʊntɪd/"
      },
      {
        "word": "cheered",
        "ru": "закричали от радости",
        "ipa": "/tʃɪəd/"
      },
      {
        "word": "little",
        "ru": "мало (неисчисляемое)",
        "ipa": "/ˈlɪtl/"
      }
    ]
  },
