  "grammar": {
    "title": {
      "en": "Modal verbs: must, should, can't",
      "ru": "Модальные глаголы: must, should, can't"
    },
    "ref": "modals",
    "rule": {
      "en": "Use must for strong obligation — something is necessary. Use should for advice — something is a good idea. Use can't to say something is not possible or not allowed. After these modals, always use the base verb (no -s, no -ed, no to).",
      "ru": "Must — для строгой обязанности, что-то необходимо. Should — для совета, что-то хорошая идея. Can't — что-то невозможно или запрещено. После этих модальных глаголов всегда идёт начальная форма глагола (без -s, -ed, to)."
    },
    "patterns": [
      {
        "label": {
          "en": "must + base verb",
          "ru": "must + начальная форма"
        },
        "formula": "subject + must + base verb",
        "examples": [
          {
            "en": "You must wash the dishes.",
            "ru": "Ты должен помыть посуду."
          }
        ],
        "ref": "modals"
      },
      {
        "label": {
          "en": "should + base verb",
          "ru": "should + начальная форма"
        },
        "formula": "subject + should + base verb",
        "examples": [
          {
            "en": "You should buy milk.",
            "ru": "Тебе следует купить молоко."
          },
          {
            "en": "You should mute yourself.",
            "ru": "Тебе следует выключить микрофон."
          }
        ],
        "ref": "modals"
      },
      {
        "label": {
          "en": "can't + base verb",
          "ru": "can't + начальная форма"
        },
        "formula": "subject + can't + base verb",
        "examples": [
          {
            "en": "You can't hear me, right?",
            "ru": "Вы меня не слышите, да?"
          }
        ],
        "ref": "modals"
      }
    ],
    "pitfalls": [
      {
        "en": "After modals, use the base verb: \"You must wash\", not \"You must to wash\" or \"You must washes\".",
        "ru": "После модальных глаголов используй начальную форму: «You must wash», а не «You must to wash» или «You must washes»."
      },
      {
        "en": "Must is stronger than should. \"You must wash the dishes\" means it is necessary. \"You should buy milk\" means it is a good idea, but not necessary.",
        "ru": "Must сильнее, чем should. «You must wash the dishes» означает, что это необходимо. «You should buy milk» — это хорошая идея, но не обязательно."
      }
    ]
  },
  "reading": {
    "title": {
      "en": "The 8 AM Call",
      "ru": "Звонок в 8 утра"
    },
    "blocks": [
      {
        "en": "It is 8 AM. David calls the team from the USA. He is on a video call. Kate is in her car. She is very sleepy.",
        "ru": "Сейчас 8 утра. Дэвид звонит команде из США. Он на видеозвонке. Кейт в машине. Она очень сонная.",
        "image": "b1",
        "alt": {
          "en": "Kate joins a video call from her car, still sleepy",
          "ru": "Кейт присоединяется к видеозвонку из машины, ещё сонная"
        }
      },
      {
        "en": "Kate joins the call. She thinks her microphone is off. She shouts to Mark at home: \"You must wash the dishes! You should buy milk!\"",
        "ru": "Кейт подключается к звонку. Она думает, что её микрофон выключен. Она кричит Марку дома: «Ты должен помыть посуду! Тебе следует купить молоко!»"
      },
      {
        "en": "David is calm. He says: \"Kate, we can all hear you. You should put yourself on mute.\" Everybody laughs. Kate is embarrassed, but she laughs too.",
        "ru": "Дэвид спокоен. Он говорит: «Кейт, мы все тебя слышим. Тебе следует выключить микрофон». Все смеются. Кейт смущена, но тоже смеётся.",
        "image": "b3",
        "alt": {
          "en": "David tells Kate to mute herself, everyone laughs",
          "ru": "Дэвид просит Кейт выключить микрофон, все смеются"
        }
      }
    ],
