  "title": { "en": "This and that", "ru": "Это и то" },
  "vocab": {
    "title": { "en": "Near, far and colours", "ru": "Близко, далеко и цвета" },
    "words": [
      { "word": "here", "ru": "здесь, тут", "ipa": "/hɪə/", "example": "This car is here.", "exampleRu": "Эта машина здесь." },
      { "word": "there", "ru": "там", "ipa": "/ðeə/", "example": "That dog is there.", "exampleRu": "Та собака там." },
      { "word": "big", "ru": "большой", "ipa": "/bɪɡ/", "example": "This is a big city.", "exampleRu": "Это большой город." },
      { "word": "small", "ru": "маленький", "ipa": "/smɔːl/", "example": "That is a small cat.", "exampleRu": "То маленький кот." },
      { "word": "red", "ru": "красный", "ipa": "/red/", "example": "These pens are red.", "exampleRu": "Эти ручки красные." },
      { "word": "blue", "ru": "синий, голубой", "ipa": "/bluː/", "example": "That bag is blue.", "exampleRu": "Та сумка синяя." },
      { "word": "green", "ru": "зелёный", "ipa": "/ɡriːn/", "example": "This apple is green.", "exampleRu": "Это яблоко зелёное." },
      { "word": "black", "ru": "чёрный", "ipa": "/blæk/", "example": "Those cars are black.", "exampleRu": "Те машины чёрные." },
      { "word": "white", "ru": "белый", "ipa": "/waɪt/", "example": "This chair is white.", "exampleRu": "Этот стул белый." },
      { "word": "car", "ru": "машина", "ipa": "/kɑː/", "example": "This is my car.", "exampleRu": "Это моя машина." },
      { "word": "cat", "ru": "кот, кошка", "ipa": "/kæt/", "example": "That cat is small.", "exampleRu": "Тот кот маленький." },
      { "word": "dog", "ru": "собака", "ipa": "/dɒɡ/", "example": "These dogs are big.", "exampleRu": "Эти собаки большие." }
    ]
  },
  "grammar": {
    "title": { "en": "this / that / these / those", "ru": "this / that / these / those" },
    "ref": "demonstratives",
    "rule": {
      "en": "Use this / these for things NEAR you, and that / those for things FAR from you. Use this / that for ONE thing (this is…), and these / those for MORE than one (these are…).",
      "ru": "this / these — для того, что БЛИЗКО; that / those — для того, что ДАЛЕКО. this / that — для ОДНОГО (this is…); these / those — для НЕСКОЛЬКИХ (these are…)."
    },
    "patterns": [
      {
        "label": { "en": "one thing: this / that", "ru": "один предмет: this / that" },
        "formula": "this/that + is + …",
        "examples": [
          { "en": "This is my car.", "ru": "Это моя машина." },
          { "en": "That is a small cat.", "ru": "То маленький кот." }
        ]
      },
      {
        "label": { "en": "many things: these / those", "ru": "несколько: these / those" },
        "formula": "these/those + are + …",
        "examples": [
          { "en": "These are red pens.", "ru": "Это красные ручки." },
          { "en": "Those dogs are big.", "ru": "Те собаки большие." }
        ]
      }
    ],
    "pitfalls": [
      { "en": "these / those go with plural + are: \"these are\", not \"this are\".", "ru": "these / those — с множественным и are: «these are», а не «this are»." },
      { "en": "this / that go with one thing + is.", "ru": "this / that — с одним предметом и is." }
    ]
  },
  "reading": {
    "title": { "en": "My things", "ru": "Мои вещи" },
    "blocks": [
      { "en": "This is my car. It is white. That car is black.", "ru": "Это моя машина. Она белая. Та машина чёрная." },
      { "en": "These are my pens. They are red. Those pens are blue.", "ru": "Это мои ручки. Они красные. Те ручки синие." },
      { "en": "This cat is small. Those dogs are big.", "ru": "Этот кот маленький. Те собаки большие." }
    ],
    "glossary": [
      { "word": "it", "ru": "оно, она, он (о предмете)", "ipa": "/ɪt/" },
      { "word": "they", "ru": "они", "ipa": "/ðeɪ/" }
    ]
  },
