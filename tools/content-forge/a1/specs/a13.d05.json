  "grammar": {
    "title": { "en": "Telling the time and at / on / in", "ru": "Как назвать время и at / on / in" },
    "ref": "present-simple",
    "rule": {
      "en": "Tell the time with It is…: It is seven o'clock, half past six, quarter past nine. Use at with clock times (at 7 o'clock), on with days (on Monday), in with parts of the day and months (in the morning, in July). But: at night, at the weekend.",
      "ru": "Время называем через It is…: It is seven o'clock, half past six, quarter past nine. at — с точным временем (at 7 o'clock), on — с днями (on Monday), in — с частями дня и месяцами (in the morning, in July). Но: at night, at the weekend."
    },
    "patterns": [
      {
        "label": { "en": "Telling the time", "ru": "Называем время" },
        "formula": "It is + (half/quarter past) + hour",
        "examples": [
          { "en": "It is seven o'clock.", "ru": "Сейчас семь часов." },
          { "en": "It is half past six.", "ru": "Сейчас половина седьмого." }
        ]
      },
      {
        "label": { "en": "at / on / in", "ru": "at / on / in" },
        "formula": "at + time · on + day · in + part of day/month",
        "examples": [
          { "en": "at 8 o'clock, on Monday, in the morning", "ru": "в 8 часов, в понедельник, утром" }
        ]
      },
      {
        "label": { "en": "Fixed phrases", "ru": "Устойчивые выражения" },
        "formula": "at night · at the weekend",
        "examples": [
          { "en": "I work in the morning and sleep at night.", "ru": "Я работаю утром и сплю ночью." }
        ]
      }
    ],
    "pitfalls": [
      { "en": "at night, not \"in the night\"; on Monday, not \"in Monday\".", "ru": "at night, не «in the night»; on Monday, не «in Monday»." },
      { "en": "at + clock time: \"at 7 o'clock\".", "ru": "at + точное время: «at 7 o'clock»." }
    ]
  },
  "reading": {
    "title": { "en": "A busy Monday", "ru": "Занятой понедельник" },
    "blocks": [
      { "en": "It is Monday today. I get up at seven o'clock and have breakfast at half past seven.", "ru": "Сегодня понедельник. Я встаю в семь часов и завтракаю в половине восьмого." },
      { "en": "I start work at nine. In the morning I am busy. I have lunch at one.", "ru": "Я начинаю работать в девять. Утром я занят. Я обедаю в час." },
      { "en": "At the weekend I don't work. On Sunday I sleep late. See you tomorrow!", "ru": "На выходных я не работаю. В воскресенье я сплю допоздна. Увидимся завтра!" }
    ],
    "glossary": [
      { "word": "busy", "ru": "занятой", "ipa": "/ˈbɪzi/" },
      { "word": "lunch", "ru": "обед", "ipa": "/lʌntʃ/" }
    ]
  },
