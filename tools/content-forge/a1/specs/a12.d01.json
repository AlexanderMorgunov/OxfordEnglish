      { "word": "parents", "ru": "родители", "ipa": "/ˈpeərənts/", "example": "My parents are here.", "exampleRu": "Мои родители здесь." },
      { "word": "son", "ru": "сын", "ipa": "/sʌn/", "example": "They have got a son.", "exampleRu": "У них есть сын." },
      { "word": "daughter", "ru": "дочь", "ipa": "/ˈdɔːtə/", "example": "He has got a daughter.", "exampleRu": "У него есть дочь." },
      { "word": "wife", "ru": "жена", "ipa": "/waɪf/", "example": "This is my wife.", "exampleRu": "Это моя жена." },
