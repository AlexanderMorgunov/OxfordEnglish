      { "word": "baby", "ru": "малыш, ребёнок", "ipa": "/ˈbeɪbi/", "example": "They have got a baby.", "exampleRu": "У них есть малыш." },
      { "word": "pet", "ru": "домашний питомец", "ipa": "/pet/", "example": "Have you got a pet?", "exampleRu": "У тебя есть питомец?" },
      { "word": "big", "ru": "большой", "ipa": "/bɪɡ/", "example": "I have got a big family.", "exampleRu": "У меня большая семья." }
    ]
  },
  "grammar": {
    "title": { "en": "have got / has got", "ru": "have got / has got (иметь, у ... есть)" },
    "ref": "have-got",
    "rule": {
      "en": "Use have got to say what you own or what family you have. I/you/we/they → have got (short: 've got); he/she/it → has got (short: 's got). Negative: haven't got / hasn't got. Question: Have you got…? / Has she got…?",
      "ru": "have got говорит, что у тебя есть (вещь, семья). I/you/we/they → have got (кратко 've got); he/she/it → has got (кратко 's got). Отрицание: haven't got / hasn't got. Вопрос: Have you got…? / Has she got…?"
    },
    "patterns": [
      {
        "label": { "en": "have / has got", "ru": "have / has got" },
        "formula": "I/you/we/they have got · he/she/it has got",
        "examples": [
          { "en": "I have got a sister.", "ru": "У меня есть сестра." },
          { "en": "She has got two brothers.", "ru": "У неё два брата." }
        ]
      },
      {
        "label": { "en": "Negative", "ru": "Отрицание" },
        "formula": "haven't got / hasn't got",
        "examples": [
          { "en": "We haven't got a pet.", "ru": "У нас нет питомца." },
          { "en": "He hasn't got a car.", "ru": "У него нет машины." }
        ]
      },
      {
        "label": { "en": "Question", "ru": "Вопрос" },
        "formula": "Have/Has + subject + got…?",
        "examples": [
          { "en": "Have you got a brother?", "ru": "У тебя есть брат?" },
          { "en": "Has she got a dog?", "ru": "У неё есть собака?" }
        ]
      }
    ],
    "pitfalls": [
      { "en": "he/she/it → has got, not have got: \"She has got\", not \"She have got\".", "ru": "he/she/it → has got, не have got: «She has got», а не «She have got»." },
      { "en": "have got = own/possess (it's not \"receive\").", "ru": "have got = иметь/владеть (это не «получать»)." }
    ]
  },
  "reading": {
    "title": { "en": "My family", "ru": "Моя семья" },
    "blocks": [
      { "en": "I have got a big family. I have got a mother, a father and two brothers.", "ru": "У меня большая семья. У меня есть мама, папа и два брата." },
      { "en": "My brother has got a wife and a baby. They have got a small dog too.", "ru": "У моего брата есть жена и малыш. У них ещё есть маленькая собака." },
      { "en": "\"Have you got a sister?\" \"No, I haven't. But I have got a cat!\"", "ru": "«У тебя есть сестра?» «Нет. Зато у меня есть кот!»" }
    ],
    "glossary": [
      { "word": "'ve got", "ru": "= have got", "ipa": "/vɡɒt/" },
      { "word": "'s got", "ru": "= has got", "ipa": "/zɡɒt/" }
    ]
  },
  "listening": {
