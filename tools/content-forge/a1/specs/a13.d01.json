  "grammar": {
    "title": { "en": "Present Simple: I work, she works", "ru": "Present Simple: I work, she works" },
    "ref": "present-simple",
    "rule": {
      "en": "Use the Present Simple for habits, routines and facts. For I/you/we/they the verb has no ending: I work. For he/she/it add -s: she works. Add -es after -o, -ch, -sh, -s, -x (goes, watches); a consonant + y becomes -ies (study → studies).",
      "ru": "Present Simple — для привычек, распорядка и фактов. Для I/you/we/they глагол без окончания: I work. Для he/she/it добавляем -s: she works. После -o, -ch, -sh, -s, -x — -es (goes, watches); согласная + y → -ies (study → studies)."
    },
    "patterns": [
      {
        "label": { "en": "I / you / we / they + verb", "ru": "I / you / we / they + глагол" },
        "formula": "subject + verb",
        "examples": [
          { "en": "I work every day.", "ru": "Я работаю каждый день." },
          { "en": "They play football.", "ru": "Они играют в футбол." }
        ]
      },
      {
        "label": { "en": "he / she / it + verb-s", "ru": "he / she / it + глагол-s" },
        "formula": "he/she/it + verb + -s",
        "examples": [
          { "en": "She works in an office.", "ru": "Она работает в офисе." },
          { "en": "He drinks coffee.", "ru": "Он пьёт кофе." }
        ]
      },
      {
        "label": { "en": "spelling: -es / -ies", "ru": "написание: -es / -ies" },
        "formula": "go → goes · watch → watches · study → studies",
        "examples": [
          { "en": "He goes to work. She watches TV.", "ru": "Он ходит на работу. Она смотрит телевизор." }
        ]
      }
    ],
    "pitfalls": [
      { "en": "he/she/it needs -s: \"she works\", not \"she work\".", "ru": "he/she/it — с -s: «she works», а не «she work»." },
      { "en": "go → goes, watch → watches (not \"gos\"/\"watchs\").", "ru": "go → goes, watch → watches (не «gos»/«watchs»)." }
    ]
  },
  "reading": {
    "title": { "en": "Ann's day", "ru": "День Анны" },
    "blocks": [
      { "en": "I am Ann. Every day I get up at seven. I eat breakfast and drink tea.", "ru": "Я Анна. Каждый день я встаю в семь. Я завтракаю и пью чай." },
      { "en": "I go to work at eight. I work in an office. I study English in the evening.", "ru": "Я иду на работу в восемь. Я работаю в офисе. Вечером я изучаю английский." },
      { "en": "My friend Ben is a teacher. He works at a school. He reads a lot and watches films.", "ru": "Мой друг Бен — учитель. Он работает в школе. Он много читает и смотрит фильмы." }
    ],
    "glossary": [
