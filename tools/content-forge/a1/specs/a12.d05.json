  },
  "grammar": {
    "title": { "en": "some / any", "ru": "some / any" },
    "ref": "some-any",
    "rule": {
      "en": "Use some in positive sentences: I have got some bread. Use any in questions and negatives: Is there any bread? / There isn't any bread. This works both for things you can count (some apples) and things you can't (some water).",
      "ru": "some — в утвердительных: I have got some bread. any — в вопросах и отрицаниях: Is there any bread? / There isn't any bread. Работает и с исчисляемым (some apples), и с неисчисляемым (some water)."
    },
    "patterns": [
      {
        "label": { "en": "some (positive)", "ru": "some (утверждение)" },
        "formula": "… have got / there is + some + noun",
        "examples": [
          { "en": "I have got some bread.", "ru": "У меня есть хлеб." },
          { "en": "There is some milk.", "ru": "Есть молоко." }
        ]
      },
      {
        "label": { "en": "any (question)", "ru": "any (вопрос)" },
        "formula": "Is there / Have you got + any + noun?",
        "examples": [
          { "en": "Is there any coffee?", "ru": "Есть кофе?" },
          { "en": "Have you got any apples?", "ru": "У тебя есть яблоки?" }
        ]
      },
      {
        "label": { "en": "any (negative)", "ru": "any (отрицание)" },
        "formula": "… isn't / haven't got + any + noun",
        "examples": [
          { "en": "There isn't any sugar.", "ru": "Сахара нет." },
          { "en": "We haven't got any tea.", "ru": "У нас нет чая." }
        ]
      }
    ],
    "pitfalls": [
      { "en": "any in questions and negatives; some in positives.", "ru": "any — в вопросах и отрицаниях; some — в утверждениях." },
      { "en": "Uncountable food (water, bread, rice) is singular: \"some rice\", not \"some rices\".", "ru": "Неисчисляемая еда (water, bread, rice) — в единственном: «some rice», не «some rices»." }
    ]
  },
  "reading": {
    "title": { "en": "In the kitchen", "ru": "На кухне" },
    "blocks": [
      { "en": "There is some bread and some cheese on the table. There is some milk too.", "ru": "На столе есть хлеб и сыр. Ещё есть молоко." },
      { "en": "\"Is there any coffee?\" \"No, there isn't. But there is some tea.\"", "ru": "«Есть кофе?» «Нет. Зато есть чай.»" },
      { "en": "\"Have we got any apples?\" \"Yes, we have got some apples and two bananas.\"", "ru": "«У нас есть яблоки?» «Да, есть яблоки и два банана.»" }
    ],
    "glossary": [
      { "word": "too", "ru": "тоже", "ipa": "/tuː/" },
      { "word": "but", "ru": "но", "ipa": "/bʌt/" }
    ]
  },
