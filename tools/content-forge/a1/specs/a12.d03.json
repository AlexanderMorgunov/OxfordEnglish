    "dialogue": [
      ["Is there a kitchen?", "Есть кухня?"],
      ["Yes, there is. And there are three rooms.", "Да. И три комнаты."],
      ["Are there any windows?", "Есть окна?"],
      ["Yes, there are two big windows.", "Да, два больших окна."],
      ["Is there a garden?", "Есть сад?"],
      ["No, there isn't.", "Нет."]
    ],
