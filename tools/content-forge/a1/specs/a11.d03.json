      { "word": "city", "ru": "город", "ipa": "/ˈsɪti/", "example": "one city, two cities", "exampleRu": "один город, два города" }
    ]
  },
  "grammar": {
    "title": { "en": "a / an and plural nouns", "ru": "a / an и множественное число" },
    "ref": "plurals",
    "rule": {
      "en": "Use a / an for ONE thing: a before a consonant sound (a book), an before a vowel sound (an apple). For more than one, add -s. Add -es after s, x, ch, sh, o (boxes). A consonant + y becomes -ies (city → cities). Use no a/an with plurals.",
      "ru": "a / an — для ОДНОГО предмета: a перед согласным звуком (a book), an перед гласным (an apple). Для нескольких добавляем -s. После s, x, ch, sh, o — -es (boxes). Согласная + y → -ies (city → cities). С множественным a/an не ставим."
    },
    "patterns": [
      {
        "label": { "en": "a / an (one)", "ru": "a / an (один)" },
        "formula": "a + consonant sound · an + vowel sound",
        "examples": [
          { "en": "a book, a pen, a table", "ru": "книга, ручка, стол" },
          { "en": "an apple, an egg, an orange", "ru": "яблоко, яйцо, апельсин" }
        ]
      },
      {
        "label": { "en": "plural: + -s", "ru": "множественное: + -s" },
        "formula": "noun + -s",
        "examples": [
          { "en": "two books, three pens", "ru": "две книги, три ручки" }
        ]
      },
      {
        "label": { "en": "+ -es / -ies", "ru": "+ -es / -ies" },
        "formula": "…s/x/ch/sh/o + -es · consonant+y → -ies",
        "examples": [
          { "en": "box → boxes", "ru": "коробка → коробки" },
          { "en": "city → cities", "ru": "город → города" }
        ]
      }
    ],
    "pitfalls": [
      { "en": "an before a vowel sound: \"an apple\", not \"a apple\".", "ru": "an перед гласным звуком: «an apple», а не «a apple»." },
      { "en": "No a/an with plurals: \"two books\", not \"two a books\".", "ru": "С множественным нет a/an: «two books», а не «two a books»." }
    ]
  },
  "reading": {
