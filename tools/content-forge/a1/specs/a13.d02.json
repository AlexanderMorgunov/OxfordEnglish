  "grammar": {
    "title": { "en": "Present Simple: don't / doesn't and questions with do/does", "ru": "Present Simple: don't / doesn't и вопросы с do/does" },
    "ref": "present-simple",
    "rule": {
      "en": "For negatives use don't (I/you/we/they) and doesn't (he/she/it) + the BASE verb: I don't work, she doesn't work. For questions put Do / Does first + the base verb: Do you work? Does she work? After doesn't and does the verb has NO -s.",
      "ru": "Для отрицания — don't (I/you/we/they) и doesn't (he/she/it) + БАЗОВЫЙ глагол: I don't work, she doesn't work. Для вопросов ставим Do / Does впереди + базовый глагол: Do you work? Does she work? После doesn't и does у глагола НЕТ -s."
    },
    "patterns": [
      {
        "label": { "en": "Negative", "ru": "Отрицание" },
        "formula": "don't / doesn't + base verb",
        "examples": [
          { "en": "I don't work at the weekend.", "ru": "Я не работаю на выходных." },
          { "en": "She doesn't drink coffee.", "ru": "Она не пьёт кофе." }
        ]
      },
      {
        "label": { "en": "Yes/No question", "ru": "Вопрос да/нет" },
        "formula": "Do/Does + subject + base verb?",
        "examples": [
          { "en": "Do you live here?", "ru": "Ты здесь живёшь?" },
          { "en": "Does he work late?", "ru": "Он работает допоздна?" }
        ]
      },
      {
        "label": { "en": "Wh- question", "ru": "Wh-вопрос" },
        "formula": "What/Where + do/does + subject + base verb?",
        "examples": [
          { "en": "Where do you work?", "ru": "Где ты работаешь?" },
          { "en": "What does she study?", "ru": "Что она изучает?" }
        ]
      }
    ],
    "pitfalls": [
      { "en": "After doesn't / does use the base verb: \"she doesn't work\", not \"doesn't works\".", "ru": "После doesn't / does — базовый глагол: «she doesn't work», а не «doesn't works»." },
      { "en": "Questions need do/does: \"Do you live…?\", not \"You live…?\".", "ru": "В вопросе нужен do/does: «Do you live…?», а не «You live…?»." }
    ]
  },
  "reading": {
    "title": { "en": "A new job", "ru": "Новая работа" },
    "blocks": [
      { "en": "\"Do you work here?\" \"Yes, I do. I work in this office.\"", "ru": "«Ты здесь работаешь?» «Да. Я работаю в этом офисе.»" },
      { "en": "\"Where do you live?\" \"I live near the office. I don't drive; I walk.\"", "ru": "«Где ты живёшь?» «Я живу рядом с офисом. Я не езжу на машине; я хожу пешком.»" },
      { "en": "Ben doesn't work at the weekend. He doesn't get up early on Sunday.", "ru": "Бен не работает на выходных. В воскресенье он не встаёт рано." }
    ],
    "glossary": [
      { "word": "to walk", "ru": "идти пешком", "ipa": "/wɔːk/" },
      { "word": "near", "ru": "рядом, около", "ipa": "/nɪə/" }
    ]
  },
