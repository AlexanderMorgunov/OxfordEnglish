  "grammar": {
    "title": { "en": "Age with be, and numbers", "ru": "Возраст с глаголом be и числа" },
    "ref": "verb-be",
    "rule": {
      "en": "In English we talk about age with be, not have: I am 25 (years old). Ask: How old are you? — I am twenty. For 21–99 join tens and ones with a hyphen: twenty-one, thirty-five.",
      "ru": "О возрасте в английском говорят через be, а не have: I am 25 (years old). Вопрос: How old are you? — I am twenty. Для 21–99 соединяем десятки и единицы через дефис: twenty-one, thirty-five."
    },
    "patterns": [
      {
        "label": { "en": "Age: be + number", "ru": "Возраст: be + число" },
        "formula": "subject + be + number (+ years old)",
        "examples": [
          { "en": "I am twenty years old.", "ru": "Мне двадцать лет." },
          { "en": "She is thirty.", "ru": "Ей тридцать." }
        ]
      },
      {
        "label": { "en": "Question: How old…?", "ru": "Вопрос: How old…?" },
        "formula": "How old + be + subject?",
        "examples": [
          { "en": "How old are you?", "ru": "Сколько тебе лет?" },
          { "en": "How old is he?", "ru": "Сколько ему лет?" }
        ]
      },
      {
        "label": { "en": "Numbers 21–99", "ru": "Числа 21–99" },
        "formula": "ten + -one/two/… (with a hyphen)",
        "examples": [
          { "en": "twenty-one, thirty-five", "ru": "двадцать один, тридцать пять" }
        ]
      }
    ],
    "pitfalls": [
      { "en": "Age uses be, not have: \"I am 25\", not \"I have 25 years\".", "ru": "Возраст — через be, не have: «I am 25», а не «I have 25 years»." },
      { "en": "Ask \"How old are you?\", not \"How many years…?\".", "ru": "Спрашиваем «How old are you?», а не «How many years…?»." }
    ]
  },
  "reading": {
    "title": { "en": "About me", "ru": "Обо мне" },
    "blocks": [
      { "en": "Hello! My name is Tom. I am twenty years old. I am a student.", "ru": "Привет! Меня зовут Том. Мне двадцать лет. Я студент." },
      { "en": "This is my friend Kate. She is twenty-one. She is from England.", "ru": "Это моя подруга Кейт. Ей двадцать один. Она из Англии." },
      { "en": "\"How old are you?\" \"I am thirty. And you?\" \"I am twenty-five.\"", "ru": "«Сколько тебе лет?» «Мне тридцать. А тебе?» «Мне двадцать пять.»" }
    ],
    "glossary": [
      { "word": "years old", "ru": "лет (о возрасте)", "ipa": "/jɪəz əʊld/" },
      { "word": "and you?", "ru": "а ты? / а вы?", "ipa": "/ænd juː/" }
    ]
  },
