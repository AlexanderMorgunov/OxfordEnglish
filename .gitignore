# --- Content packs: safety model from DESIGN_DOC §1.3 ---
# The public pack is served from public/packs/ (tracked normally).
# The root packs/ dir is the BYOC drop zone for LOCAL packs only and is
# ignored entirely, so a user's licensed material can never reach git.
/packs/
/skinBagNotes/

# --- Private strategy/monetization plan: keep out of the public repo ---
# Internal planning / strategy / design docs — private, never in the public repo.
# (DESIGN_DOC.md and README.md live at the repo root and stay tracked.)
/docs/

# --- Content Forge authoring tool: large/derived data, never committed ---
tools/content-forge/node_modules/
tools/content-forge/.cache/
tools/content-forge/data/*.sqlite
tools/content-forge/data/wordlists.json
tools/content-forge/vendor/
# Throwaway per-unit content builders — kept locally, regenerated content is what ships.
tools/content-forge/scripts/_build_*.mjs

# Backend API service (separate toolchain)
/server/node_modules/
/server/dist/
